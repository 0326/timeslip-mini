:root {
  /* 微信原生配色 */
  --wechat-green: #07C160;
  --wechat-bg: #EDEDED;
  --wechat-white: #FFFFFF;
  --wechat-text: #191919;
  --wechat-text2: #888888;
  --wechat-divider: #D9D9D9;
  --wechat-blue: #576B95;
  --wechat-red: #FA5151;

  /* 古风点缀 */
  --ancient-gold: #C9A24D;
  --ancient-paper: #FFF9F0;
  --ancient-ink: #2D1810;
  --ancient-seal: #B71C1C;
  --ancient-wood: #8B5A2B;

  /* 布局半径 */
  --radius-sm: 4rpx;
  --radius-md: 8rpx;
  --radius-lg: 16rpx;
  --radius-full: 999rpx;

  /* 间距 */
  --spacing-xs: 8rpx;
  --spacing-sm: 16rpx;
  --spacing-md: 24rpx;
  --spacing-lg: 32rpx;
  --spacing-xl: 48rpx;

  /* 字体 */
  --font-xs: 22rpx;
  --font-sm: 24rpx;
  --font-md: 28rpx;
  --font-lg: 32rpx;
  --font-xl: 36rpx;
  --font-xxl: 44rpx;
}

/* 大字体模式 */
page.big-font {
  --font-md: 32rpx;
  --font-lg: 36rpx;
  --font-xl: 40rpx;
}

/* 水墨素雅主题 */
page.theme-ink {
  --ancient-paper: #F5F5F5;
  --wechat-bg: #F0F0F0;
}

/* 朱砂帝王主题 */
page.theme-cinnabar {
  --ancient-paper: #FFF5F0;
  --wechat-bg: #FAF0F0;
}

page {
  background-color: var(--wechat-bg);
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, Segoe UI, Arial, Roboto, 'PingFang SC', 'miui', 'Hiragino Sans GB', 'Microsoft Yahei', sans-serif;
  font-size: var(--font-md);
  color: var(--wechat-text);
  line-height: 1.6;
  box-sizing: border-box;
}

view, text, image, scroll-view {
  box-sizing: border-box;
}

image {
  display: block;
}

.container {
  padding: var(--spacing-lg);
}

.page-content {
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
}

/* 通用 flex */
.flex { display: flex; }
.flex-col { display: flex; flex-direction: column; }
.flex-center { display: flex; align-items: center; justify-content: center; }
.flex-between { display: flex; align-items: center; justify-content: space-between; }
.flex-1 { flex: 1; min-width: 0; min-height: 0; }

/* 省略号 */
.ellipsis {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.ellipsis-2 {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* 通用分割线 */
.divider {
  height: 1rpx;
  background: var(--wechat-divider);
  margin: 0 var(--spacing-lg);
}

/* 卡片通用样式 */
.card {
  background: var(--wechat-white);
  border-radius: var(--radius-lg);
  overflow: hidden;
}

/* 按钮通用 */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx 40rpx;
  border-radius: var(--radius-md);
  font-size: var(--font-md);
  line-height: 1.4;
  border: none;
  outline: none;
}
.btn-primary {
  background: var(--wechat-green);
  color: var(--wechat-white);
}
.btn-primary:active { opacity: 0.85; }
.btn-outline {
  background: transparent;
  color: var(--wechat-green);
  border: 1rpx solid var(--wechat-green);
}
.btn-ancient {
  background: linear-gradient(135deg, #C9A24D 0%, #A67B2D 100%);
  color: var(--wechat-white);
  letter-spacing: 4rpx;
  border: none;
  box-shadow: 0 4rpx 16rpx rgba(201, 162, 77, 0.3);
}
.btn-ancient:active { opacity: 0.9; transform: translateY(1rpx); }

/* 文字颜色工具类 */
.text-primary { color: var(--wechat-green); }
.text-secondary { color: var(--wechat-text2); }
.text-ancient { color: var(--ancient-gold); }
.text-danger { color: var(--wechat-red); }

/* 古风印章样式 */
.seal {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: var(--ancient-seal);
  color: var(--wechat-white);
  border-radius: var(--radius-sm);
  padding: 6rpx 16rpx;
  letter-spacing: 2rpx;
  transform: rotate(-2deg);
  box-shadow: 0 2rpx 6rpx rgba(183, 28, 28, 0.3);
}

/* 古纸背景 */
.ancient-paper {
  background:
    radial-gradient(ellipse at top left, rgba(201, 162, 77, 0.08) 0%, transparent 50%),
    radial-gradient(ellipse at bottom right, rgba(139, 90, 43, 0.06) 0%, transparent 50%),
    var(--ancient-paper);
  position: relative;
}
.ancient-paper::before {
  content: '';
  position: absolute;
  inset: 0;
  background-image:
    repeating-linear-gradient(
      90deg,
      transparent,
      transparent 398rpx,
      rgba(201, 162, 77, 0.05) 400rpx
    );
  pointer-events: none;
}
