.poll-widget {
  margin: 40rpx 0;
  padding: 32rpx;
  background: #fff;
  border-radius: 16rpx;
  border: 2rpx solid #f0f0f0;
}

.pw-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 24rpx;
}

.pw-option {
  display: flex;
  align-items: center;
  padding: 24rpx;
  margin-bottom: 16rpx;
  border: 2rpx solid #e8e8e8;
  border-radius: 12rpx;
  transition: all 0.2s;
}

.pw-option.selected {
  border-color: #1890FF;
  background: #f0f7ff;
}

.pw-radio {
  position: relative;
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  border: 4rpx solid #ccc;
  margin-right: 24rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.pw-option.selected .pw-radio {
  border-color: #1890FF;
  background: #1890FF;
}

.pw-radio-inner {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #fff;
}

.pw-text {
  font-size: 30rpx;
  color: #333;
}

.pw-vote-btn {
  margin-top: 24rpx;
  padding: 24rpx;
  background: #1890FF;
  color: #fff;
  font-size: 30rpx;
  text-align: center;
  border-radius: 12rpx;
}

.pw-vote-btn.disabled {
  background: #ccc;
}

.pw-option-result {
  position: relative;
  margin-bottom: 20rpx;
  padding: 20rpx 24rpx;
  background: #f7f7f7;
  border-radius: 12rpx;
  overflow: hidden;
}

.pw-option-bar {
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  background: rgba(24, 144, 255, 0.15);
  transition: width 0.3s;
}

.pw-option-text {
  position: relative;
  display: flex;
  justify-content: space-between;
  font-size: 28rpx;
  color: #333;
}

.pw-option-count {
  position: relative;
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}

.pw-total {
  font-size: 24rpx;
  color: #999;
  margin-top: 16rpx;
  text-align: center;
}
