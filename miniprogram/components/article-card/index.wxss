.article-card {
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
  break-inside: avoid;
}

.ac-cover {
  position: relative;
  width: 100%;
  overflow: hidden;
  background: linear-gradient(135deg, #FDF6E3 0%, #E8D5B0 100%);
}

.ac-cover image {
  width: 100%;
  display: block;
}

.ac-cover-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 300rpx;
  background: linear-gradient(135deg, #FDF6E3 0%, #E8D5B0 100%);
}

.ac-cover-text {
  font-size: 36rpx;
  color: #C9A24D;
  font-weight: 500;
}

.ac-cat-badge {
  position: absolute;
  top: 16rpx;
  left: 16rpx;
  padding: 6rpx 16rpx;
  background: rgba(0, 0, 0, 0.5);
  border-radius: 8rpx;
  font-size: 20rpx;
  color: #fff;
  backdrop-filter: blur(4rpx);
}

.ac-body {
  padding: 16rpx 20rpx 20rpx;
}

.ac-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1A1A1A;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.ac-subtitle {
  font-size: 24rpx;
  color: #888;
  margin-top: 6rpx;
  line-height: 1.4;
  min-height: 34rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 1;
  overflow: hidden;
}

.ac-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 12rpx;
}

.ac-author {
  display: flex;
  align-items: center;
}

.ac-author-text {
  font-size: 22rpx;
  color: #999;
}

.ac-stats {
  display: flex;
  align-items: center;
}

.ac-stat-item {
  font-size: 22rpx;
  color: #999;
}
