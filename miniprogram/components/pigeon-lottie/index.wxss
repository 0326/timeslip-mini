.pigeon-container {
  position: relative;
  width: 100%;
  height: 100%;
  min-height: 400rpx;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}

.cloud-layer {
  position: absolute;
  inset: 0;
  pointer-events: none;
}
.cloud {
  position: absolute;
  font-size: 120rpx;
  opacity: 0.7;
}
.c-1 { top: 10%; left: -10%; animation: c1 6s ease-in-out infinite; }
.c-2 { top: 30%; right: -5%; font-size: 140rpx; animation: c2 7s ease-in-out infinite 1s; }
.c-3 { bottom: 15%; left: 20%; font-size: 90rpx; animation: c3 5s ease-in-out infinite 0.5s; }
.c-4 { top: 60%; right: 20%; font-size: 100rpx; animation: c2 6.5s ease-in-out infinite 2s; }
@keyframes c1 { 0%,100% { transform: translateX(0); } 50% { transform: translateX(80rpx); } }
@keyframes c2 { 0%,100% { transform: translateX(0); } 50% { transform: translateX(-60rpx); } }
@keyframes c3 { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-30rpx); } }

.pigeon-wrap {
  position: relative;
  z-index: 2;
}
.pigeon {
  --sz: 120rpx;
  width: var(--sz);
  height: var(--sz);
}
.pigeon.fly {
  animation: pigeon-fly 2.4s ease-in-out infinite;
}
@keyframes pigeon-fly {
  0%, 100% { transform: translate(0, 0) rotate(-2deg); }
  25% { transform: translate(30rpx, -30rpx) rotate(2deg); }
  50% { transform: translate(0, -50rpx) rotate(-1deg); }
  75% { transform: translate(-30rpx, -30rpx) rotate(3deg); }
}

.pigeon-body {
  position: relative;
  width: 100%;
  height: 100%;
}
.wing {
  position: absolute;
  top: 30%;
  width: 65%;
  height: 40%;
  background: linear-gradient(180deg, #666 0%, #333 100%);
  border-radius: 50% 50% 20% 50%;
  transform-origin: 20% 50%;
}
.wing-left {
  left: -5%;
  transform: rotate(15deg);
  animation: wing-flap-l 0.4s ease-in-out infinite alternate;
}
.wing-right {
  right: -5%;
  transform: scaleX(-1) rotate(15deg);
  animation: wing-flap-r 0.4s ease-in-out infinite alternate;
}
@keyframes wing-flap-l {
  0% { transform: rotate(-30deg) translateY(-20%); }
  100% { transform: rotate(30deg) translateY(20%); }
}
@keyframes wing-flap-r {
  0% { transform: scaleX(-1) rotate(-30deg) translateY(-20%); }
  100% { transform: scaleX(-1) rotate(30deg) translateY(20%); }
}
.pigeon.playing ~ .wing-left { animation-play-state: running; }

.head {
  position: absolute;
  top: 5%;
  right: 5%;
  width: 40%;
  height: 35%;
  background: linear-gradient(180deg, #888 0%, #555 100%);
  border-radius: 50% 60% 50% 40%;
}
.eye {
  position: absolute;
  top: 20%;
  left: 25%;
  width: 25%;
  height: 25%;
  background: #fff;
  border-radius: 50%;
}
.eye::after {
  content: '';
  position: absolute;
  top: 25%;
  left: 35%;
  width: 40%;
  height: 40%;
  background: #000;
  border-radius: 50%;
}
.beak {
  position: absolute;
  top: 45%;
  right: -20%;
  width: 45%;
  height: 25%;
  background: linear-gradient(90deg, #FFA500, #FF8C00);
  border-radius: 0 80% 20% 50%;
  clip-path: polygon(0 20%, 100% 50%, 0 80%);
}

.tail {
  position: absolute;
  top: 35%;
  left: -15%;
  width: 35%;
  height: 30%;
  background: linear-gradient(90deg, #444 0%, #777 100%);
  clip-path: polygon(100% 0%, 30% 20%, 0% 50%, 30% 80%, 100% 100%);
}
.letter-pouch {
  position: absolute;
  bottom: 0%;
  left: 25%;
  font-size: 32rpx;
  animation: letter-bob 1s ease-in-out infinite alternate;
}
@keyframes letter-bob {
  from { transform: translateY(0) rotate(-5deg); }
  to { transform: translateY(6rpx) rotate(5deg); }
}

.trail-line {
  position: absolute;
  bottom: 30%;
  right: 100%;
  width: 150rpx;
  height: 2rpx;
  background: linear-gradient(90deg, transparent, rgba(102,102,102,0.3));
}

.loading-text {
  position: absolute;
  bottom: 10%;
  left: 50%;
  transform: translateX(-50%);
  color: var(--ancient-gold);
  font-size: 32rpx;
  letter-spacing: 8rpx;
  display: flex;
  align-items: center;
}
.dots { margin-left: 8rpx; display: inline-flex; }
.dots .d {
  animation: dot-blink 1.2s infinite;
}
.dots .d:nth-child(2) { animation-delay: 0.2s; }
.dots .d:nth-child(3) { animation-delay: 0.4s; }
@keyframes dot-blink {
  0%, 60%, 100% { opacity: 0.3; }
  30% { opacity: 1; }
}
