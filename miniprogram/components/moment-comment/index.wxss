.comment-item {
  display: flex;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--wechat-divider);
}
.comment-item:last-child { border-bottom: none; }

.c-avatar {
  margin-right: 16rpx;
  flex-shrink: 0;
}

.c-body { flex: 1; min-width: 0; }
.c-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 6rpx;
}
.c-name {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--wechat-blue);
}
.c-time {
  font-size: 20rpx;
  color: var(--wechat-text2);
}
.c-content {
  font-size: 28rpx;
  color: var(--wechat-text);
  line-height: 1.6;
  word-break: break-all;
  white-space: pre-wrap;
}
.c-bottom {
  display: flex;
  gap: 24rpx;
  margin-top: 10rpx;
  align-items: center;
}
.c-action {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 22rpx;
  color: var(--wechat-text2);
  padding: 6rpx 12rpx;
  border-radius: var(--radius-sm);
  transition: all 0.2s;
}
.c-action:active { background: #f0f0f0; }
.c-action.liked { color: var(--wechat-red); }
.c-action.liked .icon { transform: scale(1.15); }
.c-action .icon { font-size: 24rpx; transition: transform 0.2s; }
.c-action.delete .txt { color: var(--wechat-text2); }
.c-action.reply .txt, .c-action.like .txt { color: inherit; }

.replies {
  margin-top: 16rpx;
  padding: 12rpx 16rpx;
  background: var(--wechat-bg);
  border-radius: var(--radius-sm);
}
.reply-item {
  font-size: 24rpx;
  line-height: 1.7;
  padding: 4rpx 0;
  word-break: break-all;
}
.r-name { color: var(--wechat-blue); font-weight: 500; }
.r-at, .r-colon { color: var(--wechat-text2); }
.r-to { color: var(--wechat-blue); }
.r-content { color: var(--wechat-text); }
