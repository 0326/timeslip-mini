.input-bar {
  position: relative;
  background: var(--wechat-white);
  border-top: 1rpx solid var(--wechat-divider);
  padding: 16rpx 20rpx 16rpx;
  display: flex;
  align-items: flex-end;
  gap: 12rpx;
}

.bar-left, .bar-right {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding-bottom: 8rpx;
}

.icon-btn {
  width: 64rpx;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  font-size: 36rpx;
  color: var(--wechat-text2);
}

.bar-center {
  flex: 1;
  min-width: 0;
}

.text-input {
  width: 100%;
  box-sizing: border-box;
  min-height: 64rpx;
  max-height: 200rpx;
  padding: 16rpx 24rpx;
  font-size: 30rpx;
  color: var(--wechat-text);
  background: var(--wechat-bg);
  border-radius: var(--radius-md);
  line-height: 1.5;
}
.text-input.focused {
  background: #f0f0f0;
}

.send-btn {
  height: 64rpx;
  line-height: 64rpx;
  padding: 0 24rpx;
  background: var(--wechat-divider);
  color: var(--wechat-white);
  border-radius: var(--radius-md);
  font-size: 26rpx;
  font-weight: 500;
  margin: 0;
  border: none;
}
.send-btn.active {
  background: var(--wechat-green);
  color: #fff;
}
.send-btn[disabled] {
  opacity: 0.5;
}

.quick-bar {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 100%;
  background: var(--wechat-white);
  border-top: 1rpx solid var(--wechat-divider);
  padding: 12rpx 0;
  transform: translateY(100%);
  transition: transform 0.2s ease;
}
.input-bar:focused .quick-bar {
  transform: translateY(0);
}
.quick-scroll {
  white-space: nowrap;
  padding: 0 24rpx;
}
.quick-item {
  display: inline-block;
  padding: 12rpx 24rpx;
  margin-right: 16rpx;
  background: var(--ancient-paper);
  color: var(--ancient-ink);
  border: 1rpx solid rgba(201,162,77,0.3);
  border-radius: 999rpx;
  font-size: 24rpx;
}
