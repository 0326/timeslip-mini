<view class="input-bar" style="padding-bottom: {{safeBottom}}px;">
  <view class="bar-left">
    <view class="icon-btn" bindtap="onVoice" wx:if="{{showVoice}}">🎤</view>
    <view class="icon-btn" bindtap="onEmoji">😊</view>
  </view>
  <view class="bar-center">
    <textarea
      class="text-input {{focused ? 'focused' : ''}}"
      value="{{value}}"
      placeholder="{{placeholder}}"
      bindinput="onInput"
      bindfocus="onFocus"
      bindblur="onBlur"
      bindconfirm="onConfirm"
      adjust-position="{{true}}"
      auto-height="{{true}}"
      maxlength="{{maxLength}}"
      confirm-type="send"
      cursor-spacing="20"
    />
  </view>
  <view class="bar-right">
    <view class="icon-btn" bindtap="onImage" wx:if="{{showImage}}">🖼️</view>
    <button
      class="send-btn {{canSend ? 'active' : ''}}"
      bindtap="onSend"
      disabled="{{!canSend || disabled}}"
    >
      发送
    </button>
  </view>

  <view class="quick-bar" wx:if="{{quickReplies && quickReplies.length}}">
    <scroll-view class="quick-scroll" scroll-x enhanced show-scrollbar="{{false}}">
      <view
        class="quick-item"
        wx:for="{{quickReplies}}"
        wx:for-item="qr"
        wx:key="*this"
        data-text="{{qr}}"
        bindtap="onQuick"
      >
        {{qr}}
      </view>
    </scroll-view>
  </view>
</view>
