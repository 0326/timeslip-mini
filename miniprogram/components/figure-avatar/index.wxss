.avatar-wrap {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  flex-shrink: 0;
  background: linear-gradient(135deg, #c7d2fe 0%, #a5b4fc 100%);
  transition: transform 0.15s ease;
}
.avatar-wrap:active { transform: scale(0.95); }
.avatar-wrap.locked {
  filter: grayscale(0.5) brightness(0.85);
}
.avatar-wrap.locked .avatar-img,
.avatar-wrap.locked .avatar-text {
  opacity: 0.7;
}

.avatar-wrap.size-sm { width: 56rpx; height: 56rpx; border-radius: 50%; }
.avatar-wrap.size-md { width: 84rpx; height: 84rpx; border-radius: 50%; }
.avatar-wrap.size-lg { width: 112rpx; height: 112rpx; border-radius: 50%; }
.avatar-wrap.size-xl { width: 140rpx; height: 140rpx; border-radius: 50%; }

.avatar-wrap.shape-square {
  border-radius: 12rpx !important;
}
.avatar-wrap.size-xl.shape-square {
  border-radius: 16rpx !important;
}
.avatar-wrap.size-sm.shape-square {
  border-radius: 8rpx !important;
}

.avatar-wrap.bordered {
  border: 4rpx solid #fff;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.08);
}

.avatar-img {
  width: 100%;
  height: 100%;
  display: block;
  background: transparent;
}

.avatar-text {
  color: #fff;
  font-weight: 700;
  text-shadow: 0 1rpx 2rpx rgba(0,0,0,0.15);
}
.size-sm .initials { font-size: 24rpx; }
.size-md .initials { font-size: 32rpx; }
.size-lg .initials { font-size: 42rpx; }
.size-xl .initials { font-size: 52rpx; }

.dynasty-tag {
  position: absolute;
  bottom: -4rpx;
  right: -4rpx;
  padding: 2rpx 10rpx;
  background: rgba(255,255,255,0.95);
  color: #333;
  font-size: 18rpx;
  border-radius: 999rpx;
  font-weight: 600;
  border: 2rpx solid rgba(0,0,0,0.06);
  line-height: 1.4;
}
.size-sm .dynasty-tag { display: none; }
.size-md .dynasty-tag { font-size: 16rpx; padding: 1rpx 8rpx; }

.lock-mask {
  position: absolute;
  inset: 0;
  background: rgba(0,0,0,0.35);
  display: flex;
  align-items: center;
  justify-content: center;
}
.lock-icon {
  font-size: 28rpx;
  text-shadow: 0 2rpx 4rpx rgba(0,0,0,0.3);
}
.size-sm .lock-icon { font-size: 20rpx; }
.size-lg .lock-icon { font-size: 40rpx; }
.size-xl .lock-icon { font-size: 48rpx; }
