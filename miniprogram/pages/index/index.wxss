.page {
  min-height: 100vh;
  padding: 40rpx 32rpx 80rpx;
  background: linear-gradient(180deg, #f0ebe3 0%, #f8f6f2 30%);
}

.hero {
  padding: 40rpx 0 60rpx;
  text-align: center;
}

.hero-title {
  font-size: 56rpx;
  font-weight: 700;
  color: #2c1810;
  letter-spacing: 8rpx;
  margin-bottom: 16rpx;
}

.hero-subtitle {
  font-size: 28rpx;
  color: #8b7355;
  letter-spacing: 2rpx;
}

.user-card {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 40rpx;
  box-shadow: 0 4rpx 20rpx rgba(44, 24, 16, 0.06);
}

.avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: #f0ebe3;
  margin-right: 24rpx;
}

.user-info {
  flex: 1;
}

.nickname {
  font-size: 32rpx;
  font-weight: 600;
  color: #2c1810;
  margin-bottom: 8rpx;
}

.points {
  font-size: 26rpx;
  color: #c49a6c;
}

.section {
  margin-bottom: 48rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #2c1810;
  margin-bottom: 24rpx;
  padding-left: 12rpx;
  border-left: 6rpx solid #c49a6c;
}

.grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 24rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(44, 24, 16, 0.06);
}

.grid-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.grid-icon {
  font-size: 48rpx;
  margin-bottom: 12rpx;
}

.grid-label {
  font-size: 26rpx;
  color: #5c4a3d;
}

.placeholder {
  background: #fff;
  border-radius: 20rpx;
  padding: 80rpx 32rpx;
  text-align: center;
  box-shadow: 0 4rpx 20rpx rgba(44, 24, 16, 0.06);
}

.placeholder-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.placeholder-text {
  font-size: 28rpx;
  color: #9a8b7c;
}
