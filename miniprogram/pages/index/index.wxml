<view class="page">
  <view class="hero">
    <view class="hero-title">穿越圈</view>
    <view class="hero-subtitle">历史文化爱好者的精神家园</view>
  </view>

  <view class="user-card" wx:if="{{userInfo}}">
    <image class="avatar" src="{{userInfo.avatarUrl || '/images/default-avatar.png'}}" mode="aspectFill" />
    <view class="user-info">
      <view class="nickname">{{userInfo.nickName || '新用户'}}</view>
      <view class="points">积分：{{points}}</view>
    </view>
  </view>

  <view class="section">
    <view class="section-title">探索</view>
    <view class="grid">
      <view class="grid-item" bindtap="onTapProfile">
        <view class="grid-icon">📜</view>
        <view class="grid-label">典籍</view>
      </view>
      <view class="grid-item" bindtap="onTapProfile">
        <view class="grid-icon">🎭</view>
        <view class="grid-label">角色</view>
      </view>
      <view class="grid-item" bindtap="onTapProfile">
        <view class="grid-icon">📖</view>
        <view class="grid-label">史记</view>
      </view>
      <view class="grid-item" bindtap="onTapProfile">
        <view class="grid-icon">🏆</view>
        <view class="grid-label">成就</view>
      </view>
    </view>
  </view>

  <view class="section">
    <view class="section-title">社区</view>
    <view class="placeholder">
      <view class="placeholder-icon">💫</view>
      <view class="placeholder-text">社区动态，即将呈现</view>
    </view>
  </view>
</view>
