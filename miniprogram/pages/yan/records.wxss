.records-page {
  min-height: 100vh;
  background: #ffffff;
  display: flex;
  flex-direction: column;
}

.nav-bar {
  display: flex;
  align-items: center;
  padding: 0 24rpx;
  position: relative;
  z-index: 100;
  background: #ffffff;
  border-bottom: 1rpx solid #f0f0f0;
}
.nav-left {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.nav-back-arrow {
  width: 20rpx;
  height: 20rpx;
  border-left: 4rpx solid rgba(0, 0, 0, 0.85);
  border-bottom: 4rpx solid rgba(0, 0, 0, 0.85);
  transform: rotate(45deg);
}
.nav-title {
  flex: 1;
  text-align: center;
  font-size: 34rpx;
  font-weight: 600;
  color: #333333;
  letter-spacing: 8rpx;
}
.nav-placeholder {
  width: 64rpx;
}

.view-area {
  flex: 1;
  height: 0;
}

.loading-state {
  display: flex;
  justify-content: center;
  padding: 80rpx 0;
}
.loading-text {
  font-size: 28rpx;
  color: #999999;
}

.record-section {
  padding: 24rpx 32rpx;
}
.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}
.section-title {
  display: flex;
  align-items: center;
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
}
.live-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #4CAF50;
  margin-right: 12rpx;
  animation: livePulse 1.5s ease-in-out infinite;
}
@keyframes livePulse {
  0%, 100% { opacity: 1; box-shadow: 0 0 0 0 rgba(76, 175, 80, 0.4); }
  50% { opacity: 0.6; box-shadow: 0 0 0 8rpx rgba(76, 175, 80, 0); }
}
.section-count {
  font-size: 24rpx;
  color: #999999;
}

.traveling-card {
  background: #f8f8f8;
  border: 1rpx solid #f0f0f0;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
}
.tc-header {
  display: flex;
  align-items: center;
}
.tc-info {
  flex: 1;
}
.tc-carrier {
  font-size: 28rpx;
  color: #333333;
  font-weight: 500;
}
.tc-target {
  font-size: 24rpx;
  color: #999999;
  margin-top: 4rpx;
}
.tc-countdown {
  text-align: right;
}
.tc-time {
  font-size: 36rpx;
  font-weight: 700;
  color: #C9A24D;
  font-variant-numeric: tabular-nums;
}
.tc-label {
  font-size: 20rpx;
  color: #cccccc;
  margin-top: 4rpx;
}
.tc-progress {
  height: 6rpx;
  background: #e8e8e8;
  border-radius: 3rpx;
  overflow: hidden;
  margin-top: 20rpx;
}
.tc-progress-fill {
  height: 100%;
  border-radius: 3rpx;
  background: linear-gradient(90deg, #C9A24D, #E8C97E);
  transition: width 1s linear;
}
.tc-footer {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #cccccc;
}

.letter-card {
  background: #f8f8f8;
  border: 1rpx solid #f0f0f0;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  transition: all 0.2s;
}
.letter-card:active {
  background: #f0f0f0;
}
.letter-card.unread {
  border-left: 4rpx solid #C9A24D;
}
.lc-header {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}
.lc-info {
  flex: 1;
}
.lc-from {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
}
.lc-meta {
  font-size: 22rpx;
  color: #999999;
  margin-top: 4rpx;
}
.lc-unread-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #FA5151;
  box-shadow: 0 0 8rpx rgba(250, 81, 81, 0.3);
}
.lc-preview {
  font-size: 26rpx;
  color: #666666;
  line-height: 1.6;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}
.lc-gift {
  display: inline-flex;
  align-items: center;
  margin-top: 12rpx;
  padding: 4rpx 16rpx;
  font-size: 22rpx;
  color: #A67B2D;
  background: rgba(201, 162, 77, 0.08);
  border-radius: 999rpx;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0;
}
.empty-text {
  font-size: 30rpx;
  color: #999999;
  margin-bottom: 8rpx;
}
.empty-hint {
  font-size: 24rpx;
  color: #cccccc;
}

/* ====== 详情弹窗 ====== */
.detail-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx 32rpx;
}
.detail-popup {
  width: 100%;
  max-height: 85vh;
  background: #ffffff;
  border: 1rpx solid #f0f0f0;
  border-radius: 24rpx;
  padding: 48rpx 32rpx 32rpx;
  position: relative;
  overflow: hidden;
  box-sizing: border-box;
}
.detail-scroll {
  max-height: calc(85vh - 80rpx);
}
.detail-close {
  position: absolute;
  top: 20rpx;
  right: 24rpx;
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #cccccc;
  z-index: 5;
}
.detail-badge {
  display: inline-block;
  font-size: 22rpx;
  color: #A67B2D;
  background: rgba(201, 162, 77, 0.08);
  border: 1rpx solid rgba(201, 162, 77, 0.2);
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  margin-bottom: 16rpx;
}
.detail-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #333333;
  letter-spacing: 8rpx;
  margin-bottom: 32rpx;
}
.detail-reply-paper {
  background: linear-gradient(135deg, #FFF9F0 0%, #F5ECD7 100%);
  border-radius: 16rpx;
  padding: 32rpx 28rpx;
  border: 1rpx solid rgba(201, 162, 77, 0.25);
  margin-bottom: 24rpx;
}
.reply-from {
  display: flex;
  align-items: center;
  padding-bottom: 20rpx;
  border-bottom: 1rpx dashed rgba(201, 162, 77, 0.3);
  margin-bottom: 20rpx;
}
.reply-from-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #5D3A1A;
}
.reply-from-meta {
  font-size: 22rpx;
  color: rgba(139, 90, 43, 0.5);
  margin-top: 4rpx;
}
.reply-body {
  font-size: 30rpx;
  line-height: 60rpx;
  color: #2D1810;
  white-space: pre-wrap;
  word-break: break-all;
}
.detail-original {
  background: #f8f8f8;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 24rpx;
}
.detail-original-label {
  font-size: 22rpx;
  color: #999999;
  margin-bottom: 12rpx;
}
.detail-original-body {
  font-size: 26rpx;
  color: #666666;
  line-height: 1.6;
  white-space: pre-wrap;
}
.detail-gift-section {
  background: rgba(201, 162, 77, 0.04);
  border: 1rpx solid rgba(201, 162, 77, 0.15);
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}
.gift-section-title {
  font-size: 24rpx;
  color: #999999;
  margin-bottom: 16rpx;
}
.gift-item {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}
.gift-icon {
  font-size: 48rpx;
  margin-right: 16rpx;
}
.gift-name {
  flex: 1;
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
}
.gift-rarity {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  color: #fff;
}
.rarity-dot-1 { background: #9E9E9E; }
.rarity-dot-2 { background: #4CAF50; }
.rarity-dot-3 { background: #2196F3; }
.rarity-dot-4 { background: #9C27B0; }
.gift-desc {
  font-size: 24rpx;
  color: #999999;
  line-height: 1.5;
}
.btn-claim {
  width: 100%;
  height: 88rpx;
  border-radius: 16rpx;
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 4rpx;
  border: none;
  background: linear-gradient(135deg, #C9A24D 0%, #A67B2D 100%);
  color: #fff;
  box-shadow: 0 8rpx 24rpx rgba(201, 162, 77, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}
.claimed-tip {
  text-align: center;
  font-size: 28rpx;
  color: #4CAF50;
  padding: 20rpx;
}
