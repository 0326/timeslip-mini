/* ====== 雁书页面 - 鸣潮风格 ====== */

.yan-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #0a0a12 0%, #12121f 30%, #0d0d18 100%);
  display: flex;
  flex-direction: column;
  position: relative;
}

/* ====== 自定义导航栏 ====== */
.nav-bar {
  display: flex;
  align-items: center;
  padding: 0 24rpx;
  height: 88rpx;
  position: relative;
  z-index: 100;
}
.nav-back {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.nav-back-arrow {
  width: 20rpx;
  height: 20rpx;
  border-left: 4rpx solid rgba(255, 255, 255, 0.85);
  border-bottom: 4rpx solid rgba(255, 255, 255, 0.85);
  transform: rotate(45deg);
}
.nav-title {
  flex: 1;
  text-align: center;
  font-size: 34rpx;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.95);
  letter-spacing: 8rpx;
}
.nav-placeholder {
  width: 64rpx;
}

/* ====== Tab 切换 ====== */
.tab-header {
  display: flex;
  padding: 0 24rpx;
  height: 80rpx;
  align-items: center;
  position: relative;
  z-index: 90;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.06);
}
.tab-header-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100%;
  position: relative;
}
.tab-header-item text {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.4);
  transition: color 0.3s;
}
.tab-header-item.active text {
  color: rgba(255, 255, 255, 0.95);
  font-weight: 600;
}
.tab-underline {
  position: absolute;
  bottom: 8rpx;
  width: 48rpx;
  height: 4rpx;
  border-radius: 2rpx;
  background: linear-gradient(90deg, #C9A24D, #E8C97E);
  box-shadow: 0 0 12rpx rgba(201, 162, 77, 0.6);
}
.tab-badge {
  position: absolute;
  top: 12rpx;
  right: 50%;
  transform: translateX(40rpx);
  min-width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  padding: 0 8rpx;
  border-radius: 999rpx;
  background: #FA5151;
  color: #fff;
  font-size: 20rpx;
  text-align: center;
}

/* ====== 视图区域 ====== */
.view-area {
  flex: 1;
  height: 0;
}

/* ====== 鸿雁展示区 ====== */
.carrier-stage {
  padding: 24rpx 0 16rpx;
}
.stage-canvas {
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  height: 320rpx;
}
.stage-arrow {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  color: rgba(255, 255, 255, 0.3);
  z-index: 5;
}
.stage-arrow:active {
  color: rgba(201, 162, 77, 0.8);
}
.carrier-swiper {
  width: 480rpx;
  height: 320rpx;
}
.carrier-figure {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}
.carrier-aura {
  position: absolute;
  width: 280rpx;
  height: 280rpx;
  border-radius: 50%;
  background: radial-gradient(circle, var(--aura-color, rgba(201, 162, 77, 0.2)) 0%, transparent 70%);
  animation: pulse 3s ease-in-out infinite;
}
@keyframes pulse {
  0%, 100% { transform: scale(1); opacity: 0.6; }
  50% { transform: scale(1.1); opacity: 1; }
}
.carrier-bird {
  font-size: 120rpx;
  z-index: 2;
  filter: drop-shadow(0 8rpx 24rpx rgba(0, 0, 0, 0.4));
  animation: float 4s ease-in-out infinite;
}
@keyframes float {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-16rpx); }
}
.stage-dots {
  display: flex;
  justify-content: center;
  gap: 12rpx;
  margin-top: 8rpx;
}
.stage-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.15);
  transition: all 0.3s;
}
.stage-dot.active {
  width: 32rpx;
  border-radius: 6rpx;
  background: linear-gradient(90deg, #C9A24D, #E8C97E);
}

/* ====== 信使名称 ====== */
.carrier-name-bar {
  padding: 8rpx 48rpx 16rpx;
  text-align: center;
}
.carrier-name {
  font-size: 36rpx;
  font-weight: 700;
  color: rgba(255, 255, 255, 0.95);
  letter-spacing: 4rpx;
  margin-bottom: 12rpx;
}
.carrier-tags {
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
  gap: 12rpx;
}
.carrier-tag {
  font-size: 22rpx;
  color: rgba(201, 162, 77, 0.8);
  background: rgba(201, 162, 77, 0.1);
  border: 1rpx solid rgba(201, 162, 77, 0.2);
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
}

/* ====== 属性面板 ====== */
.stat-panel {
  margin: 0 32rpx 24rpx;
  padding: 24rpx 28rpx;
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  border-radius: 16rpx;
}
.stat-row {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}
.stat-row:last-child {
  margin-bottom: 0;
}
.stat-label {
  width: 100rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.5);
}
.stat-bar-wrap {
  flex: 1;
  height: 12rpx;
  background: rgba(255, 255, 255, 0.06);
  border-radius: 6rpx;
  overflow: hidden;
  margin: 0 20rpx;
}
.stat-bar-fill {
  height: 100%;
  border-radius: 6rpx;
  background: linear-gradient(90deg, #C9A24D, #E8C97E);
  transition: width 0.4s ease;
}
.stat-value {
  width: 80rpx;
  text-align: right;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  font-weight: 500;
}

/* ====== 选择区域 ====== */
.select-section {
  padding: 0 32rpx;
  margin-bottom: 20rpx;
}
.section-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.4);
  margin-bottom: 12rpx;
  letter-spacing: 2rpx;
}
.scroll-row {
  white-space: nowrap;
}
.dynasty-chip {
  display: inline-flex;
  align-items: center;
  padding: 10rpx 28rpx;
  margin-right: 12rpx;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.5);
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 999rpx;
  transition: all 0.25s;
}
.dynasty-chip.selected {
  color: #fff;
  background: rgba(201, 162, 77, 0.15);
  border-color: rgba(201, 162, 77, 0.5);
}
.dynasty-chip.drift.selected {
  color: #4FC3F7;
  background: rgba(79, 195, 247, 0.12);
  border-color: rgba(79, 195, 247, 0.4);
}
.figure-chip {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  width: 120rpx;
  margin-right: 16rpx;
  padding: 16rpx 0;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  transition: all 0.25s;
}
.figure-chip.selected {
  background: rgba(201, 162, 77, 0.12);
  border-color: rgba(201, 162, 77, 0.5);
}
.fc-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  background: rgba(255, 255, 255, 0.06);
  margin-bottom: 8rpx;
}
.fc-name {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
}
.figure-chip.selected .fc-name {
  color: #E8C97E;
  font-weight: 500;
}

/* ====== 随机漂流提示 ====== */
.drift-hint {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx 32rpx;
  margin: 0 32rpx 20rpx;
  background: rgba(79, 195, 247, 0.06);
  border: 1rpx solid rgba(79, 195, 247, 0.15);
  border-radius: 16rpx;
}
.drift-icon {
  font-size: 36rpx;
  margin-right: 16rpx;
}
.drift-text {
  font-size: 26rpx;
  color: rgba(79, 195, 247, 0.8);
}

/* ====== 信笺输入 ====== */
.letter-section {
  padding: 0 32rpx;
  margin-bottom: 24rpx;
}
.letter-paper {
  background: linear-gradient(135deg, #FFF9F0 0%, #F5ECD7 100%);
  background-image: repeating-linear-gradient(
    transparent,
    transparent 59rpx,
    rgba(201, 162, 77, 0.1) 59rpx,
    rgba(201, 162, 77, 0.1) 60rpx
  );
  border-radius: 16rpx;
  padding: 32rpx 28rpx 24rpx;
  border: 1rpx solid rgba(201, 162, 77, 0.2);
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.2);
}
.letter-to {
  font-size: 28rpx;
  color: #8B5A2B;
  margin-bottom: 16rpx;
  letter-spacing: 2rpx;
}
.letter-to-name {
  font-weight: 600;
  color: #5D3A1A;
}
.letter-textarea {
  width: 100%;
  min-height: 240rpx;
  font-size: 30rpx;
  line-height: 60rpx;
  color: #2D1810;
  padding: 0;
}
.letter-placeholder {
  color: rgba(139, 90, 43, 0.3);
}
.letter-count {
  text-align: right;
  font-size: 22rpx;
  color: rgba(139, 90, 43, 0.4);
  margin-top: 8rpx;
}

/* ====== 发送按钮 ====== */
.send-section {
  padding: 0 32rpx 48rpx;
}
.btn-send {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  border-radius: 16rpx;
  font-size: 34rpx;
  font-weight: 600;
  letter-spacing: 8rpx;
  border: none;
  background: linear-gradient(135deg, #C9A24D 0%, #A67B2D 100%);
  color: #fff;
  box-shadow: 0 8rpx 24rpx rgba(201, 162, 77, 0.3);
}
.btn-send:active {
  transform: translateY(2rpx);
  box-shadow: 0 4rpx 12rpx rgba(201, 162, 77, 0.2);
}
.btn-send.disabled,
.btn-send[disabled] {
  background: rgba(255, 255, 255, 0.08);
  color: rgba(255, 255, 255, 0.25);
  box-shadow: none;
}

/* ====== 记录视图 ====== */
.record-section {
  padding: 24rpx 32rpx;
}
.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}
.section-title {
  display: flex;
  align-items: center;
  font-size: 30rpx;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.9);
}
.live-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #4CAF50;
  margin-right: 12rpx;
  animation: livePulse 1.5s ease-in-out infinite;
}
@keyframes livePulse {
  0%, 100% { opacity: 1; box-shadow: 0 0 0 0 rgba(76, 175, 80, 0.4); }
  50% { opacity: 0.6; box-shadow: 0 0 0 8rpx rgba(76, 175, 80, 0); }
}
.section-count {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.4);
}

/* ====== 旅行中卡片 ====== */
.traveling-card {
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
}
.tc-header {
  display: flex;
  align-items: center;
}
.tc-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  background: rgba(201, 162, 77, 0.08);
  margin-right: 20rpx;
}
.tc-info {
  flex: 1;
}
.tc-carrier {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.85);
  font-weight: 500;
}
.tc-target {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.4);
  margin-top: 4rpx;
}
.tc-countdown {
  text-align: right;
}
.tc-time {
  font-size: 36rpx;
  font-weight: 700;
  color: #E8C97E;
  font-variant-numeric: tabular-nums;
}
.tc-label {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.3);
  margin-top: 4rpx;
}
.tc-progress {
  height: 6rpx;
  background: rgba(255, 255, 255, 0.06);
  border-radius: 3rpx;
  overflow: hidden;
  margin-top: 20rpx;
}
.tc-progress-fill {
  height: 100%;
  border-radius: 3rpx;
  background: linear-gradient(90deg, #C9A24D, #E8C97E);
  transition: width 1s linear;
}
.tc-footer {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.25);
}

/* ====== 已收信卡片 ====== */
.letter-card {
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  transition: all 0.2s;
}
.letter-card:active {
  background: rgba(255, 255, 255, 0.06);
}
.letter-card.unread {
  border-left: 4rpx solid #C9A24D;
}
.lc-header {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}
.lc-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  background: rgba(201, 162, 77, 0.08);
  margin-right: 16rpx;
}
.lc-info {
  flex: 1;
}
.lc-from {
  font-size: 28rpx;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.9);
}
.lc-meta {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.35);
  margin-top: 4rpx;
}
.lc-unread-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #FA5151;
  box-shadow: 0 0 8rpx rgba(250, 81, 81, 0.5);
}
.lc-preview {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.5);
  line-height: 1.6;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}
.lc-gift {
  display: inline-flex;
  align-items: center;
  margin-top: 12rpx;
  padding: 4rpx 16rpx;
  font-size: 22rpx;
  color: rgba(201, 162, 77, 0.8);
  background: rgba(201, 162, 77, 0.08);
  border-radius: 999rpx;
}

/* ====== 空状态 ====== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0;
}
.empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
  opacity: 0.3;
}
.empty-text {
  font-size: 30rpx;
  color: rgba(255, 255, 255, 0.4);
  margin-bottom: 8rpx;
}
.empty-hint {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.2);
}

/* ====== 藏馆统计 ====== */
.collection-stats {
  display: flex;
  padding: 32rpx 24rpx;
  margin: 24rpx 32rpx 0;
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  border-radius: 16rpx;
}
.c-stat {
  flex: 1;
  text-align: center;
  position: relative;
}
.c-stat::after {
  content: '';
  position: absolute;
  right: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 1rpx;
  height: 48rpx;
  background: rgba(255, 255, 255, 0.06);
}
.c-stat:last-child::after {
  display: none;
}
.c-stat-value {
  font-size: 40rpx;
  font-weight: 700;
  color: #E8C97E;
  font-variant-numeric: tabular-nums;
}
.c-stat-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.4);
  margin-top: 4rpx;
}

/* ====== 筛选 ====== */
.filter-bar {
  white-space: nowrap;
  padding: 24rpx 32rpx 8rpx;
}
.filter-chip {
  display: inline-flex;
  padding: 10rpx 28rpx;
  margin-right: 12rpx;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.4);
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 999rpx;
  transition: all 0.25s;
}
.filter-chip.active {
  color: #fff;
  background: rgba(201, 162, 77, 0.15);
  border-color: rgba(201, 162, 77, 0.5);
}

/* ====== 图鉴网格 ====== */
.collection-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 16rpx 24rpx 48rpx;
  gap: 16rpx;
}
.collection-item {
  width: calc(25% - 12rpx);
  aspect-ratio: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  border-radius: 16rpx;
  position: relative;
  transition: all 0.2s;
}
.collection-item:active {
  transform: scale(0.95);
}
.collection-item.locked {
  opacity: 0.35;
}
.item-rarity-dot {
  position: absolute;
  top: 10rpx;
  right: 10rpx;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
}
.rarity-dot-1 { background: #9E9E9E; }
.rarity-dot-2 { background: #4CAF50; }
.rarity-dot-3 { background: #2196F3; }
.rarity-dot-4 { background: #9C27B0; box-shadow: 0 0 8rpx rgba(156, 39, 176, 0.5); }
.item-icon {
  font-size: 48rpx;
  margin-bottom: 8rpx;
}
.item-name {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.6);
  text-align: center;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 100%;
  padding: 0 8rpx;
}
.item-count {
  position: absolute;
  bottom: 8rpx;
  right: 8rpx;
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.4);
  background: rgba(0, 0, 0, 0.3);
  border-radius: 999rpx;
  padding: 2rpx 8rpx;
}

/* ====== 信件详情弹窗 ====== */
.detail-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.75);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx 32rpx;
}
.detail-popup {
  width: 100%;
  max-height: 85vh;
  background: linear-gradient(180deg, #1a1a28 0%, #12121f 100%);
  border: 1rpx solid rgba(201, 162, 77, 0.2);
  border-radius: 24rpx;
  padding: 48rpx 32rpx 32rpx;
  position: relative;
  overflow: hidden;
  box-sizing: border-box;
}
.detail-scroll {
  max-height: calc(85vh - 80rpx);
}
.detail-close {
  position: absolute;
  top: 20rpx;
  right: 24rpx;
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: rgba(255, 255, 255, 0.4);
  z-index: 5;
}
.detail-close:active {
  color: rgba(255, 255, 255, 0.8);
}
.detail-badge {
  display: inline-block;
  font-size: 22rpx;
  color: rgba(201, 162, 77, 0.8);
  background: rgba(201, 162, 77, 0.1);
  border: 1rpx solid rgba(201, 162, 77, 0.2);
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  margin-bottom: 16rpx;
}
.detail-title {
  font-size: 40rpx;
  font-weight: 700;
  color: rgba(255, 255, 255, 0.95);
  letter-spacing: 8rpx;
  margin-bottom: 32rpx;
}

/* ====== 回信纸张 ====== */
.detail-reply-paper {
  background: linear-gradient(135deg, #FFF9F0 0%, #F5ECD7 100%);
  background-image: repeating-linear-gradient(
    transparent,
    transparent 59rpx,
    rgba(201, 162, 77, 0.1) 59rpx,
    rgba(201, 162, 77, 0.1) 60rpx
  );
  border-radius: 16rpx;
  padding: 32rpx 28rpx;
  border: 1rpx solid rgba(201, 162, 77, 0.25);
  margin-bottom: 24rpx;
}
.reply-from {
  display: flex;
  align-items: center;
  padding-bottom: 20rpx;
  border-bottom: 1rpx dashed rgba(201, 162, 77, 0.3);
  margin-bottom: 20rpx;
}
.reply-from-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  background: rgba(201, 162, 77, 0.1);
  margin-right: 20rpx;
}
.reply-from-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #5D3A1A;
}
.reply-from-meta {
  font-size: 22rpx;
  color: rgba(139, 90, 43, 0.5);
  margin-top: 4rpx;
}
.reply-body {
  font-size: 30rpx;
  line-height: 60rpx;
  color: #2D1810;
  white-space: pre-wrap;
  word-break: break-all;
}

/* ====== 原始来信 ====== */
.detail-original {
  background: rgba(255, 255, 255, 0.03);
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 24rpx;
}
.detail-original-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.3);
  margin-bottom: 12rpx;
}
.detail-original-body {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.5);
  line-height: 1.6;
  white-space: pre-wrap;
}

/* ====== 风物区域 ====== */
.detail-gift-section {
  background: rgba(201, 162, 77, 0.06);
  border: 1rpx solid rgba(201, 162, 77, 0.15);
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}
.gift-section-title {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.4);
  margin-bottom: 16rpx;
}
.gift-item {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}
.gift-icon {
  font-size: 48rpx;
  margin-right: 16rpx;
}
.gift-name {
  flex: 1;
  font-size: 30rpx;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.9);
}
.gift-rarity {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  color: #fff;
}
.gift-rarity.rarity-dot-1 { background: #9E9E9E; }
.gift-rarity.rarity-dot-2 { background: #4CAF50; }
.gift-rarity.rarity-dot-3 { background: #2196F3; }
.gift-rarity.rarity-dot-4 { background: #9C27B0; }
.gift-desc {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.4);
  line-height: 1.5;
}

/* ====== 领取按钮 ====== */
.btn-claim {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 16rpx;
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 4rpx;
  border: none;
  background: linear-gradient(135deg, #C9A24D 0%, #A67B2D 100%);
  color: #fff;
  box-shadow: 0 8rpx 24rpx rgba(201, 162, 77, 0.3);
}
.btn-claim:active {
  transform: translateY(2rpx);
}
.claimed-tip {
  text-align: center;
  font-size: 28rpx;
  color: rgba(76, 175, 80, 0.8);
  padding: 20rpx;
}
