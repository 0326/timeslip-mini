<view class="yan-page">

  <!-- 自定义导航栏（只保留返回箭头+标题） -->
  <view class="nav-bar" style="padding-top: {{statusBarHeight}}px; height: {{navHeight}}px;">
    <view class="nav-left" bindtap="goBack">
      <view class="nav-back-arrow"></view>
    </view>
    <view class="nav-title">雁书</view>
    <view class="nav-right"></view>
  </view>

  <!-- 右上角悬浮图标（胶囊按钮下方） -->
  <view class="float-icons" style="top: {{floatIconsTop}}px; right: {{floatIconsRight}}px;">
    <view class="float-icon-btn" bindtap="goRecords">
      <view class="float-icon records-icon"></view>
    </view>
    <view class="float-icon-btn" bindtap="goCollection">
      <view class="float-icon collection-icon"></view>
    </view>
  </view>

  <!-- 滚动内容区 -->
  <scroll-view scroll-y class="view-area">

    <!-- ====== 鸿雁展示区（整体swiper切换） ====== -->
    <view class="hero-section">
      <view class="hero-swiper-wrap">
        <view class="stage-arrow left" bindtap="switchCarrier" data-dir="-1">‹</view>

        <swiper class="hero-swiper" current="{{carrierIndex}}" bindchange="onCarrierSwiperChange" circular>
          <swiper-item wx:for="{{carriers}}" wx:key="key">
            <view class="hero-card">
              <!-- 左侧：名字+稀有度+状态 + 标签 + 属性 -->
              <view class="hero-info">
                <view class="hero-name-row">
                  <view class="hero-name">{{item.name}}</view>
                  <view class="hero-rarity-tag rarity-{{item.rarityType}}">{{item.rarityLabel}}</view>
                  <view class="carrier-busy-badge" wx:if="{{carrierBusy[item.key]}}">
                    <view class="busy-dot"></view>
                    <text>传送中</text>
                  </view>
                </view>
                <view class="hero-tags">
                  <view class="hero-tag" wx:for="{{item.tags}}" wx:for-item="tag" wx:key="*this">{{tag}}</view>
                </view>
                <view class="hero-stats">
                  <view class="stat-row">
                    <view class="stat-label">速度</view>
                    <view class="stat-bar-wrap"><view class="stat-bar-fill" style="width: {{item.speed}}%"></view></view>
                    <view class="stat-value">{{item.speedLabel}}</view>
                  </view>
                  <view class="stat-row">
                    <view class="stat-label">准确率</view>
                    <view class="stat-bar-wrap"><view class="stat-bar-fill" style="width: {{item.accuracy}}%"></view></view>
                    <view class="stat-value">{{item.accuracyLabel}}</view>
                  </view>
                  <view class="stat-row">
                    <view class="stat-label">载物</view>
                    <view class="stat-bar-wrap"><view class="stat-bar-fill" style="width: {{item.load}}%"></view></view>
                    <view class="stat-value">{{item.loadLabel}}</view>
                  </view>
                  <view class="stat-row">
                    <view class="stat-label">稀有度</view>
                    <view class="stat-bar-wrap"><view class="stat-bar-fill" style="width: {{item.rarity}}%"></view></view>
                    <view class="stat-value">{{item.rarityLabel}}</view>
                  </view>
                </view>
              </view>

              <!-- 右侧：大雁形象 -->
              <view class="hero-bird">
                <view class="carrier-figure {{carrierBusy[item.key] ? 'transmitting' : ''}}" style="--aura-color: {{item.aura}};">
                  <view class="carrier-aura"></view>
                  <view class="transmit-trail" wx:if="{{carrierBusy[item.key]}}"></view>
                  <image class="carrier-bird-img" src="{{carrierBusy[item.key] ? item.flyImage : item.image}}" mode="aspectFit" />
                </view>
              </view>
            </view>
          </swiper-item>
        </swiper>

        <view class="stage-arrow right" bindtap="switchCarrier" data-dir="1">›</view>
      </view>

      <!-- 指示器（模块下方居中） -->
      <view class="stage-dots">
        <view class="stage-dot {{carrierIndex === idx ? 'active' : ''}}" wx:for="{{carriers}}" wx:for-index="idx" wx:key="key" bindtap="goCarrier" data-idx="{{idx}}"></view>
      </view>
    </view>

    <!-- 大雁简介 -->
    <view class="carrier-desc">{{carriers[carrierIndex].desc}}</view>

    <!-- ====== 传送中：展示进度条 ====== -->
    <view class="traveling-section" wx:if="{{currentTraveling}}">
      <view class="traveling-card">
        <view class="tc-header">
          <view class="tc-info">
            <view class="tc-carrier">{{carriers[carrierIndex].name}} · 前往{{currentTraveling.dynastyName}}</view>
            <view class="tc-target">收信人：{{currentTraveling.figureName}}</view>
          </view>
          <view class="tc-countdown">
            <view class="tc-time">{{currentTraveling.remainText || '计算中'}}</view>
            <view class="tc-label">剩余</view>
          </view>
        </view>
        <view class="tc-progress">
          <view class="tc-progress-fill" style="width: {{currentTraveling.progress || 0}}%"></view>
        </view>
        <view class="tc-footer">
          <text>出发于 {{currentTraveling.sentAtText}}</text>
        </view>
      </view>
    </view>

    <block wx:else>
      <!-- 选择朝代 -->
      <view class="select-section">
        <view class="section-label">选择收信朝代</view>
        <scroll-view scroll-x class="scroll-row" enhanced show-scrollbar="{{false}}">
          <view class="dynasty-chip {{selectedDynasty === item.key ? 'selected' : ''}} {{item.key === 'random' ? 'drift' : ''}}" wx:for="{{dynasties}}" wx:key="key" bindtap="selectDynasty" data-key="{{item.key}}">
            <text wx:if="{{item.key === 'random'}}">随机漂流</text>
            <text wx:else>{{item.name}}</text>
          </view>
        </scroll-view>
      </view>

      <!-- 选择角色 -->
      <view class="select-section" wx:if="{{selectedDynasty !== 'random'}}">
        <view class="section-label">选择收信人</view>
        <scroll-view scroll-x class="scroll-row" enhanced show-scrollbar="{{false}}">
          <view class="figure-chip {{selectedFigureId === item.figureId ? 'selected' : ''}}" wx:for="{{figures}}" wx:key="figureId" bindtap="selectFigure" data-id="{{item.figureId}}">
            <image class="fc-avatar" wx:if="{{item.avatar}}" src="{{item.avatar}}" mode="aspectFill" lazy-load binderror="onAvatarError" data-index="{{index}}" />
            <view class="fc-avatar fc-avatar-fallback" wx:else>{{item.name ? item.name[0] : '?'}}</view>
            <view class="fc-name">{{item.name}}</view>
          </view>
        </scroll-view>
      </view>

      <!-- 随机漂流提示 -->
      <view class="drift-hint" wx:if="{{selectedDynasty === 'random'}}">
        <view class="drift-text">信使将随风漫游，随机匹配历代人物回信</view>
      </view>

      <!-- 信笺输入 -->
      <view class="letter-section">
        <view class="section-label">书写笺书</view>
        <view class="letter-paper">
          <view class="letter-to" wx:if="{{selectedDynasty !== 'random' && selectedFigureId}}">
            致：<text class="letter-to-name">{{selectedFigureName}}</text>
          </view>
          <view class="letter-to" wx:else>
            致：<text class="letter-to-name">时空中有缘人</text>
          </view>
          <textarea class="letter-textarea" value="{{letterContent}}" bindinput="onLetterInput" placeholder="在此写下你想对先贤说的话..." placeholder-class="letter-placeholder" maxlength="500" auto-height confirm-type="done" show-confirm-bar="{{false}}"></textarea>
          <view class="letter-count">{{letterContent.length}}/500</view>
        </view>
      </view>
    </block>

    <!-- 底部占位（防止内容被固定按钮遮挡） -->
    <view class="bottom-placeholder"></view>

  </scroll-view>

  <!-- 底部固定发送按钮 -->
  <view class="send-bar">
    <button class="btn-send {{!canSend ? 'disabled' : ''}}" bindtap="sendLetter" disabled="{{!canSend || sending}}">
      <block wx:if="{{carrierBusy[carriers[carrierIndex].key]}}">
        此鸿雁正在送信中
      </block>
      <block wx:else>
        {{sending ? '托付中...' : '鸿雁传书'}}
      </block>
    </button>
  </view>

</view>
