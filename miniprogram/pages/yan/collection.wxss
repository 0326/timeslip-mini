.collection-page {
  min-height: 100vh;
  background: #ffffff;
  display: flex;
  flex-direction: column;
}

.nav-bar {
  display: flex;
  align-items: center;
  padding: 0 24rpx;
  position: relative;
  z-index: 100;
  background: #ffffff;
  border-bottom: 1rpx solid #f0f0f0;
}
.nav-left {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.nav-back-arrow {
  width: 20rpx;
  height: 20rpx;
  border-left: 4rpx solid rgba(0, 0, 0, 0.85);
  border-bottom: 4rpx solid rgba(0, 0, 0, 0.85);
  transform: rotate(45deg);
}
.nav-title {
  flex: 1;
  text-align: center;
  font-size: 34rpx;
  font-weight: 600;
  color: #333333;
  letter-spacing: 8rpx;
}
.nav-placeholder {
  width: 64rpx;
}

.view-area {
  flex: 1;
  height: 0;
}

.loading-state {
  display: flex;
  justify-content: center;
  padding: 80rpx 0;
}
.loading-text {
  font-size: 28rpx;
  color: #999999;
}

.collection-stats {
  display: flex;
  padding: 32rpx 24rpx;
  margin: 24rpx 32rpx 0;
  background: #f8f8f8;
  border: 1rpx solid #f0f0f0;
  border-radius: 16rpx;
}
.c-stat {
  flex: 1;
  text-align: center;
  position: relative;
}
.c-stat::after {
  content: '';
  position: absolute;
  right: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 1rpx;
  height: 48rpx;
  background: #e8e8e8;
}
.c-stat:last-child::after {
  display: none;
}
.c-stat-value {
  font-size: 40rpx;
  font-weight: 700;
  color: #C9A24D;
  font-variant-numeric: tabular-nums;
}
.c-stat-label {
  font-size: 22rpx;
  color: #999999;
  margin-top: 4rpx;
}

.filter-bar {
  white-space: nowrap;
  padding: 24rpx 32rpx 8rpx;
}
.filter-chip {
  display: inline-flex;
  padding: 10rpx 28rpx;
  margin-right: 12rpx;
  font-size: 26rpx;
  color: #666666;
  background: #f8f8f8;
  border: 1rpx solid #e8e8e8;
  border-radius: 999rpx;
  transition: all 0.25s;
}
.filter-chip.active {
  color: #fff;
  background: rgba(201, 162, 77, 0.85);
  border-color: #C9A24D;
}

.collection-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 16rpx 24rpx 48rpx;
  gap: 16rpx;
}
.collection-item {
  width: calc(25% - 12rpx);
  aspect-ratio: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #f8f8f8;
  border: 1rpx solid #f0f0f0;
  border-radius: 16rpx;
  position: relative;
  transition: all 0.2s;
}
.collection-item:active {
  transform: scale(0.95);
}
.collection-item.locked {
  opacity: 0.35;
}
.item-rarity-dot {
  position: absolute;
  top: 10rpx;
  right: 10rpx;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
}
.rarity-dot-1 { background: #9E9E9E; }
.rarity-dot-2 { background: #4CAF50; }
.rarity-dot-3 { background: #2196F3; }
.rarity-dot-4 { background: #9C27B0; box-shadow: 0 0 8rpx rgba(156, 39, 176, 0.3); }
.item-icon {
  font-size: 48rpx;
  margin-bottom: 8rpx;
}
.item-name {
  font-size: 20rpx;
  color: #666666;
  text-align: center;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 100%;
  padding: 0 8rpx;
}
.item-count {
  position: absolute;
  bottom: 8rpx;
  right: 8rpx;
  font-size: 20rpx;
  color: #999999;
  background: rgba(0, 0, 0, 0.05);
  border-radius: 999rpx;
  padding: 2rpx 8rpx;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0;
}
.empty-text {
  font-size: 30rpx;
  color: #999999;
  margin-bottom: 8rpx;
}
.empty-hint {
  font-size: 24rpx;
  color: #cccccc;
}
