<view class="collection-page">

  <view class="nav-bar" style="padding-top: {{statusBarHeight}}px; height: {{navHeight}}px;">
    <view class="nav-left" bindtap="goBack">
      <view class="nav-back-arrow"></view>
    </view>
    <view class="nav-title">藏馆</view>
    <view class="nav-placeholder"></view>
  </view>

  <scroll-view scroll-y class="view-area">

    <view class="loading-state" wx:if="{{loading}}">
      <view class="loading-text">加载中...</view>
    </view>

    <block wx:else>
      <view class="collection-stats">
        <view class="c-stat">
          <view class="c-stat-value">{{collectionStats.collected}}</view>
          <view class="c-stat-label">已收藏</view>
        </view>
        <view class="c-stat">
          <view class="c-stat-value">{{collectionStats.total}}</view>
          <view class="c-stat-label">总数</view>
        </view>
        <view class="c-stat">
          <view class="c-stat-value">{{collectionStats.rare}}</view>
          <view class="c-stat-label">稀有+</view>
        </view>
        <view class="c-stat">
          <view class="c-stat-value">{{collectionStats.completion}}%</view>
          <view class="c-stat-label">完成度</view>
        </view>
      </view>

      <scroll-view scroll-x class="filter-bar" enhanced show-scrollbar="{{false}}">
        <view class="filter-chip {{giftFilter === item.key ? 'active' : ''}}" wx:for="{{giftFilters}}" wx:key="key" bindtap="filterGifts" data-key="{{item.key}}">{{item.name}}</view>
      </scroll-view>

      <view class="collection-grid">
        <view class="collection-item rarity-{{item.rarity}}" wx:for="{{collectedGifts}}" wx:key="giftId" bindtap="showGiftDetail" data-gift="{{item}}">
          <view class="item-rarity-dot rarity-dot-{{item.rarity}}"></view>
          <image wx:if="{{item.imageUrl}}" class="item-icon-img" src="{{item.imageUrl}}" mode="aspectFit" binderror="onImageError" data-index="{{index}}" data-type="collected"></image>
          <view wx:else class="item-icon">{{item.icon}}</view>
          <view class="item-name">{{item.name}}</view>
          <view class="item-count" wx:if="{{item.count > 1}}">x{{item.count}}</view>
        </view>
        <view class="collection-item locked" wx:for="{{lockedGifts}}" wx:key="giftId" bindtap="showGiftDetail" data-gift="{{item}}">
          <view class="item-rarity-dot rarity-dot-{{item.rarity}}"></view>
          <image wx:if="{{item.imageUrl}}" class="item-icon-img" src="{{item.imageUrl}}" mode="aspectFit" binderror="onImageError" data-index="{{index}}" data-type="locked"></image>
          <view wx:else class="item-icon">{{item.icon}}</view>
          <view class="item-name">{{item.name}}</view>
        </view>
      </view>

      <view class="empty-state" wx:if="{{collectedGifts.length === 0 && lockedGifts.length === 0}}">
        <view class="empty-text">藏馆空空如也</view>
        <view class="empty-hint">收到回信后，风物将存入藏馆</view>
      </view>
    </block>

  </scroll-view>

  <view class="detail-mask" wx:if="{{detailVisible}}" bindtap="closeDetail"></view>
  <view class="detail-popup" wx:if="{{detailVisible && detailGift}}">
    <view class="detail-close" bindtap="closeDetail">
      <view class="detail-close-icon"></view>
    </view>
    <view class="detail-header">
      <image wx:if="{{detailGift.imageUrl}}" class="detail-icon-img" src="{{detailGift.imageUrl}}" mode="aspectFit" binderror="onDetailImageError"></image>
      <view wx:else class="detail-icon-fallback">{{detailGift.icon}}</view>
      <view class="detail-title-area">
        <view class="detail-name">{{detailGift.name}}</view>
        <view class="detail-meta">
          <text class="detail-rarity rarity-text-{{detailGift.rarity}}">{{detailGift.rarityLabel}}</text>
          <text class="detail-dynasty" wx:if="{{detailGift.dynastyName}}">{{detailGift.dynastyName}}</text>
          <text class="detail-type">{{detailGift.type}}</text>
        </view>
      </view>
    </view>
    <view class="detail-status" wx:if="{{detailGift.locked}}">
      <text class="detail-locked-tag">未解锁</text>
    </view>
    <view class="detail-count" wx:if="{{!detailGift.locked && detailGift.count > 1}}">已收藏 x{{detailGift.count}}</view>
    <image wx:if="{{detailGift.photoUrl}}" class="detail-photo" src="{{detailGift.photoUrl}}" mode="aspectFit" binderror="onDetailPhotoError"></image>
    <view class="detail-desc">{{detailGift.desc}}</view>
    <view class="detail-history">{{detailGift.history}}</view>
  </view>

</view>
