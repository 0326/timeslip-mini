.login-page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 64rpx;
  padding-bottom: calc(60rpx + env(safe-area-inset-bottom));
  position: relative;
  overflow: hidden;
  box-sizing: border-box;
}

.login-hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  position: absolute;
  left: 0;
  right: 0;
  z-index: 10;
  pointer-events: none;
  transition: top 0.58s cubic-bezier(0.4, 0, 0.2, 1),
    transform 0.58s cubic-bezier(0.4, 0, 0.2, 1);
}

.login-hero.is-center {
  top: 50%;
  transform: translateY(-50%);
}

.login-hero.is-top {
  top: calc(132rpx + env(safe-area-inset-top));
  transform: translateY(0);
}

.hero-logo {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 24rpx;
  animation: logo-spin 18s linear infinite;
  transition: width 0.58s cubic-bezier(0.4, 0, 0.2, 1),
    height 0.58s cubic-bezier(0.4, 0, 0.2, 1),
    margin-bottom 0.58s cubic-bezier(0.4, 0, 0.2, 1);
}

.login-hero.is-top .hero-logo {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 12rpx;
}

@keyframes logo-spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.hero-title {
  font-size: 56rpx;
  font-weight: bold;
  color: var(--ancient-ink);
  letter-spacing: 8rpx;
  margin-bottom: 12rpx;
  line-height: 1.12;
  transition: font-size 0.58s cubic-bezier(0.4, 0, 0.2, 1),
    margin-bottom 0.58s cubic-bezier(0.4, 0, 0.2, 1);
}

.login-hero.is-top .hero-title {
  font-size: 46rpx;
  margin-bottom: 8rpx;
}

.hero-subtitle {
  font-size: 26rpx;
  color: var(--wechat-text2);
  letter-spacing: 2rpx;
  opacity: 0.8;
  line-height: 1.35;
  transition: font-size 0.58s cubic-bezier(0.4, 0, 0.2, 1);
}

.login-hero.is-top .hero-subtitle {
  font-size: 24rpx;
}

.login-card {
  width: 100%;
  background: var(--wechat-white);
  border-radius: 24rpx;
  padding: 48rpx 48rpx 40rpx;
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.06);
  box-sizing: border-box;
  opacity: 0;
  transform: translateY(40rpx);
  transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
  transition-delay: 0.1s;
  margin-top: calc(500rpx + env(safe-area-inset-top));
  position: relative;
  z-index: 1;
}

.login-card.show {
  opacity: 1;
  transform: translateY(0);
}

.card-label {
  font-size: 28rpx;
  color: var(--wechat-text2);
  margin-bottom: 36rpx;
  letter-spacing: 2rpx;
  text-align: center;
  line-height: 1.35;
}

.avatar-wrap {
  margin: 0 auto 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-box {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  border-radius: 20rpx;
  background: #f7f7f7;
  border: 2rpx dashed #d9d9d9;
  overflow: hidden;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-btn-abs {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  width: 100%;
  height: 100%;
  padding: 0;
  margin: 0;
  border: none;
  background: transparent;
  opacity: 0;
  border-radius: 20rpx;
}

.avatar-btn-abs::after {
  border: none;
}

.avatar-img {
  width: 100%;
  height: 100%;
  display: block;
  flex-shrink: 0;
}

.avatar-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: var(--wechat-text2);
}

.avatar-plus {
  font-size: 64rpx;
  color: var(--ancient-gold);
  line-height: 1;
  margin-bottom: 6rpx;
}

.avatar-tip {
  font-size: 22rpx;
}

.nickname-row {
  width: 100%;
  margin-bottom: 36rpx;
  display: block;
  box-sizing: border-box;
}

.nickname-input {
  width: 100%;
  height: 88rpx;
  background: #f7f7f7;
  border-radius: 12rpx;
  padding: 0 28rpx;
  font-size: 30rpx;
  color: var(--wechat-text);
  box-sizing: border-box;
  display: block;
}

.agreement-row {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 24rpx;
  margin-bottom: 0;
  padding: 0;
  flex-wrap: wrap;
}

.checkbox {
  width: 28rpx;
  height: 28rpx;
  border-radius: 6rpx;
  border: 2rpx solid #b0b0b0;
  margin-right: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  background: #fff;
  box-sizing: border-box;
}

.checkbox.is-checked {
  background: #07c160;
  border-color: #07c160;
}

.check-mark {
  width: 14rpx;
  height: 8rpx;
  border-left: 3rpx solid #fff;
  border-bottom: 3rpx solid #fff;
  transform: rotate(-45deg) translateY(-1rpx);
  display: block;
}

.agreement-desc {
  font-size: 24rpx;
  color: var(--wechat-text2);
  line-height: 1.4;
}

.protocol-link {
  font-size: 24rpx;
  color: var(--wechat-blue);
  line-height: 1.4;
}

.submit-btn {
  width: 100% !important;
  height: 88rpx;
  line-height: 88rpx;
  background: #cccccc;
  color: #fff;
  font-size: 32rpx;
  letter-spacing: 8rpx;
  border-radius: 12rpx;
  border: none;
  display: block;
  padding: 0;
  margin: 0;
  box-sizing: border-box;
}

.submit-btn::after {
  border: none;
  border-radius: 12rpx;
}

.submit-btn.is-active {
  background: linear-gradient(135deg, #C9A24D 0%, #A67B2D 100%);
  box-shadow: 0 6rpx 20rpx rgba(201, 162, 77, 0.35);
}

.submit-btn[disabled] {
  color: #fff;
  opacity: 1;
}

.submit-btn.is-active[disabled] {
  opacity: 0.7;
}

.login-footer {
  margin-top: auto;
  padding-top: 40rpx;
  font-size: 22rpx;
  color: var(--wechat-text2);
  letter-spacing: 4rpx;
  text-align: center;
  opacity: 0;
  transition: opacity 0.4s ease;
  transition-delay: 0.2s;
}

.login-footer.show {
  opacity: 1;
}
