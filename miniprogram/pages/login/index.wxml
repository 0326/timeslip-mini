<view class="login-page ancient-paper">
  <view class="login-hero {{showRegister ? 'is-top' : 'is-center'}}">
    <image class="hero-logo" src="/images/logo-256.png" mode="aspectFit"></image>
    <view class="hero-title">穿越圈</view>
    <view class="hero-subtitle">与古人对话 · 共续千秋</view>
  </view>

  <view class="login-card {{showRegister ? 'show' : ''}}">
    <view class="card-label">{{profileRepair ? '请重新选择头像' : '请选择头像与昵称'}}</view>

    <view class="avatar-wrap">
      <view class="avatar-box">
        <image wx:if="{{form.avatarUrl}}" class="avatar-img" src="{{form.avatarUrl}}" mode="aspectFill"></image>
        <view wx:else class="avatar-placeholder">
          <text class="avatar-plus">＋</text>
          <text class="avatar-tip">选头像</text>
        </view>
        <!-- 微信小程序端：使用官方 open-type="chooseAvatar" -->
        <button
          wx:if="{{canUseChooseAvatar}}"
          class="avatar-btn-abs"
          open-type="chooseAvatar"
          bind:chooseavatar="onChooseAvatar"
        ></button>
        <!-- Donut App/H5 端：降级为点击选择本地图片 -->
        <view wx:else class="avatar-btn-abs" bindtap="onChooseAvatarLocal"></view>
      </view>
      <view wx:if="{{!canUseChooseAvatar}}" class="platform-tip">当前环境请点击选择本地图片作为头像</view>
    </view>

    <view class="nickname-row">
      <input
        class="nickname-input"
        wx:if="{{canUseChooseAvatar}}"
        type="nickname"
        placeholder="请输入昵称（最多10字）"
        placeholder-style="color:#b2b2b2"
        maxlength="10"
        value="{{form.nickName}}"
        bindinput="onNicknameInput"
        bindblur="onNicknameBlur"
        confirm-type="done"
      />
      <input
        wx:else
        class="nickname-input"
        placeholder="请输入昵称（最多10字）"
        placeholder-style="color:#b2b2b2"
        maxlength="10"
        value="{{form.nickName}}"
        bindinput="onNicknameInput"
        bindblur="onNicknameBlur"
        confirm-type="done"
      />
    </view>

    <button
      class="submit-btn {{canSubmit ? 'is-active' : ''}}"
      bindtap="onSubmit"
      disabled="{{submitting}}"
    >进入穿越圈</button>

    <view class="agreement-row" bindtap="onToggleAgree">
      <view class="checkbox {{form.agreed ? 'is-checked' : ''}}">
        <view class="check-mark"></view>
      </view>
      <text class="agreement-desc">我已阅读并同意</text>
      <text class="protocol-link" catchtap="onOpenAgreement">《用户协议与隐私政策》</text>
    </view>
  </view>

  <view class="login-footer {{showRegister ? 'show' : ''}}">
    <text>穿越兰台 | 趣读历史</text>
  </view>
</view>
