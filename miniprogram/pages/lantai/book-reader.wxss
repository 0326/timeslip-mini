.reader-page {
  min-height: 100vh;
  background: #FFF9F0;
}

.reader-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 0 16rpx;
  height: 100%;
}

.r-btn {
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  background: rgba(201, 162, 77, 0.15);
  color: var(--ancient-wood);
}

.catalog-wrap {
  padding: 16rpx 32rpx 32rpx;
}

.book-hero {
  display: flex;
  gap: 24rpx;
  padding: 32rpx;
  background: rgba(255, 255, 255, 0.6);
  border-radius: 20rpx;
  border: 1rpx solid rgba(201, 162, 77, 0.2);
  margin-bottom: 24rpx;
}

.hero-cover {
  width: 180rpx;
  height: 240rpx;
  background: linear-gradient(135deg, #8B4513 0%, #5D3A1A 100%);
  color: var(--ancient-gold);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  border-radius: 8rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.2);
  writing-mode: vertical-rl;
  padding: 24rpx 0;
  letter-spacing: 8rpx;
  flex-shrink: 0;
}

.hero-meta {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 8rpx 0;
}

.hm-title {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--ancient-ink);
  letter-spacing: 4rpx;
  margin-bottom: 8rpx;
}

.hm-desc {
  font-size: 24rpx;
  color: #987;
}

.catalog-list {
  background: rgba(255, 255, 255, 0.5);
  border-radius: 20rpx;
  padding: 24rpx;
  border: 1rpx solid rgba(201, 162, 77, 0.15);
}

.cat-title {
  font-size: 34rpx;
  font-weight: 700;
  text-align: center;
  color: var(--ancient-ink);
  letter-spacing: 12rpx;
  padding: 8rpx 0 20rpx;
  border-bottom: 2rpx solid rgba(201, 162, 77, 0.25);
  margin-bottom: 16rpx;
}

.cat-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx dashed rgba(201, 162, 77, 0.2);
  transition: background 0.15s;
}

.cat-hover {
  background: rgba(255, 255, 255, 0.5);
  border-radius: 12rpx;
  padding: 20rpx 16rpx;
}

.cat-item:last-child {
  border-bottom: none;
}

.cat-sub {
  width: 130rpx;
  font-size: 22rpx;
  color: var(--ancient-gold);
  flex-shrink: 0;
  line-height: 1.3;
}

.cat-body {
  flex: 1;
  min-width: 0;
  padding: 0 16rpx;
}

.cat-t {
  display: block;
  font-size: 30rpx;
  color: var(--ancient-ink);
  font-weight: 600;
  margin-bottom: 8rpx;
}

.cat-progress {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.p-bar {
  flex: 1;
  height: 8rpx;
  background: rgba(0, 0, 0, 0.05);
  border-radius: 4rpx;
  overflow: hidden;
  max-width: 200rpx;
}

.p-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--ancient-gold), #E8C872);
  border-radius: 4rpx;
  transition: width 0.4s ease;
}

.p-text {
  font-size: 20rpx;
  color: #bba988;
}

.cat-icon {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: rgba(201, 162, 77, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.ci-check { color: var(--wechat-green); font-size: 28rpx; font-weight: 700; }
.ci-arrow { color: var(--ancient-gold); font-size: 36rpx; }

.content-wrap {
  padding: 32rpx;
}

.ch-head {
  text-align: center;
  padding: 16rpx 0 32rpx;
  border-bottom: 1rpx solid rgba(201, 162, 77, 0.3);
  margin-bottom: 24rpx;
}

.ch-sub {
  display: block;
  font-size: 24rpx;
  color: var(--ancient-gold);
  margin-bottom: 12rpx;
}

.ch-title {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--ancient-ink);
  letter-spacing: 8rpx;
}

.content-block {
  margin-bottom: 32rpx;
  padding: 28rpx;
  background: rgba(255, 255, 255, 0.6);
  border-radius: 16rpx;
  border: 1rpx solid rgba(201, 162, 77, 0.15);
}

.block-title {
  font-size: 24rpx;
  color: var(--ancient-gold);
  font-weight: 600;
  margin-bottom: 16rpx;
  letter-spacing: 2rpx;
}

.content-text {
  color: #321;
  line-height: 2;
  white-space: pre-line;
  word-break: break-all;
  text-indent: 2em;
}

.translation .content-text {
  color: #543;
  text-indent: 0;
}

.notes-block {
  padding: 24rpx;
  background: rgba(183, 28, 28, 0.04);
  border-left: 6rpx solid var(--ancient-seal);
  border-radius: 8rpx;
}

.note-item {
  padding: 12rpx 0;
  font-size: 26rpx;
  line-height: 1.6;
}

.n-key {
  color: var(--ancient-seal);
  font-weight: 600;
}

.n-val {
  color: #543;
}

.reader-toolbar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: rgba(255, 249, 240, 0.95);
  backdrop-filter: blur(12rpx);
  border-top: 1rpx solid rgba(201, 162, 77, 0.2);
  display: flex;
  padding: 16rpx 24rpx;
  gap: 16rpx;
  z-index: 100;
}

.t-btn {
  flex: 1;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: var(--ancient-wood);
  font-weight: 500;
  border: 1rpx solid rgba(201, 162, 77, 0.25);
  transition: all 0.15s;
}

.t-btn:active {
  background: var(--ancient-paper);
  transform: scale(0.97);
}
