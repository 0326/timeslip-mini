.reader-page {
  min-height: 100vh;
  background: #FFF9F0;
}

.catalog-wrap {
  padding: 16rpx 32rpx 32rpx;
}

.book-hero {
  display: flex;
  gap: 24rpx;
  padding: 32rpx;
  background: rgba(255, 255, 255, 0.6);
  border-radius: 20rpx;
  border: 1rpx solid rgba(201, 162, 77, 0.2);
  margin-bottom: 24rpx;
}

.hero-cover {
  width: 180rpx;
  height: 240rpx;
  background: linear-gradient(135deg, #8B4513 0%, #5D3A1A 100%);
  color: var(--ancient-gold);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  border-radius: 8rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.2);
  writing-mode: vertical-rl;
  padding: 24rpx 0;
  letter-spacing: 8rpx;
  flex-shrink: 0;
}

.hero-meta {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 8rpx 0;
}

.hm-title {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--ancient-ink);
  letter-spacing: 4rpx;
  margin-bottom: 8rpx;
}

.hm-desc {
  font-size: 24rpx;
  color: #987;
}

.catalog-list {
  background: rgba(255, 255, 255, 0.5);
  border-radius: 20rpx;
  padding: 24rpx;
  border: 1rpx solid rgba(201, 162, 77, 0.15);
}

.cat-title {
  font-size: 34rpx;
  font-weight: 700;
  text-align: center;
  color: var(--ancient-ink);
  letter-spacing: 12rpx;
  padding: 8rpx 0 20rpx;
  border-bottom: 2rpx solid rgba(201, 162, 77, 0.25);
  margin-bottom: 16rpx;
}

.cat-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx dashed rgba(201, 162, 77, 0.2);
  transition: background 0.15s;
}

.cat-hover {
  background: rgba(255, 255, 255, 0.5);
  border-radius: 12rpx;
  padding: 20rpx 16rpx;
}

.cat-item:last-child {
  border-bottom: none;
}

.cat-body {
  flex: 1;
  min-width: 0;
  padding: 0 16rpx;
}

.cat-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  min-width: 0;
}

.cat-t {
  flex: 1;
  font-size: 30rpx;
  color: var(--ancient-ink);
  font-weight: 600;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.cat-progress {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  flex-shrink: 0;
}

.p-bar {
  width: 120rpx;
  height: 8rpx;
  background: rgba(0, 0, 0, 0.05);
  border-radius: 4rpx;
  overflow: hidden;
  flex-shrink: 0;
}

.p-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--ancient-gold), #E8C872);
  border-radius: 4rpx;
  transition: width 0.4s ease;
}

.p-text {
  font-size: 20rpx;
  color: #bba988;
  flex-shrink: 0;
  width: 56rpx;
  text-align: right;
}

.cat-icon {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: rgba(201, 162, 77, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.ci-check { color: var(--wechat-green); font-size: 28rpx; font-weight: 700; }
.ci-arrow { color: var(--ancient-gold); font-size: 36rpx; }

/* ===== 章节目录骨架屏 ===== */
.cat-skeleton {
  display: flex;
  flex-direction: column;
}
.sk-cat-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx dashed rgba(201, 162, 77, 0.15);
}
.sk-cat-item:last-child { border-bottom: none; }
.sk-cat-row {
  flex: 1;
  min-width: 0;
  padding: 0 16rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.sk-cat-title {
  flex: 1;
  height: 30rpx;
  border-radius: 6rpx;
  background: linear-gradient(
    90deg,
    rgba(201, 162, 77, 0.08) 25%,
    rgba(201, 162, 77, 0.16) 37%,
    rgba(201, 162, 77, 0.08) 63%
  );
  background-size: 400% 100%;
  animation: sk-shine 1.4s ease infinite;
}
.sk-cat-progress {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  flex-shrink: 0;
}
.sk-cat-bar {
  width: 120rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background: linear-gradient(
    90deg,
    rgba(201, 162, 77, 0.08) 25%,
    rgba(201, 162, 77, 0.16) 37%,
    rgba(201, 162, 77, 0.08) 63%
  );
  background-size: 400% 100%;
  animation: sk-shine 1.4s ease infinite;
  flex-shrink: 0;
}
.sk-cat-pct {
  width: 56rpx;
  height: 20rpx;
  border-radius: 4rpx;
  background: linear-gradient(
    90deg,
    rgba(201, 162, 77, 0.08) 25%,
    rgba(201, 162, 77, 0.16) 37%,
    rgba(201, 162, 77, 0.08) 63%
  );
  background-size: 400% 100%;
  animation: sk-shine 1.4s ease infinite;
  flex-shrink: 0;
}
.sk-cat-icon {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background: linear-gradient(
    90deg,
    rgba(201, 162, 77, 0.08) 25%,
    rgba(201, 162, 77, 0.16) 37%,
    rgba(201, 162, 77, 0.08) 63%
  );
  background-size: 400% 100%;
  animation: sk-shine 1.4s ease infinite;
}
@keyframes sk-shine {
  0% { background-position: 100% 50%; }
  100% { background-position: 0 50%; }
}

.fav-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  background: rgba(255,255,255,0.1);
  font-size: 26rpx;
  color: #666;
  align-self: flex-start;
  margin-top: 16rpx;
}
.fav-btn.active {
  color: #C9A24D;
  background: rgba(201,162,77,0.1);
}
.fav-text { font-size: 24rpx; }
