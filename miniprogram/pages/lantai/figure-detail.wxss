.figure-detail {
  min-height: 100vh;
  padding-bottom: 40rpx;
}

.loading-wrap {
  padding: 200rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.spinner {
  width: 60rpx;
  height: 60rpx;
  border: 6rpx solid rgba(201, 162, 77, 0.2);
  border-top-color: var(--ancient-gold);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 16rpx;
}
@keyframes spin { to { transform: rotate(360deg); } }

.loading-text {
  font-size: 26rpx;
  color: var(--wechat-text2);
}

.detail-hero {
  position: relative;
  padding: 140rpx 32rpx 32rpx;
  overflow: hidden;
}

.hero-bg {
  position: absolute;
  inset: 0;
  background:
    radial-gradient(circle at 30% 10%, rgba(201, 162, 77, 0.25) 0%, transparent 60%),
    linear-gradient(180deg, rgba(240, 225, 190, 0.8) 0%, rgba(248, 246, 242, 0) 100%);
}

.hero-inner {
  position: relative;
  display: flex;
  gap: 24rpx;
  align-items: flex-end;
}

.hero-avatar {
  width: 180rpx;
  height: 220rpx;
  flex-shrink: 0;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 32rpx rgba(45, 24, 16, 0.25);
  background: #fff;
  border: 2rpx solid rgba(201, 162, 77, 0.3);
}

.hero-meta {
  flex: 1;
  min-width: 0;
  padding-bottom: 10rpx;
}

.h-name-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 12rpx;
  flex-wrap: wrap;
}

.h-name {
  font-size: 52rpx;
  font-weight: 800;
  color: var(--ancient-ink);
  font-family: 'Noto Serif SC', serif;
  letter-spacing: 4rpx;
}

.h-tags {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
  margin-bottom: 8rpx;
}

.h-tag {
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 500;
}

.h-tag-plain {
  background: rgba(0, 0, 0, 0.04);
  color: #654;
}

.h-lifespan {
  font-size: 24rpx;
  color: var(--ancient-wood);
  font-family: 'Noto Serif SC', serif;
  letter-spacing: 1rpx;
}

.action-bar {
  display: flex;
  gap: 16rpx;
  padding: 0 32rpx 24rpx;
}

.a-btn {
  flex: 1;
  height: 84rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  transition: transform 0.15s, opacity 0.15s;
}

.a-btn:active {
  transform: scale(0.97);
  opacity: 0.9;
}

.a-primary {
  background: var(--wechat-green);
  color: #fff;
  box-shadow: 0 4rpx 16rpx rgba(7, 193, 96, 0.25);
}

.a-ancient {
  background: linear-gradient(135deg, #C9A24D, #A67B2D);
  color: #fff;
  box-shadow: 0 4rpx 16rpx rgba(201, 162, 77, 0.3);
}

.a-btn-icon { font-size: 32rpx; }
.a-btn-text {
  font-size: 28rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.sub-tabs {
  display: flex;
  padding: 0 24rpx 16rpx;
  gap: 8rpx;
}

.st {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  font-size: 26rpx;
  color: #888;
  border-bottom: 4rpx solid transparent;
  transition: all 0.2s;
}

.st.is-active {
  color: var(--ancient-gold);
  font-weight: 600;
  border-bottom-color: var(--ancient-gold);
  font-family: 'Noto Serif SC', serif;
}

.tab-body {
  padding: 0 24rpx;
}

.section-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  border: 1rpx solid rgba(201, 162, 77, 0.12);
  box-shadow: 0 4rpx 16rpx rgba(45, 24, 16, 0.03);
}

.card-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--ancient-ink);
  margin-bottom: 16rpx;
  font-family: 'Noto Serif SC', serif;
  padding-left: 16rpx;
  border-left: 6rpx solid var(--ancient-gold);
  line-height: 1;
}

.card-text {
  font-size: 28rpx;
  color: #443322;
  line-height: 1.85;
  font-family: 'Noto Serif SC', serif;
  text-indent: 2em;
  white-space: pre-line;
}

.work-item {
  padding: 20rpx 24rpx;
  background: rgba(201, 162, 77, 0.06);
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #543;
  margin-bottom: 12rpx;
  border-left: 4rpx solid var(--ancient-gold);
}

.work-item:last-child { margin-bottom: 0; }

.quote-item {
  padding: 20rpx 12rpx;
  border-bottom: 1rpx dashed rgba(201, 162, 77, 0.25);
  position: relative;
}

.quote-item:last-child { border-bottom: none; }

.quote-mark {
  color: var(--ancient-seal);
  font-family: 'Ma Shan Zheng', serif;
  font-size: 36rpx;
  line-height: 1;
}

.quote-text {
  font-size: 30rpx;
  color: var(--ancient-ink);
  font-family: 'Noto Serif SC', serif;
  line-height: 1.8;
  padding: 0 8rpx;
}

.rel-item {
  display: flex;
  align-items: center;
  padding: 16rpx;
  border-radius: 12rpx;
  background: #fafaf2;
  margin-bottom: 12rpx;
}

.rel-item:last-child { margin-bottom: 0; }

.rel-cover {
  width: 100rpx;
  height: 120rpx;
  background: linear-gradient(135deg, #8B4513, #5D3A1A);
  color: var(--ancient-gold);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  padding: 0 8rpx;
  border-radius: 6rpx;
  text-align: center;
  font-family: 'Ma Shan Zheng', serif;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.rel-meta { flex: 1; min-width: 0; }
.rel-title { display: block; font-size: 28rpx; font-weight: 600; color: #321; margin-bottom: 4rpx; }
.rel-ch { font-size: 22rpx; color: #987; }
.rel-arrow { color: #ccc; font-size: 40rpx; padding: 0 8rpx; }

.rel-m-item {
  padding: 20rpx;
  background: rgba(183, 28, 28, 0.04);
  border-radius: 12rpx;
  margin-bottom: 12rpx;
  border-left: 4rpx solid var(--ancient-seal);
}
.rel-m-item:last-child { margin-bottom: 0; }

.rm-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}
.rm-title { font-size: 28rpx; font-weight: 600; color: var(--ancient-seal); }
.rm-time { font-size: 22rpx; color: #a98; }
.rm-desc { font-size: 26rpx; color: #432; line-height: 1.6; }
.rm-who { display: block; margin-top: 8rpx; font-size: 22rpx; color: #987; }

.bottom-pad {
  height: calc(80rpx + env(safe-area-inset-bottom));
}
