.figure-detail {
  min-height: 100vh;
  padding-bottom: 40rpx;
}

.loading-wrap {
  padding: 200rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.spinner {
  width: 60rpx;
  height: 60rpx;
  border: 6rpx solid rgba(201, 162, 77, 0.2);
  border-top-color: var(--ancient-gold);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 16rpx;
}
@keyframes spin { to { transform: rotate(360deg); } }

.loading-text {
  font-size: 26rpx;
  color: var(--wechat-text2);
}

.detail-hero {
  position: relative;
  padding: 160rpx 32rpx 32rpx;
  overflow: hidden;
  background:
    radial-gradient(circle at 30% 10%, rgba(201, 162, 77, 0.25) 0%, transparent 60%),
    linear-gradient(180deg, rgba(240, 225, 190, 0.8) 0%, rgba(248, 246, 242, 0) 100%);
}



.hero-inner {
  position: relative;
  display: flex;
  gap: 24rpx;
  align-items: flex-end;
}

.hero-avatar {
  width: 180rpx;
  height: 180rpx;
  flex-shrink: 0;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 32rpx rgba(45, 24, 16, 0.25);
  background: #fff;
  border: 2rpx solid rgba(201, 162, 77, 0.3);
}

.hero-avatar .avatar-wrap {
  width: 100% !important;
  height: 100% !important;
  border-radius: 16rpx !important;
}

.hero-meta {
  flex: 1;
  min-width: 0;
  padding-bottom: 10rpx;
}

.h-name-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 12rpx;
  flex-wrap: wrap;
}

.h-name {
  font-size: 52rpx;
  font-weight: 800;
  color: var(--ancient-ink);
  letter-spacing: 4rpx;
}

.h-tags {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
  margin-bottom: 8rpx;
}

.h-tag {
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 500;
}

.h-tag-plain {
  background: rgba(0, 0, 0, 0.04);
  color: #654;
}

.h-lifespan {
  font-size: 24rpx;
  color: var(--ancient-wood);
  letter-spacing: 1rpx;
}

.action-bar {
  display: flex;
  gap: 16rpx;
  padding: 0 32rpx 24rpx;
}

.a-btn {
  flex: 1;
  height: 84rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  transition: transform 0.15s, opacity 0.15s;
}

.a-btn:active {
  transform: scale(0.97);
  opacity: 0.9;
}

.a-primary {
  background: linear-gradient(135deg, #07C160, #06AD56);
  color: #fff !important;
  box-shadow: 0 4rpx 16rpx rgba(7, 193, 96, 0.35);
}

.a-ancient {
  background: linear-gradient(135deg, #C9A24D, #A67B2D);
  color: #fff !important;
  box-shadow: 0 4rpx 16rpx rgba(201, 162, 77, 0.35);
}

.a-btn-icon { font-size: 32rpx; color: #fff !important; }
.a-btn-text {
  font-size: 28rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  color: #fff !important;
}

.a-btn.is-disabled {
  opacity: 0.45;
  filter: grayscale(0.3);
  pointer-events: auto;
}

.a-btn.is-disabled:active {
  transform: none;
  opacity: 0.45;
}

.sub-tabs {
  display: flex;
  padding: 0 24rpx 16rpx;
  gap: 8rpx;
}

.st {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  font-size: 26rpx;
  color: #888;
  border-bottom: 4rpx solid transparent;
  transition: all 0.2s;
}

.st.is-active {
  color: var(--ancient-gold);
  font-weight: 600;
  border-bottom-color: var(--ancient-gold);
}

.tab-body {
  padding: 0 24rpx;
}

.section-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  border: 1rpx solid rgba(201, 162, 77, 0.12);
  box-shadow: 0 4rpx 16rpx rgba(45, 24, 16, 0.03);
}

.card-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--ancient-ink);
  margin-bottom: 16rpx;
  padding-left: 16rpx;
  border-left: 6rpx solid var(--ancient-gold);
  line-height: 1;
}

.card-text {
  font-size: 28rpx;
  color: #443322;
  line-height: 1.85;
  text-indent: 2em;
  white-space: pre-line;
}

.work-item {
  padding: 20rpx 24rpx;
  background: rgba(201, 162, 77, 0.06);
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #543;
  margin-bottom: 12rpx;
  border-left: 4rpx solid var(--ancient-gold);
}

.work-item:last-child { margin-bottom: 0; }

.quote-item {
  padding: 20rpx 12rpx;
  border-bottom: 1rpx dashed rgba(201, 162, 77, 0.25);
  position: relative;
}

.quote-item:last-child { border-bottom: none; }

.quote-mark {
  color: var(--ancient-seal);
  font-size: 36rpx;
  line-height: 1;
}

.quote-text {
  font-size: 30rpx;
  color: var(--ancient-ink);
  line-height: 1.8;
  padding: 0 8rpx;
}

.related-books-wrap {
  padding: 8rpx 0 4rpx;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 24rpx 16rpx;
}

.book-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0;
  background: transparent;
  border: none;
  box-shadow: none;
  min-width: 0;
}

.book-hover {
  opacity: 0.92;
  transform: translateY(2rpx);
}

.book-cover {
  position: relative;
  width: 100%;
  height: 240rpx;
  border-radius: 4rpx 10rpx 10rpx 4rpx;
  overflow: hidden;
  background:
    linear-gradient(90deg, rgba(0, 0, 0, 0.28) 0 10rpx, rgba(0, 0, 0, 0) 46rpx),
    repeating-linear-gradient(0deg, rgba(255, 255, 255, 0.035) 0 4rpx, rgba(0, 0, 0, 0.035) 4rpx 8rpx),
    linear-gradient(135deg, #46565e 0%, #384850 56%, #2f3e46 100%);
  box-shadow:
    0 2rpx 0 rgba(255, 255, 255, 0.08) inset,
    0 12rpx 28rpx rgba(37, 32, 24, 0.2),
    0 4rpx 8rpx rgba(37, 32, 24, 0.16);
  box-sizing: border-box;
}

.book-spine {
  position: absolute;
  top: 0;
  left: 0;
  width: 32rpx;
  height: 100%;
  background: linear-gradient(90deg, rgba(0, 0, 0, 0.32), rgba(0, 0, 0, 0));
}

.book-spine::before {
  content: '';
  position: absolute;
  left: 16rpx;
  top: 28rpx;
  bottom: 36rpx;
  width: 4rpx;
  border-radius: 4rpx;
  background:
    radial-gradient(circle, rgba(20, 18, 14, 0.92) 45%, transparent 48%) 0 0 / 4rpx 28rpx repeat-y;
}

.book-no {
  position: absolute;
  top: 14rpx;
  right: 12rpx;
  min-width: 50rpx;
  height: 36rpx;
  line-height: 36rpx;
  padding: 0 8rpx;
  text-align: center;
  border-radius: 5rpx;
  background: #c93d35;
  color: #f8efe3;
  font-size: 18rpx;
  font-family: serif;
  box-shadow: 0 3rpx 8rpx rgba(0, 0, 0, 0.28);
  box-sizing: border-box;
}

.book-label {
  position: absolute;
  top: 28rpx;
  left: 42rpx;
  width: 52rpx;
  min-height: 120rpx;
  display: flex;
  justify-content: center;
  padding: 20rpx 0 24rpx;
  background: linear-gradient(180deg, #f3ecdd 0%, #ece2cd 100%);
  border: 2rpx solid rgba(59, 47, 33, 0.2);
  box-shadow: 0 3rpx 9rpx rgba(0, 0, 0, 0.2);
  box-sizing: border-box;
}

.cover-title {
  writing-mode: vertical-rl;
  text-orientation: upright;
  color: #241f18;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1.05;
  letter-spacing: 4rpx;
  text-align: center;
  max-height: 150rpx;
}

.book-foot {
  position: absolute;
  left: 106rpx;
  right: 12rpx;
  bottom: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 4rpx;
  padding: 40rpx 0 14rpx;
  background: linear-gradient(0deg, rgba(20, 18, 14, 0.36), transparent);
  box-sizing: border-box;
}

.book-dynasty {
  font-size: 22rpx;
  line-height: 1.2;
  color: #f2ead9;
  font-family: serif;
  letter-spacing: 2rpx;
  text-align: right;
  max-width: 100%;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.book-author {
  font-size: 20rpx;
  line-height: 1.2;
  color: rgba(242, 234, 217, 0.72);
  letter-spacing: 1rpx;
  text-align: right;
  max-width: 100%;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.rel-m-item {
  padding: 20rpx;
  background: rgba(183, 28, 28, 0.04);
  border-radius: 12rpx;
  margin-bottom: 12rpx;
  border-left: 4rpx solid var(--ancient-seal);
}
.rel-m-item:last-child { margin-bottom: 0; }

.rm-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}
.rm-title { font-size: 28rpx; font-weight: 600; color: var(--ancient-seal); }
.rm-time { font-size: 22rpx; color: #a98; }
.rm-desc { font-size: 26rpx; color: #432; line-height: 1.6; }
.rm-who { display: block; margin-top: 8rpx; font-size: 22rpx; color: #987; }

.bottom-pad {
  height: calc(80rpx + env(safe-area-inset-bottom));
}

.channel-header {
  display: flex;
  align-items: center;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.ch-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  background: #eee;
  flex-shrink: 0;
}

.ch-info {
  flex: 1;
  min-width: 0;
}

.ch-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #191919;
  margin-bottom: 8rpx;
}

.ch-title {
  font-size: 24rpx;
  color: #8e8e93;
  font-weight: normal;
}

.ch-bio {
  font-size: 24rpx;
  color: #8e8e93;
  margin-bottom: 8rpx;
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.ch-stats {
  font-size: 22rpx;
  color: #999;
}

.dot {
  margin: 0 12rpx;
}

.ch-follow {
  padding: 12rpx 32rpx;
  background: #07C160;
  border-radius: 30rpx;
  font-size: 26rpx;
  color: #fff;
  flex-shrink: 0;
}

.ch-follow.followed {
  background: rgba(0, 0, 0, 0.08);
  color: #666;
}

.video-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.video-grid-item {
  width: calc(50% - 8rpx);
  margin-bottom: 16rpx;
}

.vg-cover {
  position: relative;
  width: 100%;
  padding-bottom: 133%;
  background: #f5f5f5;
  border-radius: 12rpx;
  overflow: hidden;
}

.vg-img {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.vg-placeholder {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
}

.vg-title {
  font-size: 24rpx;
  color: #fff;
  text-align: center;
}

.vg-duration {
  position: absolute;
  right: 8rpx;
  bottom: 8rpx;
  padding: 2rpx 10rpx;
  background: rgba(0, 0, 0, 0.6);
  border-radius: 6rpx;
  font-size: 20rpx;
  color: #fff;
}

.vg-play-icon {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.8);
  display: flex;
  align-items: center;
  justify-content: center;
}

.vg-play-icon .iconfont {
  font-size: 28rpx;
  color: #333;
  margin-left: 4rpx;
}

.vg-text {
  display: block;
  font-size: 26rpx;
  color: #191919;
  margin-top: 10rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.vg-stats {
  font-size: 22rpx;
  color: #999;
  margin-top: 6rpx;
}

.empty-card {
  text-align: center;
  padding: 80rpx 0;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 20rpx;
  display: block;
}

.empty-text {
  font-size: 28rpx;
  color: #666;
  display: block;
}

.empty-desc {
  font-size: 24rpx;
  color: #999;
  margin-top: 10rpx;
  display: block;
}

.empty-hint {
  text-align: center;
  padding: 60rpx 0;
  color: #999;
  font-size: 26rpx;
}

.relations-list { padding: 0 24rpx; }
.relation-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}
.relation-item:last-child { border-bottom: none; }
.rel-name { font-size: 28rpx; color: #191919; }
.rel-type { font-size: 24rpx; color: #888; }
