<custom-nav-bar
  title="兰台"
  showBack="{{false}}"
  bgColor="#f8f6f2"
></custom-nav-bar>

<view class="lantai-page ancient-paper">
  <view class="tabs">
    <view
      class="tab-item {{tab === 'figures' ? 'is-active' : ''}}"
      data-tab="figures"
      bindtap="switchTab"
    >人物</view>
    <view
      class="tab-item {{tab === 'books' ? 'is-active' : ''}}"
      data-tab="books"
      bindtap="switchTab"
    >典籍</view>
  </view>

  <block wx:if="{{tab === 'figures'}}">
    <view wx:if="{{loading}}" class="loading-wrap">
      <text class="loading-text">加载人物中...</text>
    </view>

    <view wx:elif="{{groups.length === 0}}" class="empty">
      <text class="iconfont e-icon {{searchText ? 'icon-search' : 'icon-content'}}"></text>
      <text class="e-text">{{searchText ? '未找到相关人物' : (loadError ? '加载失败，下拉刷新重试' : '暂无人物数据')}}</text>
    </view>

    <scroll-view
      wx:else
      class="figure-scroll"
      scroll-y
      scroll-into-view="{{toLetter}}"
      enhanced
      show-scrollbar="{{false}}"
      refresher-enabled="{{true}}"
      refresher-triggered="{{figureRefresherTriggered}}"
      refresher-background="#f8f6f2"
      bindrefresherrefresh="onFigureRefresherRefresh"
    >
      <view
        wx:for="{{groups}}"
        wx:key="letter"
        class="group"
      >
        <view id="letter-{{item.letter}}" class="group-header">{{item.letter}}</view>
        <view
          wx:for="{{item.items}}"
          wx:for-item="f"
          wx:key="_id"
          class="contact-item {{!f.unlocked ? 'is-locked' : ''}}"
          data-id="{{f._id}}"
          bindtap="onFigureTap"
          hover-class="contact-hover"
        >
          <view class="c-avatar">
            <figure-avatar figure="{{f}}" size="md" shape="square"></figure-avatar>
          </view>
          <view class="c-info">
            <view class="c-name-row">
              <text class="c-name">{{f.name}}</text>
              <text class="c-tag" style="background:{{f.dynastyInfo.color}}22;color:{{f.dynastyInfo.color}};">{{f.dynastyInfo.name}}</text>
            </view>
            <text wx:if="{{f.title}}" class="c-title">{{f.title}}</text>
          </view>
          <text class="iconfont c-arrow icon-right"></text>
        </view>
      </view>
      <view class="bottom-safe"></view>
    </scroll-view>

    <view class="index-bar" wx:if="{{letters.length}}">
      <view
        wx:for="{{letters}}"
        wx:key="*this"
        class="index-item"
        data-letter="{{item}}"
        bindtap="onLetterTap"
      >{{item}}</view>
    </view>
  </block>

  <block wx:else>
    <view wx:if="{{loading}}" class="loading-wrap">
      <text class="loading-text">加载典籍中...</text>
    </view>
    <view wx:elif="{{filteredBooks.length === 0}}" class="empty">
      <text class="iconfont e-icon {{searchText ? 'icon-search' : 'icon-content'}}"></text>
      <text class="e-text">{{searchText ? '未找到相关典籍' : '暂无典籍数据'}}</text>
    </view>
    <scroll-view
      wx:else
      class="book-scroll"
      scroll-y
      enhanced
      show-scrollbar="{{false}}"
      refresher-enabled="{{true}}"
      refresher-triggered="{{bookRefresherTriggered}}"
      refresher-background="#f8f6f2"
      bindrefresherrefresh="onBookRefresherRefresh"
    >
      <view class="books-list">
        <view
          wx:for="{{filteredBooks}}"
          wx:key="id"
          class="book-item"
          data-id="{{item.id}}"
          bindtap="onBookTap"
          hover-class="book-hover"
        >
          <view class="book-cover">
            <view class="book-spine"></view>
            <view class="book-no">{{item.chapters}}篇</view>
            <view class="book-label">
              <text class="cover-title">{{item.title}}</text>
            </view>
            <view class="book-foot">
              <text class="book-dynasty">{{item.dynasty || '佚代'}}</text>
              <text class="book-author">{{item.author || '佚名'}}</text>
            </view>
          </view>
        </view>
      </view>
      <view class="bottom-safe"></view>
    </scroll-view>
  </block>
</view>
