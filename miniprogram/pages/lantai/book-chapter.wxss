.reader-page {
  min-height: 100vh;
  background: #FFF9F0;
}

.reader-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 0 16rpx;
  height: 100%;
}

.r-btn {
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  background: rgba(201, 162, 77, 0.15);
  color: var(--ancient-wood);
}

.content-wrap {
  padding: 32rpx;
}

.ch-head {
  text-align: center;
  padding: 16rpx 0 32rpx;
  border-bottom: 1rpx solid rgba(201, 162, 77, 0.3);
  margin-bottom: 24rpx;
}

.ch-sub {
  display: block;
  font-size: 24rpx;
  color: var(--ancient-gold);
  margin-bottom: 12rpx;
}

.ch-title {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--ancient-ink);
  letter-spacing: 8rpx;
}

.content-block {
  margin-bottom: 32rpx;
  padding: 28rpx;
  background: rgba(255, 255, 255, 0.6);
  border-radius: 16rpx;
  border: 1rpx solid rgba(201, 162, 77, 0.15);
}

.block-title {
  font-size: 24rpx;
  color: var(--ancient-gold);
  font-weight: 600;
  margin-bottom: 16rpx;
  letter-spacing: 2rpx;
}

.content-text {
  color: #321;
  line-height: 2;
  white-space: pre-line;
  word-break: break-all;
  text-indent: 2em;
}

.translation .content-text {
  color: #543;
  text-indent: 0;
}

.notes-block {
  padding: 24rpx;
  background: rgba(183, 28, 28, 0.04);
  border-left: 6rpx solid var(--ancient-seal);
  border-radius: 8rpx;
}

.note-item {
  padding: 12rpx 0;
  font-size: 26rpx;
  line-height: 1.6;
}

.n-key {
  color: var(--ancient-seal);
  font-weight: 600;
}

.n-val {
  color: #543;
}

.reader-toolbar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: rgba(255, 249, 240, 0.95);
  backdrop-filter: blur(12rpx);
  border-top: 1rpx solid rgba(201, 162, 77, 0.2);
  display: flex;
  padding: 16rpx 24rpx;
  gap: 16rpx;
  z-index: 100;
}

.t-btn {
  flex: 1;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: var(--ancient-wood);
  font-weight: 500;
  border: 1rpx solid rgba(201, 162, 77, 0.25);
  transition: all 0.15s;
}

.t-btn:active {
  background: var(--ancient-paper);
  transform: scale(0.97);
}

.t-disabled {
  opacity: 0.35;
  pointer-events: none;
}
