.lantai-page {
  min-height: 100vh;
  background:
    radial-gradient(ellipse at top left, rgba(201, 162, 77, 0.08) 0%, transparent 60%),
    radial-gradient(ellipse at bottom right, rgba(139, 90, 43, 0.06) 0%, transparent 60%),
    #f8f6f2;
}

.top-search {
  padding: 16rpx 32rpx;
  background: rgba(248, 246, 242, 0.9);
  backdrop-filter: blur(8rpx);
  position: sticky;
  top: 0;
  z-index: 10;
}

.search-box {
  display: flex;
  align-items: center;
  height: 72rpx;
  background: #fff;
  border-radius: 999rpx;
  padding: 0 28rpx;
  border: 1rpx solid rgba(201, 162, 77, 0.2);
  box-shadow: 0 4rpx 16rpx rgba(201, 162, 77, 0.08);
}

.s-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
  opacity: 0.5;
}

.s-input {
  flex: 1;
  font-size: 28rpx;
  height: 100%;
  color: #2D1810;
}

.tabs {
  display: flex;
  padding: 16rpx 32rpx 0;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  font-size: 30rpx;
  color: var(--wechat-text2);
  position: relative;
  transition: color 0.25s;
}

.tab-item.is-active {
  color: var(--ancient-gold);
  font-weight: 600;
  font-family: 'Noto Serif SC', serif;
}

.tab-item.is-active::after {
  content: '';
  position: absolute;
  left: 50%;
  bottom: 0;
  transform: translateX(-50%);
  width: 48rpx;
  height: 6rpx;
  background: var(--ancient-gold);
  border-radius: 3rpx;
  box-shadow: 0 2rpx 8rpx rgba(201, 162, 77, 0.4);
}

.filter-bar {
  white-space: nowrap;
  padding: 20rpx 24rpx 16rpx;
  background: transparent;
}

.filter-item {
  display: inline-flex;
  align-items: center;
  padding: 12rpx 28rpx;
  margin-right: 16rpx;
  font-size: 26rpx;
  color: var(--ancient-wood);
  background: rgba(255, 255, 255, 0.8);
  border-radius: 999rpx;
  border: 1rpx solid rgba(201, 162, 77, 0.2);
  transition: all 0.25s;
}

.filter-item.is-active {
  background: linear-gradient(135deg, #C9A24D 0%, #A67B2D 100%);
  color: #fff;
  border-color: transparent;
  box-shadow: 0 4rpx 16rpx rgba(201, 162, 77, 0.35);
}

.loading-wrap {
  padding: 120rpx 0;
  display: flex;
  justify-content: center;
}

.loading-text {
  color: var(--wechat-text2);
  font-size: 26rpx;
}

.empty {
  padding: 120rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.e-icon {
  font-size: 80rpx;
  opacity: 0.3;
  margin-bottom: 16rpx;
}

.e-text {
  color: #aaa;
  font-size: 26rpx;
}

.waterfall-wrap {
  display: flex;
  padding: 16rpx 20rpx 32rpx;
  gap: 16rpx;
}

.wf-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.wf-card {
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  border: 1rpx solid rgba(201, 162, 77, 0.15);
  box-shadow: 0 4rpx 20rpx rgba(45, 24, 16, 0.04);
  transition: transform 0.2s, box-shadow 0.2s;
}

.wf-card:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 8rpx rgba(45, 24, 16, 0.08);
}

.wf-card.is-locked {
  filter: grayscale(0.6);
  opacity: 0.85;
}

.wf-avatar {
  padding: 24rpx 24rpx 0;
  display: flex;
  justify-content: center;
}

.wf-body {
  padding: 16rpx 20rpx 20rpx;
}

.wf-name {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8rpx;
  margin-bottom: 6rpx;
}

.wf-name .n {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--ancient-ink);
  font-family: 'Noto Serif SC', serif;
}

.tag {
  flex-shrink: 0;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 500;
}

.wf-title {
  display: block;
  font-size: 22rpx;
  color: var(--ancient-gold);
  margin-bottom: 10rpx;
  font-family: 'Noto Serif SC', serif;
}

.wf-bio {
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
  font-size: 24rpx;
  color: #654;
  line-height: 1.55;
}

.wf-footer {
  margin-top: 16rpx;
  display: flex;
  justify-content: flex-end;
}

.wf-btn {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 20rpx;
  background: var(--wechat-green);
  color: #fff;
  font-size: 22rpx;
  border-radius: 999rpx;
}

.wf-btn-lock {
  background: #ddd;
  color: #999;
}

.books-list {
  padding: 24rpx 32rpx 32rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.book-item {
  display: flex;
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  border: 1rpx solid rgba(201, 162, 77, 0.15);
  box-shadow: 0 4rpx 20rpx rgba(45, 24, 16, 0.04);
}

.book-hover {
  background: #fafaf0;
}

.book-cover {
  width: 160rpx;
  height: 220rpx;
  flex-shrink: 0;
  background:
    linear-gradient(135deg, #8B4513 0%, #5D3A1A 100%);
  border-radius: 8rpx;
  margin-right: 24rpx;
  padding: 20rpx 16rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  box-shadow:
    -4rpx 0 0 rgba(0, 0, 0, 0.25) inset,
    4rpx 0 12rpx rgba(139, 69, 19, 0.3);
}

.cover-title {
  color: var(--ancient-gold);
  font-size: 34rpx;
  font-family: 'Ma Shan Zheng', 'Noto Serif SC', serif;
  line-height: 1.3;
  text-align: center;
  margin-top: auto;
}

.cover-author {
  color: rgba(255, 255, 255, 0.6);
  font-size: 20rpx;
  text-align: center;
  margin-top: auto;
}

.book-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.book-top {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 12rpx;
}

.book-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--ancient-ink);
  font-family: 'Noto Serif SC', serif;
}

.book-chap {
  font-size: 22rpx;
  color: var(--ancient-gold);
  font-weight: 600;
}

.book-desc {
  font-size: 26rpx;
  color: #654;
  line-height: 1.55;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.book-foot {
  margin-top: auto;
  padding-top: 12rpx;
}

.book-cta {
  font-size: 24rpx;
  color: var(--wechat-green);
  font-weight: 500;
}

.bottom-safe {
  height: calc(120rpx + env(safe-area-inset-bottom));
}
