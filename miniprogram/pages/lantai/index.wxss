.lantai-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background:
    radial-gradient(ellipse at top left, rgba(201, 162, 77, 0.08) 0%, transparent 60%),
    radial-gradient(ellipse at bottom right, rgba(139, 90, 43, 0.06) 0%, transparent 60%),
    #f8f6f2;
}

.top-search {
  padding: 16rpx 32rpx;
  background: rgba(248, 246, 242, 0.9);
  flex-shrink: 0;
}

.search-box {
  display: flex;
  align-items: center;
  height: 72rpx;
  background: #fff;
  border-radius: 999rpx;
  padding: 0 28rpx;
  border: 1rpx solid rgba(201, 162, 77, 0.2);
  box-shadow: 0 4rpx 16rpx rgba(201, 162, 77, 0.08);
}

.s-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
  opacity: 0.5;
}

.s-input {
  flex: 1;
  font-size: 28rpx;
  height: 100%;
  color: #2D1810;
}

.tabs {
  display: flex;
  padding: 16rpx 32rpx 0;
  flex-shrink: 0;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  font-size: 30rpx;
  color: var(--wechat-text2);
  position: relative;
  transition: color 0.25s;
}

.tab-item.is-active {
  color: var(--ancient-gold);
  font-weight: 600;
}

.loading-wrap {
  padding: 120rpx 0;
  display: flex;
  justify-content: center;
}

.loading-text {
  color: var(--wechat-text2);
  font-size: 26rpx;
}

.empty {
  padding: 120rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.e-icon {
  font-size: 80rpx;
  opacity: 0.3;
  margin-bottom: 16rpx;
}

.e-text {
  color: #aaa;
  font-size: 26rpx;
}

.figure-scroll {
  flex: 1;
  min-height: 0;
  position: relative;
}

.group-header {
  position: sticky;
  top: 0;
  z-index: 5;
  padding: 12rpx 32rpx;
  font-size: 24rpx;
  color: var(--ancient-wood);
  background: rgba(248, 246, 242, 0.95);
  font-weight: 600;
  letter-spacing: 2rpx;
}

.contact-item {
  display: flex;
  align-items: center;
  padding: 20rpx 32rpx;
  background: #fff;
  position: relative;
  transition: background 0.15s;
}

.contact-hover {
  background: #f5f3ee;
}

.contact-item::after {
  content: '';
  position: absolute;
  left: 140rpx;
  right: 32rpx;
  bottom: 0;
  height: 1rpx;
  background: #eee;
  opacity: 0.6;
}

.contact-item:last-child::after {
  display: none;
}

.contact-item.is-locked {
  opacity: 0.6;
}

.c-avatar {
  width: 88rpx;
  height: 88rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
  border-radius: 12rpx;
  overflow: hidden;
}

.c-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.c-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.c-name {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--ancient-ink);
}

.c-tag {
  flex-shrink: 0;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 500;
}

.c-title {
  font-size: 24rpx;
  color: var(--wechat-text2);
}

.c-arrow {
  font-size: 36rpx;
  color: #ccc;
  margin-left: 12rpx;
}

.index-bar {
  position: fixed;
  right: 8rpx;
  top: 50%;
  transform: translateY(-50%);
  z-index: 20;
  display: flex;
  flex-direction: column;
  align-items: center;
  background: rgba(255, 255, 255, 0.7);
  border-radius: 999rpx;
  padding: 8rpx 4rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.index-item {
  font-size: 22rpx;
  color: var(--ancient-wood);
  padding: 4rpx 8rpx;
  line-height: 1.2;
  font-weight: 600;
}

.index-item:active {
  color: var(--ancient-gold);
  transform: scale(1.2);
}

.book-scroll {
  flex: 1;
  min-height: 0;
}

.books-list {
  padding: 28rpx 28rpx 36rpx;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 30rpx 20rpx;
}

.book-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0;
  background: transparent;
  border: none;
  box-shadow: none;
  min-width: 0;
}

.book-hover {
  opacity: 0.92;
  transform: translateY(2rpx);
}

.book-cover {
  position: relative;
  width: 100%;
  height: 286rpx;
  border-radius: 4rpx 10rpx 10rpx 4rpx;
  overflow: hidden;
  background:
    linear-gradient(90deg, rgba(0, 0, 0, 0.28) 0 10rpx, rgba(0, 0, 0, 0) 46rpx),
    repeating-linear-gradient(0deg, rgba(255, 255, 255, 0.035) 0 4rpx, rgba(0, 0, 0, 0.035) 4rpx 8rpx),
    linear-gradient(135deg, #46565e 0%, #384850 56%, #2f3e46 100%);
  box-shadow:
    0 2rpx 0 rgba(255, 255, 255, 0.08) inset,
    0 14rpx 34rpx rgba(37, 32, 24, 0.2),
    0 4rpx 10rpx rgba(37, 32, 24, 0.16);
  box-sizing: border-box;
}

.book-spine {
  position: absolute;
  top: 0;
  left: 0;
  width: 36rpx;
  height: 100%;
  background: linear-gradient(90deg, rgba(0, 0, 0, 0.32), rgba(0, 0, 0, 0));
}

.book-spine::before {
  content: '';
  position: absolute;
  left: 18rpx;
  top: 34rpx;
  bottom: 42rpx;
  width: 4rpx;
  border-radius: 4rpx;
  background:
    radial-gradient(circle, rgba(20, 18, 14, 0.92) 45%, transparent 48%) 0 0 / 4rpx 34rpx repeat-y;
}

.book-no {
  position: absolute;
  top: 16rpx;
  right: 14rpx;
  min-width: 58rpx;
  height: 42rpx;
  line-height: 42rpx;
  padding: 0 10rpx;
  text-align: center;
  border-radius: 5rpx;
  background: #c93d35;
  color: #f8efe3;
  font-size: 20rpx;
  font-family: serif;
  box-shadow: 0 3rpx 8rpx rgba(0, 0, 0, 0.28);
  box-sizing: border-box;
}

.book-label {
  position: absolute;
  top: 34rpx;
  left: 48rpx;
  width: 62rpx;
  min-height: 150rpx;
  display: flex;
  justify-content: center;
  padding: 24rpx 0 28rpx;
  background: linear-gradient(180deg, #f3ecdd 0%, #ece2cd 100%);
  border: 2rpx solid rgba(59, 47, 33, 0.2);
  box-shadow: 0 3rpx 9rpx rgba(0, 0, 0, 0.2);
  box-sizing: border-box;
}

.cover-title {
  writing-mode: vertical-rl;
  text-orientation: upright;
  color: #241f18;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.05;
  letter-spacing: 5rpx;
  text-align: center;
  max-height: 178rpx;
}

.book-foot {
  position: absolute;
  left: 118rpx;
  right: 14rpx;
  bottom: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 4rpx;
  padding: 54rpx 0 18rpx;
  background: linear-gradient(0deg, rgba(20, 18, 14, 0.36), transparent);
  box-sizing: border-box;
}

.book-dynasty {
  font-size: 25rpx;
  line-height: 1.2;
  color: #f2ead9;
  font-family: serif;
  letter-spacing: 2rpx;
  text-align: right;
  max-width: 100%;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.book-author {
  font-size: 22rpx;
  line-height: 1.2;
  color: rgba(242, 234, 217, 0.72);
  letter-spacing: 1rpx;
  text-align: right;
  max-width: 100%;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.bottom-safe {
  height: calc(120rpx + env(safe-area-inset-bottom));
}
