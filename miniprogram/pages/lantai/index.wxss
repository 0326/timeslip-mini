.lantai-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background:
    radial-gradient(ellipse at top left, rgba(201, 162, 77, 0.08) 0%, transparent 60%),
    radial-gradient(ellipse at bottom right, rgba(139, 90, 43, 0.06) 0%, transparent 60%),
    #f8f6f2;
}

.top-search {
  padding: 16rpx 32rpx;
  background: rgba(248, 246, 242, 0.9);
  flex-shrink: 0;
}

.search-box {
  display: flex;
  align-items: center;
  height: 72rpx;
  background: #fff;
  border-radius: 999rpx;
  padding: 0 28rpx;
  border: 1rpx solid rgba(201, 162, 77, 0.2);
  box-shadow: 0 4rpx 16rpx rgba(201, 162, 77, 0.08);
}

.s-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
  opacity: 0.5;
}

.s-input {
  flex: 1;
  font-size: 28rpx;
  height: 100%;
  color: #2D1810;
}

.tabs {
  display: flex;
  padding: 16rpx 32rpx 0;
  flex-shrink: 0;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  font-size: 30rpx;
  color: var(--wechat-text2);
  position: relative;
  transition: color 0.25s;
}

.tab-item.is-active {
  color: var(--ancient-gold);
  font-weight: 600;
}

.tab-item.is-active::after {
  content: '';
  position: absolute;
  left: 50%;
  bottom: 0;
  transform: translateX(-50%);
  width: 48rpx;
  height: 6rpx;
  background: var(--ancient-gold);
  border-radius: 3rpx;
  box-shadow: 0 2rpx 8rpx rgba(201, 162, 77, 0.4);
}

.loading-wrap {
  padding: 120rpx 0;
  display: flex;
  justify-content: center;
}

.loading-text {
  color: var(--wechat-text2);
  font-size: 26rpx;
}

.empty {
  padding: 120rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.e-icon {
  font-size: 80rpx;
  opacity: 0.3;
  margin-bottom: 16rpx;
}

.e-text {
  color: #aaa;
  font-size: 26rpx;
}

.figure-scroll {
  flex: 1;
  min-height: 0;
  position: relative;
}

.group-header {
  position: sticky;
  top: 0;
  z-index: 5;
  padding: 12rpx 32rpx;
  font-size: 24rpx;
  color: var(--ancient-wood);
  background: rgba(248, 246, 242, 0.95);
  font-weight: 600;
  letter-spacing: 2rpx;
}

.contact-item {
  display: flex;
  align-items: center;
  padding: 20rpx 32rpx;
  background: #fff;
  position: relative;
  transition: background 0.15s;
}

.contact-hover {
  background: #f5f3ee;
}

.contact-item::after {
  content: '';
  position: absolute;
  left: 140rpx;
  right: 32rpx;
  bottom: 0;
  height: 1rpx;
  background: #eee;
  opacity: 0.6;
}

.contact-item:last-child::after {
  display: none;
}

.contact-item.is-locked {
  opacity: 0.6;
}

.c-avatar {
  width: 88rpx;
  height: 88rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
  border-radius: 12rpx;
  overflow: hidden;
}

.c-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.c-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.c-name {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--ancient-ink);
}

.c-tag {
  flex-shrink: 0;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 500;
}

.c-title {
  font-size: 24rpx;
  color: var(--wechat-text2);
}

.c-arrow {
  font-size: 36rpx;
  color: #ccc;
  margin-left: 12rpx;
}

.index-bar {
  position: fixed;
  right: 8rpx;
  top: 50%;
  transform: translateY(-50%);
  z-index: 20;
  display: flex;
  flex-direction: column;
  align-items: center;
  background: rgba(255, 255, 255, 0.7);
  border-radius: 999rpx;
  padding: 8rpx 4rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.index-item {
  font-size: 22rpx;
  color: var(--ancient-wood);
  padding: 4rpx 8rpx;
  line-height: 1.2;
  font-weight: 600;
}

.index-item:active {
  color: var(--ancient-gold);
  transform: scale(1.2);
}

.book-scroll {
  flex: 1;
  min-height: 0;
}

.books-list {
  padding: 24rpx 32rpx 32rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.book-item {
  display: flex;
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  border: 1rpx solid rgba(201, 162, 77, 0.15);
  box-shadow: 0 4rpx 20rpx rgba(45, 24, 16, 0.04);
}

.book-hover {
  background: #fafaf0;
}

.book-cover {
  width: 160rpx;
  height: 220rpx;
  flex-shrink: 0;
  background: linear-gradient(135deg, #8B4513 0%, #5D3A1A 100%);
  border-radius: 8rpx;
  margin-right: 24rpx;
  padding: 20rpx 16rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  box-shadow:
    -4rpx 0 0 rgba(0, 0, 0, 0.25) inset,
    4rpx 0 12rpx rgba(139, 69, 19, 0.3);
}

.cover-title {
  color: var(--ancient-gold);
  font-size: 34rpx;
  line-height: 1.3;
  text-align: center;
  margin-top: auto;
}

.cover-author {
  color: rgba(255, 255, 255, 0.6);
  font-size: 20rpx;
  text-align: center;
  margin-top: auto;
}

.book-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.book-top {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 12rpx;
}

.book-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--ancient-ink);
}

.book-chap {
  font-size: 22rpx;
  color: var(--ancient-gold);
  font-weight: 600;
}

.book-desc {
  font-size: 26rpx;
  color: #654;
  line-height: 1.55;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.book-foot {
  margin-top: auto;
  padding-top: 12rpx;
}

.book-cta {
  font-size: 24rpx;
  color: var(--wechat-green);
  font-weight: 500;
}

.bottom-safe {
  height: calc(120rpx + env(safe-area-inset-bottom));
}
