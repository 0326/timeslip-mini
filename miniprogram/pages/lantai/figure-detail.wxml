<custom-nav-bar
  title=""
  bgColor="transparent"
  textColor="#191919"
  translucent
  noPlaceholder
  fixed
></custom-nav-bar>

<view wx:if="{{loading}}" class="loading-wrap">
  <view class="spinner"></view>
  <text class="loading-text">加载中...</text>
</view>

<view wx:else class="figure-detail ancient-paper">
  <view class="detail-hero">
    <view class="hero-bg"></view>
    <view class="hero-inner">
      <view class="hero-avatar">
        <figure-avatar figure="{{figure}}" size="xl" shape="square"></figure-avatar>
      </view>
      <view class="hero-meta">
        <view class="h-name-row">
          <text class="h-name">{{figure.name}}</text>
          <view class="seal" wx:if="{{figure.title}}">{{figure.title}}</view>
        </view>
        <view class="h-tags">
          <text wx:if="{{dynastyInfo}}" class="h-tag" style="background:{{dynastyInfo.color}}22;color:{{dynastyInfo.color}};">{{dynastyInfo.name}}</text>
          <text wx:if="{{figure.era}}" class="h-tag h-tag-plain">{{figure.era}}</text>
        </view>
        <view class="h-lifespan" wx:if="{{figure.birth || figure.death}}">
          {{figure.birth || '?'}} — {{figure.death || '?'}}
        </view>
      </view>
    </view>
  </view>

  <view class="action-bar">
    <view class="a-btn a-primary" bindtap="startChat">
      <text class="iconfont a-btn-icon icon-chat"></text>
      <text class="a-btn-text">开始聊天</text>
    </view>
    <view class="a-btn a-ancient" bindtap="sendLetter">
      <text class="iconfont a-btn-icon icon-mail"></text>
      <text class="a-btn-text">飞鸽传书</text>
    </view>
  </view>

  <view class="sub-tabs">
    <view class="st {{tab === 'bio' ? 'is-active' : ''}}" data-tab="bio" bindtap="switchTab">生平简介</view>
    <view class="st {{tab === 'works' ? 'is-active' : ''}}" data-tab="works" bindtap="switchTab">相关内容</view>
    <view class="st {{tab === 'videos' ? 'is-active' : ''}}" data-tab="videos" bindtap="switchTab">视频号</view>
  </view>

  <view class="tab-body">
    <block wx:if="{{tab === 'bio'}}">
      <view class="section-card">
        <view class="card-title">人物生平</view>
        <text class="card-text">{{figure.bio}}</text>
      </view>
    </block>

    <block wx:elif="{{tab === 'works'}}">
      <view wx:if="{{figure.relations && figure.relations.length}}" class="section-card">
        <view class="card-title">人物关系</view>
        <view class="relations-list">
          <view wx:for="{{figure.relations}}" wx:key="index" class="relation-item">
            <view class="rel-name">{{item.name || item.targetName}}</view>
            <view class="rel-type">{{item.relation || item.type}}</view>
          </view>
        </view>
      </view>

      <view wx:if="{{figure.masterpieces && figure.masterpieces.length}}" class="section-card">
        <view class="card-title">主要著作</view>
        <view
          wx:for="{{figure.masterpieces}}"
          wx:key="*this"
          class="work-item"
        ><text class="iconfont icon-content"></text> {{item}}</view>
      </view>

      <view wx:if="{{figure.famousQuotes && figure.famousQuotes.length}}" class="section-card ancient-paper">
        <view class="card-title">千古名言</view>
        <view
          wx:for="{{figure.famousQuotes}}"
          wx:key="*this"
          class="quote-item"
        >
          <text class="quote-mark">「</text>
          <text class="quote-text">{{item}}</text>
          <text class="quote-mark">」</text>
        </view>
      </view>

      <view wx:if="{{figure.relatedBooks && figure.relatedBooks.length}}" class="section-card">
        <view class="card-title">相关典籍</view>
        <view
          wx:for="{{figure.relatedBooks}}"
          wx:key="id"
          class="rel-item"
          data-id="{{item.id}}"
          bindtap="goBookReader"
        >
          <view class="rel-cover">{{item.title}}</view>
          <view class="rel-meta">
            <text class="rel-title">{{item.title}}</text>
            <text class="rel-ch">{{item.chapter}}</text>
          </view>
          <text class="rel-arrow">›</text>
        </view>
      </view>

      <view wx:if="{{figure.relatedMoments && figure.relatedMoments.length}}" class="section-card">
        <view class="card-title">历史瞬间</view>
        <view
          wx:for="{{figure.relatedMoments}}"
          wx:key="_id"
          class="rel-m-item"
          data-id="{{item._id}}"
          bindtap="goMoment"
        >
          <view class="rm-head">
            <text class="rm-title">{{item.title}}</text>
            <text class="rm-time">{{item.time}}</text>
          </view>
          <text class="rm-desc">{{item.desc}}</text>
          <text class="rm-who">— 关联：{{item.figureName}}</text>
        </view>
      </view>

      <view wx:if="{{relatedArticles.length}}" class="section-card">
        <view class="card-title">相关文章 · 看一看</view>
        <view class="related-articles-list">
          <article-card
            wx:for="{{relatedArticles}}"
            wx:key="_id"
            article="{{item}}"
            bindtap="goArticleDetail"
          />
        </view>
      </view>

      <view wx:if="{{(!figure.masterpieces || !figure.masterpieces.length) && (!figure.famousQuotes || !figure.famousQuotes.length) && (!figure.relatedBooks || !figure.relatedBooks.length) && (!figure.relatedMoments || !figure.relatedMoments.length) && (!relatedArticles || !relatedArticles.length)}}" class="empty-hint">
        暂无相关内容
      </view>
    </block>

    <block wx:elif="{{tab === 'videos'}}">
      <view wx:if="{{channelInfo}}">
        <view class="section-card channel-header">
          <image class="ch-avatar" src="{{channelInfo.avatar || '/images/icons/avatar.png'}}" mode="aspectFill"></image>
          <view class="ch-info">
            <view class="ch-name">{{channelInfo.figureName}}
              <text wx:if="{{channelInfo.figureTitle}}" class="ch-title">· {{channelInfo.figureTitle}}</text>
            </view>
            <view class="ch-bio" wx:if="{{channelInfo.bio}}">{{channelInfo.bio}}</view>
            <view class="ch-stats">
              <text>{{channelInfo.videoCount || 0}}作品</text>
              <text class="dot">·</text>
              <text>{{channelInfo.followerCount || 0}}粉丝</text>
            </view>
          </view>
          <view class="ch-follow {{channelInfo.followed ? 'followed' : ''}}" bindtap="onChannelFollow">
            {{channelInfo.followed ? '已关注' : '+关注'}}
          </view>
        </view>

        <view wx:if="{{channelVideos && channelVideos.length > 0}}" class="video-grid">
          <view
            wx:for="{{channelVideos}}"
            wx:key="_id"
            class="video-grid-item"
            bindtap="goVideoDetail"
            data-id="{{item._id}}"
          >
            <view class="vg-cover">
              <image wx:if="{{item.coverUrl}}" class="vg-img" src="{{item.coverUrl}}" mode="aspectFill"></image>
              <view wx:else class="vg-placeholder">
                <text class="vg-title">{{item.title}}</text>
              </view>
              <view class="vg-duration" wx:if="{{item.duration}}">{{item.duration}}"</view>
              <view class="vg-play-icon">
                <text class="iconfont icon-play"></text>
              </view>
            </view>
            <text class="vg-text">{{item.title}}</text>
            <text class="vg-stats"><text class="iconfont icon-good"></text> {{item.likeCount || 0}}</text>
          </view>
        </view>

        <view wx:else class="empty-card">
          <text class="empty-icon iconfont icon-play"></text>
          <text class="empty-text">暂无视频</text>
        </view>
      </view>

      <view wx:else class="empty-card">
        <text class="empty-icon iconfont icon-play"></text>
        <text class="empty-text">暂无视频号</text>
        <text class="empty-desc">该人物尚未开通视频号</text>
      </view>
    </block>
  </view>

  <view class="bottom-pad"></view>
</view>
