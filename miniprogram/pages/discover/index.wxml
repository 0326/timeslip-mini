<custom-nav-bar
  title="发现"
  showBack="{{false}}"
  bgColor="#ededed"
></custom-nav-bar>

<view class="discover-page">
  <view
    wx:for="{{groups}}"
    wx:key="index"
    class="group"
  >
    <view
      wx:for="{{item.items}}"
      wx:for-item="entry"
      wx:key="key"
      class="entry"
      data-url="{{entry.url}}"
      data-name="{{entry.name}}"
      bindtap="onItemTap"
      hover-class="entry-hover"
    >
      <text class="entry-icon">{{entry.icon}}</text>
      <text class="entry-name">{{entry.name}}</text>
      <text class="entry-arrow">›</text>
    </view>
  </view>
  <view class="bottom-pad"></view>
</view>
