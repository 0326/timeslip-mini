.moments-page {
  min-height: 100vh;
  background: #EDEDED;
}

.refreshing-tip {
  text-align: center;
  padding: 20rpx;
  font-size: 24rpx;
  color: var(--wechat-text2);
}

.moment-block {
  background: #fff;
  padding: 24rpx;
  margin-bottom: 16rpx;
}

.m-header {
  display: flex;
  align-items: flex-start;
  margin-bottom: 16rpx;
}

.mh-info {
  flex: 1;
  margin-left: 16rpx;
  overflow: hidden;
}

.mh-name-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  margin-bottom: 6rpx;
}

.mh-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--wechat-blue);
}

.mh-title {
  font-size: 24rpx;
  color: var(--wechat-text2);
  margin-left: 4rpx;
}

.mh-meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8rpx;
}

.mh-time {
  font-size: 22rpx;
  color: var(--wechat-text2);
}

.mh-dy {
  font-size: 20rpx;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  font-weight: 500;
}

.mh-event {
  font-size: 22rpx;
  color: var(--ancient-gold);
}

.m-content {
  margin-bottom: 16rpx;
}

.mc-text {
  font-size: 30rpx;
  color: #191919;
  line-height: 1.6;
  white-space: pre-line;
}

.m-stats {
  display: flex;
  border-top: 1rpx solid #f5f5f5;
  padding-top: 16rpx;
  margin-bottom: 8rpx;
}

.stat-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 12rpx 0;
  border-radius: 8rpx;
  transition: background 0.15s;
}

.stat-item:active {
  background: #f8f8f8;
}

.stat-icon {
  font-size: 32rpx;
  margin-right: 8rpx;
}

.stat-num {
  font-size: 26rpx;
  color: var(--wechat-text2);
}

.m-likes {
  background: #f7f7f7;
  padding: 12rpx 16rpx;
  border-radius: 8rpx;
  margin: 8rpx 0;
}

.like-icon-row {
  font-size: 24rpx;
  color: var(--wechat-blue);
  line-height: 1.5;
}

.like-name {
  margin-right: 12rpx;
}

.m-comments {
  background: #f7f7f7;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  margin: 8rpx 0 0;
}

.cm-item {
  padding: 8rpx 0;
  font-size: 26rpx;
  line-height: 1.5;
}

.cm-name {
  color: var(--wechat-blue);
  font-weight: 500;
}

.cm-content {
  color: #191919;
}

.cm-more {
  font-size: 24rpx;
  color: var(--wechat-blue);
  padding: 8rpx 0 4rpx;
}

.empty-moments {
  padding: 180rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  background: #fff;
  margin: 16rpx;
  border-radius: 20rpx;
}

.em-icon {
  font-size: 80rpx;
  opacity: 0.3;
  margin-bottom: 16rpx;
}

.em-text {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 8rpx;
}

.em-sub {
  font-size: 24rpx;
  color: #bbb;
}

.load-more {
  text-align: center;
  padding: 24rpx;
  font-size: 24rpx;
  color: var(--wechat-text2);
}

.load-more.is-end {
  color: #ccc;
}

.bottom-pad {
  height: calc(40rpx + env(safe-area-inset-bottom));
}
