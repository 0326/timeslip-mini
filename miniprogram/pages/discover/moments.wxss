.moments-page {
  min-height: 100vh;
  position: relative;
}

/* ========== 封面区域 - 沉浸式 ========== */
.cover-area {
  position: relative;
  width: 100%;
  height: 620rpx;
  overflow: visible;
}

.cover-nav-placeholder {
  width: 100%;
  pointer-events: none;
}

.cover-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  display: block;
}

.cover-bg-fallback {
  background-size: cover;
  background-position: center;
}

/* 用户信息区域 - 头像一半在图内一半在图外 */
.cover-user {
  position: absolute;
  right: 32rpx;
  bottom: -70rpx;
  display: flex;
  align-items: flex-end;
  z-index: 10;
}

.cover-user-info {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  margin-right: 24rpx;
  margin-bottom: 20rpx;
}

.cover-name {
  color: #333;
  font-size: 36rpx;
  font-weight: 700;
  text-shadow: 0 2rpx 8rpx rgba(255, 255, 255, 0.9), 0 0 20rpx rgba(255, 255, 255, 0.5);
  max-width: 320rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  margin-bottom: 12rpx;
}

/* 朝代选择器 - 纯文字+下拉箭头，无标签框 */
.dynasty-picker-wrap {
  /* display: inline-block; */
  visibility: hidden;
  position: relative;
  z-index: 100;
}

.dynasty-picker {
  display: inline-flex;
  align-items: center;
  padding: 12rpx 8rpx;
  margin: -12rpx -8rpx;
}

.dp-text {
  font-size: 26rpx;
  color: #576B95;
  font-weight: 500;
  text-shadow: 0 1rpx 4rpx rgba(255, 255, 255, 0.8);
}

.dp-arrow {
  font-size: 22rpx;
  color: #576B95;
  margin-left: 6rpx;
  margin-top: -2rpx;
  text-shadow: 0 1rpx 4rpx rgba(255, 255, 255, 0.8);
}

.cover-avatar-wrap {
  width: 140rpx;
  height: 140rpx;
  flex-shrink: 0;
  position: relative;
  z-index: 2;
}

/* ========== 状态区域 ========== */
.state-wrap {
  padding: 100rpx 32rpx 120rpx;
}

.skeleton-list {
  display: flex;
  flex-direction: column;
  gap: 48rpx;
}

.skeleton-item {
  display: flex;
  gap: 20rpx;
}

.sk-avatar {
  width: 84rpx;
  height: 84rpx;
  border-radius: 12rpx;
  background: linear-gradient(90deg, #eee 0%, #f5f5f5 50%, #eee 100%);
  animation: sk-shine 1.2s ease-in-out infinite;
  background-size: 200% 100%;
  flex-shrink: 0;
}

.sk-body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.sk-line {
  height: 28rpx;
  border-radius: 6rpx;
  background: linear-gradient(90deg, #eee 0%, #f5f5f5 50%, #eee 100%);
  animation: sk-shine 1.2s ease-in-out infinite;
  background-size: 200% 100%;
}

.sk-name { width: 160rpx; }
.sk-c1 { width: 90%; }
.sk-c2 { width: 75%; }
.sk-c3 { width: 50%; }

@keyframes sk-shine {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}

.error-box, .empty-box {
  background: #fff;
  border-radius: 20rpx;
  padding: 80rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.error-icon, .empty-icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
  opacity: 0.4;
}

.error-text, .empty-text {
  font-size: 30rpx;
  color: #444;
  margin-bottom: 8rpx;
}

.error-sub, .empty-sub {
  font-size: 24rpx;
  color: #aaa;
  margin-bottom: 32rpx;
}

.error-btn {
  background: #576B95 !important;
  color: #fff !important;
  padding: 0 48rpx !important;
  height: 72rpx !important;
  line-height: 72rpx !important;
  border-radius: 999rpx !important;
  font-size: 28rpx !important;
  border: none !important;
}
.error-btn::after { border: none; }

/* ========== 朋友圈列表 ========== */
.moments-list {
  padding-top: 100rpx;
}

.moment-item {
  display: flex;
  padding: 24rpx 24rpx 32rpx;
  position: relative;
  background: #fff;
  margin-bottom: 12rpx;
  transition: background 0.1s;
}

.moment-item:active {
  background: #fafafa;
}

.mi-avatar {
  width: 84rpx;
  height: 84rpx;
  flex-shrink: 0;
  margin-right: 20rpx;
}

.mi-body {
  flex: 1;
  min-width: 0;
}

.mi-name-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 8rpx;
  flex-wrap: wrap;
}

.mi-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #576B95;
  line-height: 1.3;
}

.mi-title {
  font-size: 24rpx;
  color: #888;
}

.mi-content-wrap {
  margin-bottom: 14rpx;
}

.mi-content {
  font-size: 30rpx;
  color: #191919;
  line-height: 1.5;
  white-space: pre-line;
  word-wrap: break-word;
  word-break: break-all;
  overflow: hidden;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 6;
  position: relative;
}

.mi-content.is-expand {
  -webkit-line-clamp: 999;
  overflow: visible;
  display: block;
}

.expand-toggle {
  margin-top: 8rpx;
  line-height: 1.4;
}

.et-text {
  font-size: 28rpx;
  color: #576B95;
  display: inline-block;
  padding: 2rpx 0;
}

.mi-images {
  display: grid;
  gap: 8rpx;
  margin-bottom: 14rpx;
}

.mi-img {
  background: #f2f2f2;
  color: transparent;
}

.mi-grid-1 {
  grid-template-columns: minmax(0, 1fr);
  max-width: 480rpx;
}
.mi-grid-1 .mi-img {
  width: 100%;
  height: auto;
  min-height: 200rpx;
  max-height: 480rpx;
  aspect-ratio: 4 / 3;
  object-fit: cover;
  border-radius: 8rpx;
}

.mi-grid-2 {
  grid-template-columns: repeat(2, minmax(0, 1fr));
  max-width: 440rpx;
}
.mi-grid-2 .mi-img {
  aspect-ratio: 1 / 1;
  border-radius: 6rpx;
}

.mi-grid-3 {
  grid-template-columns: repeat(3, minmax(0, 1fr));
  max-width: 520rpx;
}
.mi-grid-3 .mi-img {
  aspect-ratio: 1 / 1;
  border-radius: 6rpx;
}

.mi-grid-4 {
  grid-template-columns: repeat(2, minmax(0, 1fr));
  max-width: 440rpx;
}
.mi-grid-4 .mi-img {
  aspect-ratio: 1 / 1;
  border-radius: 6rpx;
}

.mi-grid-9 {
  grid-template-columns: repeat(3, minmax(0, 1fr));
  max-width: 520rpx;
}
.mi-grid-9 .mi-img {
  aspect-ratio: 1 / 1;
  border-radius: 6rpx;
}

.mi-img {
  width: 100%;
  height: 100%;
  display: block;
  background: #f0f0f0;
}

.mi-historical {
  display: flex;
  align-items: center;
  padding: 10rpx 14rpx;
  background: rgba(201, 162, 77, 0.08);
  border-radius: 10rpx;
  margin-bottom: 14rpx;
  gap: 10rpx;
  border-left: 4rpx solid rgba(201, 162, 77, 0.6);
}

.mih-dot {
  font-size: 26rpx;
  line-height: 1;
  flex-shrink: 0;
}

.mih-info {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  color: #8a6d2b;
  line-height: 1.4;
}

.mih-event {
  font-weight: 500;
}

.mi-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 8rpx;
  position: relative;
}

.mif-left {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  min-width: 0;
}

.mif-time {
  font-size: 24rpx;
  color: #999;
}

.mif-loc {
  font-size: 24rpx;
  color: #999;
}

.mif-pending {
  font-size: 22rpx;
  color: #bbb;
  margin-left: 8rpx;
}

.mif-actions {
  padding: 8rpx 4rpx;
  margin-right: -4rpx;
  position: relative;
}

.action-triple-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 40rpx;
  background: #F3F3F3;
  border-radius: 8rpx;
  transition: all 0.15s;
}

.action-triple-btn:active {
  background: #e8e8e8;
  transform: scale(0.96);
}

.action-triple-icon {
  font-size: 28rpx;
  color: #666;
  line-height: 1;
}

.action-menu {
  position: absolute;
  right: 64rpx;
  top: 50%;
  transform: translateY(-50%);
  background: #4C4C4C;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  padding: 0 4rpx;
  z-index: 100;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.25);
  animation: am-pop 0.14s ease-out;
}

@keyframes am-pop {
  from { opacity: 0; transform: translateY(-50%) scale(0.94); }
  to { opacity: 1; transform: translateY(-50%) scale(1); }
}

.am-arrow {
  position: absolute;
  right: -10rpx;
  top: 50%;
  transform: translateY(-50%) rotate(45deg);
  width: 18rpx;
  height: 18rpx;
  background: #4C4C4C;
  z-index: -1;
}

.am-item {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  color: #fff;
  transition: opacity 0.1s;
}

.am-item:active {
  opacity: 0.7;
}

.am-item.is-liked .ami-text {
  color: #fff;
}

.ami-icon {
  font-size: 28rpx;
  margin-right: 10rpx;
  line-height: 1;
  color: #fff;
}

.ami-icon.icon-goodfill {
  color: #FA5151;
}

.ami-text {
  font-size: 28rpx;
  line-height: 1;
}

.am-split {
  width: 1rpx;
  height: 32rpx;
  background: rgba(255, 255, 255, 0.22);
  margin: 0 4rpx;
}

.mi-bubble {
  background: #F7F7F7;
  border-radius: 8rpx;
  padding: 12rpx 16rpx;
  margin-top: 14rpx;
  position: relative;
}

.mi-bubble::before {
  content: '';
  position: absolute;
  top: -8rpx;
  right: 60rpx;
  width: 0;
  height: 0;
  border-left: 10rpx solid transparent;
  border-right: 10rpx solid transparent;
  border-bottom: 10rpx solid #F7F7F7;
}

.mb-likes {
  display: flex;
  align-items: flex-start;
  padding: 4rpx 0;
}

.mbl-heart {
  font-size: 26rpx;
  color: #576B95;
  margin-right: 8rpx;
  line-height: 1.55;
  flex-shrink: 0;
}

.mbl-names {
  font-size: 26rpx;
  color: #576B95;
  line-height: 1.55;
  flex: 1;
  min-width: 0;
}

.mbl-name {
  display: inline;
  margin-right: 2rpx;
}

.mbl-comma {
  display: inline;
  margin-right: 2rpx;
}

.mbl-more {
  display: inline;
}

.mb-divider {
  height: 1rpx;
  background: #DEDEDE;
  margin: 8rpx 0;
}

.mb-comments {
  padding: 4rpx 0;
  display: flex;
  flex-direction: column;
  gap: 2rpx;
}

.mbc-item {
  font-size: 26rpx;
  line-height: 1.6;
  padding: 2rpx 0;
  color: #191919;
  word-wrap: break-word;
  word-break: break-all;
}

.mbc-item:active {
  background: rgba(0, 0, 0, 0.03);
  border-radius: 4rpx;
}

.mbc-name {
  color: #576B95;
  display: inline;
}

.mbc-reply {
  color: #576B95;
  display: inline;
}

.mbc-colon {
  color: #576B95;
  display: inline;
}

.mbc-content {
  color: #191919;
  display: inline;
}

.mbc-more {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #576B95;
  padding: 4rpx 0;
}

.loading-tip {
  text-align: center;
  padding: 28rpx;
  font-size: 24rpx;
  color: #999;
}

.loading-tip.is-end {
  color: #ccc;
  padding: 32rpx 24rpx 40rpx;
}

.bottom-pad {
  height: calc(40rpx + env(safe-area-inset-bottom));
}

.cm-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.3);
  z-index: 998;
  animation: mask-fade 0.15s ease-out;
}

@keyframes mask-fade {
  from { opacity: 0; }
  to { opacity: 1; }
}

.cm-input-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  border-top: 1rpx solid #eee;
  z-index: 999;
  padding: 12rpx 20rpx calc(12rpx + env(safe-area-inset-bottom));
  transform: translateY(120%);
  transition: transform 0.2s ease-out;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.cm-input-bar.is-show {
  transform: translateY(0);
}

.cm-reply-hint {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 10rpx 12rpx;
  font-size: 24rpx;
  color: #666;
}

.cm-reply-name {
  color: #576B95;
  font-weight: 500;
}

.cm-cancel {
  color: #999;
  padding: 4rpx 8rpx;
}

.cm-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.cm-input {
  flex: 1;
  min-height: 72rpx;
  background: #f5f5f5;
  border-radius: 999rpx;
  padding: 0 28rpx;
  font-size: 28rpx;
  line-height: 72rpx;
}

.cm-send {
  height: 72rpx;
  padding: 0 32rpx;
  line-height: 72rpx;
  font-size: 28rpx;
  border-radius: 999rpx;
  color: #fff;
  background: #ccc;
  font-weight: 500;
  transition: all 0.15s;
}

.cm-send.is-active {
  background: #07C160;
}

.cm-send:active {
  transform: scale(0.96);
}
