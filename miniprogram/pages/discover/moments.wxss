.moments-page {
  min-height: 100vh;
  background: #EDEDED;
}

.nav-camera {
  padding: 0 16rpx;
  height: 100%;
  display: flex;
  align-items: center;
}

.camera-icon {
  font-size: 40rpx;
  line-height: 1;
}

.cover-area {
  position: relative;
  width: 100%;
  height: 600rpx;
  overflow: hidden;
}

.cover-bg {
  width: 100%;
  height: 100%;
  display: block;
}

.cover-user {
  position: absolute;
  right: 24rpx;
  bottom: -50rpx;
  display: flex;
  align-items: flex-end;
  z-index: 10;
}

.cover-name {
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  margin-right: 24rpx;
  margin-bottom: 60rpx;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.3);
  max-width: 300rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.cover-avatar {
  width: 140rpx;
  height: 140rpx;
  border-radius: 12rpx;
  border: 4rpx solid #fff;
  background: #fff;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.15);
}

.refreshing-tip {
  text-align: center;
  padding: 20rpx;
  font-size: 24rpx;
  color: #888;
}

.moments-list {
  padding-top: 70rpx;
}

.moment-item {
  display: flex;
  padding: 20rpx 24rpx 24rpx;
  position: relative;
}

.mi-avatar {
  width: 84rpx;
  height: 84rpx;
  border-radius: 10rpx;
  flex-shrink: 0;
  margin-right: 20rpx;
  background: #eee;
}

.mi-body {
  flex: 1;
  min-width: 0;
}

.mi-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #576B95;
  line-height: 1.3;
  margin-bottom: 8rpx;
}

.mi-content {
  margin-bottom: 12rpx;
}

.mic-text {
  font-size: 30rpx;
  color: #191919;
  line-height: 1.5;
  white-space: pre-line;
  word-wrap: break-word;
  word-break: break-all;
}

.mi-event {
  margin-bottom: 12rpx;
}

.mie-text {
  font-size: 24rpx;
  color: #C9A24D;
}

.mi-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 8rpx;
}

.mif-time {
  font-size: 24rpx;
  color: #888;
}

.mif-actions {
  padding: 8rpx 4rpx;
  margin-right: -4rpx;
}

.action-dots {
  width: 56rpx;
  height: 32rpx;
  background: #F3F3F3;
  border-radius: 6rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
}

.action-dots .dot {
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background: #888;
}

.mi-bubble {
  background: #F7F7F7;
  border-radius: 6rpx;
  padding: 12rpx 16rpx;
  margin-top: 12rpx;
  position: relative;
}

.mi-bubble::before {
  content: '';
  position: absolute;
  top: -8rpx;
  right: 40rpx;
  width: 0;
  height: 0;
  border-left: 10rpx solid transparent;
  border-right: 10rpx solid transparent;
  border-bottom: 10rpx solid #F7F7F7;
}

.mb-likes {
  display: flex;
  align-items: flex-start;
  padding: 4rpx 0;
}

.mbl-icon {
  font-size: 24rpx;
  color: #576B95;
  margin-right: 6rpx;
  line-height: 1.5;
  flex-shrink: 0;
}

.mbl-names {
  font-size: 26rpx;
  color: #576B95;
  line-height: 1.5;
  flex: 1;
}

.mbl-name {
  margin-right: 4rpx;
}

.mb-divider {
  height: 1rpx;
  background: #DEDEDE;
  margin: 6rpx 0;
}

.mb-comments {
  padding: 4rpx 0;
}

.mbc-item {
  font-size: 26rpx;
  line-height: 1.5;
  color: #191919;
  padding: 2rpx 0;
  word-wrap: break-word;
  word-break: break-all;
}

.mbc-name {
  color: #576B95;
}

.mbc-colon {
  color: #576B95;
}

.mbc-content {
  color: #191919;
}

.action-menu {
  position: absolute;
  right: 40rpx;
  top: 90rpx;
  background: #4C4C4C;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  padding: 0 4rpx;
  z-index: 100;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.2);
}

.action-menu::after {
  content: '';
  position: absolute;
  right: -6rpx;
  top: 50%;
  transform: translateY(-50%) rotate(45deg);
  width: 14rpx;
  height: 14rpx;
  background: #4C4C4C;
  z-index: -1;
}

.am-item {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  color: #fff;
}

.am-item:active {
  opacity: 0.7;
}

.ami-icon {
  font-size: 28rpx;
  margin-right: 8rpx;
  line-height: 1;
}

.ami-text {
  font-size: 28rpx;
  line-height: 1;
}

.am-split {
  width: 1rpx;
  height: 32rpx;
  background: rgba(255, 255, 255, 0.2);
  margin: 0 4rpx;
}

.empty-moments {
  padding: 180rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  background: #fff;
  margin: 16rpx;
  border-radius: 20rpx;
}

.em-icon {
  font-size: 80rpx;
  opacity: 0.3;
  margin-bottom: 16rpx;
}

.em-text {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 8rpx;
}

.em-sub {
  font-size: 24rpx;
  color: #bbb;
}

.load-more {
  text-align: center;
  padding: 24rpx;
  font-size: 24rpx;
  color: #888;
}

.load-more.is-end {
  color: #ccc;
}

.bottom-pad {
  height: calc(40rpx + env(safe-area-inset-bottom));
}
