.bookmarks-page {
  min-height: 100vh;
  background: #F7F6F3;
  padding-bottom: 40rpx;
}

/* 双列瀑布流 */
.feeds-grid {
  display: flex;
  padding: 16rpx 12rpx;
  gap: 8rpx;
}

.feeds-column {
  flex: 1;
  min-width: 0;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 160rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 32rpx;
  color: #666;
  margin-bottom: 8rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #aaa;
  margin-bottom: 32rpx;
}

.go-look {
  padding: 20rpx 64rpx;
  background: #1890FF;
  color: #fff;
  font-size: 28rpx;
  border-radius: 999rpx;
}

.no-more {
  text-align: center;
  padding: 32rpx;
  color: #ccc;
  font-size: 24rpx;
}
