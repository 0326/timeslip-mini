<custom-nav-bar title="看一看" showBack="{{true}}" showHome="{{true}}" />

<loading-skeleton wx:if="{{loading}}" count="4" />

<view wx:elif="{{article}}" class="detail-page">
  <view class="article-cover" wx:if="{{article.coverImage}}">
    <image src="{{article.coverImage}}" mode="aspectFill" lazy-load />
  </view>

  <view class="article-header">
    <view class="ah-title">{{article.title}}</view>
    <view class="ah-subtitle" wx:if="{{article.subtitle}}">{{article.subtitle}}</view>
    <view class="ah-meta">
      <text class="ah-cat">{{article.categoryName}}</text>
      <text class="ah-dot" wx:if="{{article.dynastyName}}">·</text>
      <text class="ah-dynasty" wx:if="{{article.dynastyName}}">{{article.dynastyName}}</text>
      <text class="ah-dot">·</text>
      <text class="ah-author">{{article.author}}</text>
    </view>
    <view class="ah-stats">
      <text>👁 {{article.viewText}} 阅读</text>
    </view>
  </view>

  <view class="divider"></view>

  <article-content content="{{content}}" bind:figuretap="onFigureTap" />

  <view wx:if="{{article.poll}}" class="poll-section">
    <poll-widget
      poll="{{article.poll}}"
      voted="{{pollVoted}}"
      results="{{pollResults}}"
      bind:vote="onVote"
    />
  </view>

  <view class="divider"></view>

  <view wx:if="{{relatedArticles.length}}" class="related-section">
    <view class="rs-title">相关文章</view>
    <article-card
      wx:for="{{relatedArticles}}"
      wx:key="_id"
      article="{{item}}"
      bindtap="openRelated"
    />
  </view>

  <view class="bottom-pad"></view>
</view>

<view wx:else class="empty-state">
  <text class="empty-icon">📜</text>
  <text class="empty-text">文章不存在</text>
</view>

<view wx:if="{{article}}" class="bottom-bar">
  <view class="bb-btn {{liked ? 'active' : ''}}" bindtap="onLike">
    <text class="bb-icon">{{liked ? '❤️' : '🤍'}}</text>
    <text class="bb-text">{{article.likeText}}</text>
  </view>
  <view class="bb-btn {{bookmarked ? 'active' : ''}}" bindtap="onBookmark">
    <text class="bb-icon">{{bookmarked ? '📑' : '📄'}}</text>
    <text class="bb-text">收藏</text>
  </view>
  <view class="bb-btn" bindtap="onComment">
    <text class="bb-icon">💬</text>
    <text class="bb-text">{{article.commentCount || 0}}</text>
  </view>
</view>
