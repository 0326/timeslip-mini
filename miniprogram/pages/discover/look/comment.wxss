.comment-page {
  min-height: 100vh;
  background: #FFF9F0;
  padding-bottom: 180rpx;
}

.comment-count-bar {
  padding: 24rpx 32rpx 16rpx;
}

.cc-text {
  font-size: 26rpx;
  color: #999;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 200rpx 0;
  background: #FFF9F0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 32rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #bbb;
}

.comment-list {
  padding: 0 32rpx;
}

.comment-item {
  display: flex;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #F0E8D8;
}

.ci-avatar {
  flex-shrink: 0;
  width: 72rpx;
  height: 72rpx;
  margin-right: 20rpx;
  border-radius: 50%;
  overflow: hidden;
  background: #E8E0D0;
}

.ci-avatar-img {
  width: 100%;
  height: 100%;
}

.ci-avatar-fallback {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #999;
  background: #E8E0D0;
}

.ci-body {
  flex: 1;
  min-width: 0;
}

.ci-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.ci-name {
  font-size: 26rpx;
  font-weight: 500;
  color: #576B95;
}

.ci-time {
  font-size: 22rpx;
  color: #bbb;
}

.ci-reply-hint {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.ci-content {
  font-size: 30rpx;
  color: #1A1A1A;
  line-height: 1.6;
  word-break: break-all;
}

.ci-footer {
  display: flex;
  justify-content: flex-end;
  margin-top: 12rpx;
}

.ci-reply-btn {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #888;
  padding: 8rpx 20rpx;
  border-radius: 8rpx;
  background: #F5F0E5;
}

.ci-reply-icon {
  margin-right: 6rpx;
  font-size: 22rpx;
}

.loading-more {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx 0;
  font-size: 24rpx;
  color: #999;
}

.spinner-small {
  width: 32rpx;
  height: 32rpx;
  border: 4rpx solid #E8E0D0;
  border-top-color: #C9A24D;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-right: 12rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.no-more {
  text-align: center;
  padding: 24rpx 0;
  font-size: 24rpx;
  color: #ccc;
}

.bottom-pad {
  height: 40rpx;
}

.input-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  border-top: 1rpx solid #eee;
  z-index: 100;
  transition: padding-bottom 0.2s ease;
}

.reply-hint {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 32rpx;
  background: #F7F6F3;
  border-bottom: 1rpx solid #eee;
}

.rh-text {
  font-size: 24rpx;
  color: #999;
}

.rh-cancel {
  font-size: 28rpx;
  color: #999;
  padding: 0 8rpx;
}

.ib-inner {
  display: flex;
  align-items: flex-end;
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
}

.ib-input {
  flex: 1;
  min-height: 64rpx;
  max-height: 200rpx;
  padding: 12rpx 20rpx;
  background: #F5F5F5;
  border-radius: 12rpx;
  font-size: 28rpx;
  line-height: 1.5;
  color: #333;
}

.ib-placeholder {
  color: #bbb;
  font-size: 28rpx;
}

.ib-send {
  flex-shrink: 0;
  margin-left: 16rpx;
  padding: 14rpx 36rpx;
  background: #E0E0E0;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #999;
  transition: all 0.2s;
}

.ib-send.active {
  background: #1890FF;
  color: #fff;
}

.ib-send.active:active {
  opacity: 0.8;
}
