.look-page {
  min-height: 100vh;
  background: #F7F6F3;
  padding-bottom: 40rpx;
}

.category-bar {
  position: sticky;
  top: 0;
  z-index: 10;
  white-space: nowrap;
  background: #FFFFFF;
  padding: 16rpx 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.cat-item {
  display: inline-block;
  padding: 12rpx 32rpx;
  margin-right: 16rpx;
  font-size: 28rpx;
  color: #666;
  background: #f5f5f5;
  border-radius: 999rpx;
  transition: all 0.2s;
}

.cat-item.active {
  color: #fff;
  background: #1890FF;
  font-weight: 500;
}

/* 双列瀑布流 */
.feeds-grid {
  display: flex;
  padding: 16rpx 12rpx;
  gap: 8rpx;
}

.feeds-column {
  flex: 1;
  min-width: 0;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 32rpx;
  color: #666;
  margin-bottom: 8rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #aaa;
}

.loading-more {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
  color: #999;
  font-size: 26rpx;
}

.spinner-small {
  width: 32rpx;
  height: 32rpx;
  border: 4rpx solid #e0e0e0;
  border-top-color: #1890FF;
  border-radius: 50%;
  margin-right: 16rpx;
  animation: spin 0.6s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.no-more {
  text-align: center;
  padding: 32rpx;
  color: #ccc;
  font-size: 24rpx;
}
