.detail-page {
  min-height: 100vh;
  background: #FFF9F0;
  padding-bottom: 140rpx;
}

.article-cover {
  width: 100%;
  height: 400rpx;
  overflow: hidden;
  background: #f0f0f0;
}

.article-cover image {
  width: 100%;
  height: 100%;
}

.article-header {
  padding: 32rpx;
}

.ah-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #1A1A1A;
  line-height: 1.4;
  margin-bottom: 16rpx;
}

.ah-subtitle {
  font-size: 28rpx;
  color: #888;
  line-height: 1.5;
  margin-bottom: 24rpx;
}

.ah-meta {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.ah-cat {
  color: #1890FF;
  font-weight: 500;
}

.ah-dot {
  margin: 0 12rpx;
}

.ah-stats {
  font-size: 24rpx;
  color: #aaa;
  margin-top: 8rpx;
}

.divider {
  height: 1rpx;
  background: #E8E0D0;
  margin: 0 32rpx;
}

.poll-section {
  padding: 0 32rpx;
}

.related-section {
  padding: 32rpx;
}

.rs-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 24rpx;
}

.bottom-pad {
  height: 40rpx;
}

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  justify-content: space-around;
  height: 120rpx;
  background: #fff;
  border-top: 1rpx solid #eee;
  box-shadow: 0 -4rpx 16rpx rgba(0,0,0,0.05);
  padding-bottom: env(safe-area-inset-bottom);
  z-index: 100;
}

.bb-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 48rpx;
  border-radius: 12rpx;
  transition: all 0.2s;
}

.bb-btn.active {
  background: #FFF0F0;
}

.bb-icon {
  font-size: 40rpx;
  margin-bottom: 4rpx;
}

.bb-text {
  font-size: 22rpx;
  color: #666;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 200rpx 0;
  background: #FFF9F0;
  min-height: 100vh;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 32rpx;
  color: #999;
}
