/* ===== 沉浸式浮动导航 ===== */
.immersive-nav {
  position: fixed;
  top: 0;
  left: 0;
  z-index: 200;
  display: flex;
  align-items: center;
  padding-left: 24rpx;
}

.nav-back-btn {
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.3);
  backdrop-filter: blur(8rpx);
  -webkit-backdrop-filter: blur(8rpx);
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-back-btn .iconfont {
  font-size: 32rpx;
  color: #fff;
}

.nav-back-hover {
  background: rgba(0, 0, 0, 0.5) !important;
}

/* ===== 骨架屏 ===== */
.detail-skeleton {
  min-height: 100vh;
  background: #FFF9F0;
}

.sk-cover {
  width: 100%;
  /* 3:4 比例，全宽 750rpx 对应高度 1000rpx */
  height: 1000rpx;
  background: #E8E0D0;
}

.sk-body {
  padding: 32rpx;
}

.sk-shimmer {
  background: linear-gradient(
    90deg,
    #F0EBE0 25%,
    #E8E0D0 37%,
    #F0EBE0 63%
  );
  background-size: 400% 100%;
  animation: sk-shine 1.4s ease infinite;
}

@keyframes sk-shine {
  0% { background-position: 100% 50%; }
  100% { background-position: 0 50%; }
}

.sk-line {
  border-radius: 8rpx;
  margin-bottom: 20rpx;
}

.sk-title {
  width: 70%;
  height: 44rpx;
  margin-bottom: 24rpx;
}

.sk-sub {
  width: 50%;
  height: 28rpx;
  margin-bottom: 28rpx;
}

.sk-meta {
  width: 60%;
  height: 24rpx;
  margin-bottom: 24rpx;
}

.sk-divider-line {
  height: 1rpx;
  background: #E8E0D0;
  margin: 0 0 32rpx 0;
}

.sk-para {
  width: 100%;
  height: 28rpx;
}

.sk-para-90 {
  width: 90%;
  height: 28rpx;
}

.sk-para-80 {
  width: 80%;
  height: 28rpx;
}

/* ===== 文章详情 ===== */
.detail-page {
  min-height: 100vh;
  background: #FFF9F0;
  padding-bottom: 140rpx;
}

.article-cover {
  width: 100%;
  /* 3:4 比例，与骨架屏一致，避免图片加载导致抖动 */
  height: 1000rpx;
  overflow: hidden;
  background: #E8E0D0;
}

.article-cover image {
  width: 100%;
  height: 100%;
  display: block;
}

.article-header {
  padding: 32rpx;
}

.ah-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #1A1A1A;
  line-height: 1.4;
  margin-bottom: 16rpx;
}

.ah-subtitle {
  font-size: 28rpx;
  color: #888;
  line-height: 1.5;
  margin-bottom: 24rpx;
}

.ah-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 24rpx;
  color: #999;
}

.ah-meta-left {
  display: flex;
  align-items: center;
}

.ah-meta-right {
  display: flex;
  align-items: center;
}

.ah-cat {
  color: #1890FF;
  font-weight: 500;
}

.ah-dot {
  margin: 0 12rpx;
}

.ah-eye-icon {
  font-size: 26rpx;
  margin-right: 6rpx;
}

.divider {
  height: 1rpx;
  background: #E8E0D0;
  margin: 0 32rpx 32rpx 32rpx;
}

.poll-section {
  padding: 0 32rpx;
}

.bottom-pad {
  height: 40rpx;
}

/* ===== 底部操作栏 ===== */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  height: 110rpx;
  background: #fff;
  border-top: 1rpx solid #eee;
  box-shadow: 0 -4rpx 20rpx rgba(0,0,0,0.06);
  padding-bottom: env(safe-area-inset-bottom);
  z-index: 100;
}

.bb-btn {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 110rpx;
  padding: 0;
  margin: 0;
  box-sizing: border-box;
  transition: all 0.2s;
}

.bb-btn:active {
  transform: scale(0.92);
  opacity: 0.8;
}

.bb-icon {
  font-family: "iconfont" !important;
  font-size: 40rpx;
  line-height: 1;
  height: 40rpx;
  margin-bottom: 8rpx;
  color: #999;
  transition: color 0.2s;
}

.bb-icon.liked {
  color: #FA5151;
}

.bb-icon.bookmarked {
  color: #C9A24D;
}

.bb-text {
  font-size: 22rpx;
  line-height: 1;
  height: 22rpx;
  color: #888;
  transition: color 0.2s;
}

.bb-text.liked-text {
  color: #FA5151;
}

.bb-text.bookmarked-text {
  color: #C9A24D;
}

/* 分享按钮 - 绿色 */
.share-btn {
  background: none;
  border: none;
  line-height: normal;
}

.share-btn::after {
  border: none;
}

.share-icon {
  color: #07C160;
}

.share-text {
  color: #07C160;
}

/* ===== 空状态 ===== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 200rpx 0;
  background: #FFF9F0;
  min-height: 100vh;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
  color: #ccc;
}

.empty-text {
  font-size: 32rpx;
  color: #999;
}
