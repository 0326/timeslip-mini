<custom-nav-bar
  title="{{navOpaque ? '朋友圈' : ''}}"
  showBack="{{true}}"
  bgColor="{{navBgColor}}"
  textColor="{{navTextColor}}"
  translucent="{{!navOpaque}}"
>
  <view slot="right" class="nav-camera" bindtap="onPublish">
    <text class="camera-icon">📷</text>
  </view>
</custom-nav-bar>

<view class="moments-page" bindtap="closeActionMenu">
  <view class="cover-area">
    <image class="cover-bg" src="https://trae-api-cn.mchost.guru/api/ide/v1/text_to_image?prompt=ancient%20chinese%20landscape%20painting%20mountains%20rivers%20misty%20ink%20wash%20style&image_size=landscape_16_9" mode="aspectFill"></image>
    <view class="cover-user">
      <view class="cover-name">{{userInfo.nickName || '穿越者'}}</view>
      <image class="cover-avatar" src="{{userInfo.avatarUrl || 'https://img.icons8.com/color/96/user-male-circle--v1.png'}}" mode="aspectFill"></image>
    </view>
  </view>

  <view wx:if="{{refreshing}}" class="refreshing-tip">刷新中...</view>

  <view wx:if="{{!loading && moments.length === 0}}" class="empty-moments">
    <text class="em-icon">📭</text>
    <text class="em-text">暂无历史朋友圈</text>
    <text class="em-sub">下拉刷新查看更多内容</text>
  </view>

  <view class="moments-list">
    <view
      wx:for="{{moments}}"
      wx:key="_id"
      class="moment-item"
    >
      <image class="mi-avatar" src="{{item.avatar || 'https://img.icons8.com/color/96/user-male-circle--v1.png'}}" mode="aspectFill"></image>

      <view class="mi-body">
        <view class="mi-name">{{item.figureName}}</view>

        <view class="mi-content" data-id="{{item._id}}" bindtap="openMomentDetail">
          <text class="mic-text">{{item.content}}</text>
        </view>

        <view wx:if="{{item.historicalEvent}}" class="mi-event">
          <text class="mie-text">{{item.historicalEvent}} · {{item.historicalDate}}</text>
        </view>

        <view class="mi-footer">
          <text class="mif-time">{{item.displayTime}}</text>
          <view class="mif-actions" catchtap="toggleActionMenu" data-id="{{item._id}}">
            <view class="action-dots">
              <view class="dot"></view>
              <view class="dot"></view>
            </view>
          </view>
        </view>

        <view wx:if="{{(item.likes && item.likes.length) || (item.comments && item.comments.length)}}" class="mi-bubble">
          <view wx:if="{{item.likes && item.likes.length}}" class="mb-likes">
            <text class="mbl-icon">♥</text>
            <text class="mbl-names">
              <block wx:for="{{item.likes}}" wx:for-item="l" wx:key="openid">
                <text class="mbl-name">{{l.name}}</text><text wx:if="{{index < item.likes.length - 1}}" class="mbl-comma">，</text>
              </block>
            </text>
          </view>
          <view wx:if="{{item.likes && item.likes.length && item.comments && item.comments.length}}" class="mb-divider"></view>
          <view wx:if="{{item.comments && item.comments.length}}" class="mb-comments">
            <view
              wx:for="{{item.comments}}"
              wx:for-item="c"
              wx:key="openid"
              class="mbc-item"
            >
              <text class="mbc-name">{{c.name}}</text>
              <text class="mbc-colon">：</text>
              <text class="mbc-content">{{c.content}}</text>
            </view>
          </view>
        </view>
      </view>

      <view wx:if="{{actionMenuId === item._id}}" class="action-menu" catchtap="stopPropagation">
        <view class="am-item" catchtap="onLike" data-id="{{item._id}}">
          <text class="ami-icon">{{item._liked ? '♥' : '♡'}}</text>
          <text class="ami-text">{{item._liked ? '取消' : '赞'}}</text>
        </view>
        <view class="am-split"></view>
        <view class="am-item" catchtap="openCommentInput" data-id="{{item._id}}">
          <text class="ami-icon">💬</text>
          <text class="ami-text">评论</text>
        </view>
      </view>
    </view>
  </view>

  <view wx:if="{{loading}}" class="load-more">加载中...</view>
  <view wx:elif="{{!hasMore && moments.length}}" class="load-more is-end">— 没有更多了 —</view>

  <view class="bottom-pad"></view>
</view>
