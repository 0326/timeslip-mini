<custom-nav-bar
  title="朋友圈"
  showBack="{{true}}"
  bgColor="#fff"
></custom-nav-bar>

<view class="moments-page">
  <view wx:if="{{refreshing}}" class="refreshing-tip">刷新中...</view>

  <view wx:if="{{!loading && moments.length === 0}}" class="empty-moments">
    <text class="em-icon">📭</text>
    <text class="em-text">暂无历史朋友圈</text>
    <text class="em-sub">下拉刷新查看更多内容</text>
  </view>

  <view
    wx:for="{{moments}}"
    wx:key="_id"
    class="moment-block"
  >
    <view class="m-header" data-id="{{item._id}}" bindtap="openMomentDetail">
      <figure-avatar figure="{{item}}" size="88" round="{{true}}"></figure-avatar>
      <view class="mh-info">
        <view class="mh-name-row">
          <text class="mh-name">{{item.figureName}}</text>
          <text wx:if="{{item.figureTitle}}" class="mh-title">· {{item.figureTitle}}</text>
        </view>
        <view class="mh-meta">
          <text class="mh-time">{{item.displayTime}}</text>
          <text wx:if="{{item.dynastyInfo}}" class="mh-dy" style="background:{{item.dynastyInfo.color}}15;color:{{item.dynastyInfo.color}};">{{item.dynastyInfo.name}}</text>
          <text wx:if="{{item.historicalEvent}}" class="mh-event">· {{item.historicalEvent}}</text>
        </view>
      </view>
    </view>

    <view class="m-content" data-id="{{item._id}}" bindtap="openMomentDetail">
      <text class="mc-text">{{item.content}}</text>
    </view>

    <view class="m-stats">
      <view class="stat-item" data-id="{{item._id}}" catchtap="onLike">
        <text class="stat-icon">{{item._liked ? '❤️' : '🤍'}}</text>
        <text class="stat-num">{{item.likeText}}</text>
      </view>
      <view class="stat-item" data-id="{{item._id}}" catchtap="openCommentInput">
        <text class="stat-icon">💬</text>
        <text class="stat-num">{{item.commentCount || 0}}</text>
      </view>
      <view class="stat-item" data-id="{{item._id}}" catchtap="openMomentDetail">
        <text class="stat-icon">🔍</text>
        <text class="stat-num">详情</text>
      </view>
    </view>

    <view wx:if="{{item.likes && item.likes.length}}" class="m-likes">
      <text class="like-icon-row">
        <text wx:for="{{item.likes}}" wx:for-item="l" wx:key="openid" class="like-name">{{l.name}}</text>
      </text>
    </view>

    <view wx:if="{{item.comments && item.comments.length}}" class="m-comments">
      <view
        wx:for="{{item.comments}}"
        wx:for-item="c"
        wx:key="openid"
        class="cm-item"
      >
        <text class="cm-name">{{c.name}}：</text>
        <text class="cm-content">{{c.content}}</text>
      </view>
      <view wx:if="{{item.commentCount > item.comments.length}}" class="cm-more" data-id="{{item._id}}" bindtap="openMomentDetail">
        查看全部{{item.commentCount}}条评论 ›
      </view>
    </view>
  </view>

  <view wx:if="{{loading}}" class="load-more">加载中...</view>
  <view wx:elif="{{!hasMore && moments.length}}" class="load-more is-end">— 没有更多了 —</view>

  <view class="bottom-pad"></view>
</view>
