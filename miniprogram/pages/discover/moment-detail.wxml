<custom-nav-bar title="朋友圈详情" show-back="{{true}}" bg-color="#ffffff" text-color="#191919" />

<view class="page">
  <view wx:if="{{initialLoading}}" class="initial-skeleton">
    <view class="sk-head">
      <view class="sk-avatar"></view>
      <view class="sk-head-col">
        <view class="sk-line lg"></view>
        <view class="sk-line md"></view>
      </view>
    </view>
    <view class="sk-block"></view>
    <view class="sk-grid">
      <view class="sk-item"></view><view class="sk-item"></view><view class="sk-item"></view>
    </view>
    <view class="sk-block sm"></view>
    <view class="sk-block sm"></view>
  </view>

  <view wx:elif="{{loadError}}" class="empty-wrap">
    <text class="empty-icon iconfont icon-content"></text>
    <text class="empty-title">内容加载失败</text>
    <text class="empty-desc">可能是网络波动或历史被改写了～</text>
    <button class="empty-btn" bindtap="onRetryLoad">重新加载</button>
  </view>

  <block wx:else>
    <view class="moment-hero">
      <figure-avatar
        wx:if="{{moment}}"
        class="hero-avatar"
        figure="{{moment.figure}}"
        size="xl"
        shape="circle"
        show-dynasty="{{true}}"
        bind:tap="onFigureTap"
        data-figureid="{{moment.figure && moment.figure.id}}"
      />
      <view
        class="hero-meta"
        wx:if="{{moment}}"
        catchtap="onFigureTap"
        data-figureid="{{moment.figure && moment.figure.id}}"
      >
        <text class="hero-name">{{moment.figure && moment.figure.name}}</text>
        <view class="hero-title-row" wx:if="{{moment.figure && moment.figure.title}}">
          <text class="hero-title">{{moment.figure.title}}</text>
          <text wx:if="{{moment.figure && moment.figure.dynasty}}" class="hero-dynasty">{{moment.figure.dynasty}}</text>
        </view>
        <text class="hero-time">{{moment.createdAtText}}</text>
      </view>
    </view>

    <view class="detail-body">
      <view wx:if="{{moment.content}}" class="moment-content">{{moment.content}}</view>

      <view
        wx:if="{{moment.images && moment.images.length}}"
        class="img-grid grid-type-{{moment.imageGridType}}"
      >
        <view
          wx:for="{{moment.images}}"
          wx:key="*this"
          wx:for-item="img"
          wx:for-index="i"
          class="img-cell img-type-{{moment.imageGridType}}"
          bindtap="onPreviewImage"
          data-idx="{{i}}"
        >
          <image class="img" src="{{img}}" mode="aspectFill" lazy-load binderror="onImageError" />
        </view>
      </view>

      <view class="foot-row">
        <text class="foot-source" wx:if="{{moment.sourceText}}">{{moment.sourceText}}</text>
        <text class="foot-date">{{moment.createdAtRelative}}</text>
      </view>

      <view class="bubble" wx:if="{{(moment.interaction && (moment.interaction.likePreview && moment.interaction.likePreview.length)) || comments.length}}">
        <view class="bubble-section like-section" wx:if="{{moment.interaction && moment.interaction.likePreview && moment.interaction.likePreview.length}}">
          <view class="bubble-row">
            <text class="iconfont bubble-icon icon-goodfill"></text>
            <view class="bubble-names">
              <block wx:for="{{moment.interaction.likePreview}}" wx:for-item="u" wx:key="id">
                <text class="name-link">{{u.name}}</text>
                <text wx:if="{{index < moment.interaction.likePreview.length - 1}}" class="name-sep">、</text>
              </block>
              <text wx:if="{{moment.interaction.likeCount > moment.interaction.likePreview.length}}" class="name-sep">等 {{moment.interaction.likeCount}} 人</text>
            </view>
          </view>
        </view>

        <view class="bubble-divider" wx:if="{{moment.interaction && moment.interaction.likePreview && moment.interaction.likePreview.length && comments.length}}"></view>

        <view class="bubble-section comment-section" wx:if="{{comments.length}}">
          <block wx:for="{{comments}}" wx:for-item="c" wx:key="_id">
            <view
              class="comment-item {{deletingCommentIds[c._id] ? 'deleting' : ''}}"
              data-id="{{c._id}}"
              data-replyto="{{c.figure && c.figure.id}}"
              data-replyname="{{c.figure && c.figure.name}}"
              bindtap="openCommentInput"
            >
              <view class="comment-main">
                <text
                  class="name-link reply-from"
                  catchtap="onFigureTap"
                  data-figureid="{{c.figure && c.figure.id}}"
                >{{c.figure && c.figure.name}}</text>
                <text wx:if="{{c.replyName}}" class="reply-prefix">回复</text>
                <text
                  wx:if="{{c.replyName}}"
                  class="name-link reply-to"
                  catchtap="onFigureTap"
                  data-figureid="{{c.replyTo}}"
                >{{c.replyName}}</text>
                <text wx:if="{{c.replyName}}" class="colon-sep">：</text>
                <text wx:else class="colon-sep">：</text>
                <text class="comment-text">{{c.content}}</text>
              </view>
              <view class="comment-right">
                <text class="comment-time">{{c.createdAtRelative}}</text>
                <view wx:if="{{c.canDelete}}" class="delete-trigger" catchtap="onDeleteComment" data-id="{{c._id}}">
                  <text class="delete-text">删除</text>
                </view>
              </view>
              <view wx:if="{{pendingCommentIds[c._id]}}" class="comment-badge">发布中...</view>
            </view>
          </block>
        </view>
      </view>

      <view class="action-bar">
        <view class="action-btn {{moment.interaction.liked ? 'active' : ''}}" bindtap="onLike">
          <text class="iconfont action-icon {{moment.interaction.liked ? 'icon-goodfill' : 'icon-good'}}"></text>
          <text class="action-label">{{moment.likeText}}</text>
        </view>

        <view class="action-btn" bindtap="openCommentInput">
          <text class="iconfont action-icon icon-chat"></text>
          <text class="action-label">{{moment.interaction.commentCount || ''}}</text>
        </view>

        <button class="action-btn share-btn" open-type="share">
          <text class="action-label">分享</text>
        </button>
      </view>
    </view>
  </block>

  <view class="comment-mask {{showInput ? 'show' : ''}}" bindtap="hideCommentInput"></view>
  <view class="comment-input-bar {{showInput ? 'show' : ''}}">
    <input
      class="comment-input"
      placeholder="{{replyName ? '回复 ' + replyName : '说点什么...'}}"
      placeholder-class="comment-input-placeholder"
      auto-focus="{{showInput}}"
      confirm-type="send"
      value="{{commentInput}}"
      bindinput="onCommentInput"
      bindconfirm="onSubmitComment"
      cursor-spacing="32"
      adjust-position="{{true}}"
      maxlength="1000"
    />
    <button
      class="comment-send {{commentInput ? 'active' : ''}} {{submitting ? 'loading' : ''}}"
      bindtap="onSubmitComment"
      disabled="{{!commentInput || submitting}}"
    >{{submitting ? '...' : '发送'}}</button>
  </view>
</view>
