.video-swiper {
  width: 100%;
  background: #000;
}

.loading-wrap,
.empty-wrap {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #000;
}

.spinner {
  width: 60rpx;
  height: 60rpx;
  border: 6rpx solid rgba(255, 255, 255, 0.2);
  border-top-color: #fff;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 20rpx;
}
@keyframes spin { to { transform: rotate(360deg); } }

.loading-text {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.6);
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 32rpx;
  color: #fff;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.5);
}

.video-item {
  position: relative;
  width: 100%;
  height: 100%;
  background: #000;
}

.video-player {
  width: 100%;
  height: 100%;
}

.pause-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 5;
  pointer-events: none;
}

.pause-icon {
  font-size: 120rpx;
  color: rgba(255, 255, 255, 0.8);
  text-shadow: 0 0 30rpx rgba(0, 0, 0, 0.5);
}

.video-placeholder {
  position: relative;
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
}

.cover-img {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.placeholder-bg {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  text-align: center;
}

.placeholder-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 20rpx;
}

.placeholder-desc {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.6);
}

.play-icon {
  position: absolute;
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  backdrop-filter: blur(10px);
}

.play-icon .iconfont {
  font-size: 48rpx;
  color: #fff;
  margin-left: 6rpx;
}

.video-overlay {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  top: 180rpx;
  background: linear-gradient(transparent 30%, rgba(0, 0, 0, 0.6));
  pointer-events: none;
}

.video-overlay > view {
  pointer-events: auto;
}

.bottom-info {
  position: absolute;
  left: 30rpx;
  right: 130rpx;
  bottom: 60rpx;
}

.author-row {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.author-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(255, 255, 255, 0.3);
  margin-right: 16rpx;
}

.author-meta {
  flex: 1;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}

.author-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #fff;
}

.author-title {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
  margin-left: 8rpx;
}

.follow-btn {
  padding: 8rpx 24rpx;
  background: #07C160;
  border-radius: 30rpx;
  font-size: 24rpx;
  color: #fff;
  margin-left: 16rpx;
}

.follow-btn.followed {
  background: rgba(255, 255, 255, 0.2);
  border: 1rpx solid rgba(255, 255, 255, 0.3);
}

.video-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #fff;
  margin-bottom: 12rpx;
}

.video-desc {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.85);
  line-height: 1.5;
  margin-bottom: 12rpx;
}

.video-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.tag {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
}

.right-actions {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 40rpx;
  position: absolute;
  right: 20rpx;
  top: 50%;
  transform: translateY(-50%);
  z-index: 10;
  pointer-events: auto;
  width: 96rpx;
}

.action-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 96rpx;
}

.action-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.15);
  margin-bottom: 10rpx;
}

.action-icon .iconfont {
  font-size: 40rpx;
  color: #fff;
}

.action-icon.liked .iconfont {
  color: #ff4757;
}

.action-text {
  font-size: 22rpx;
  color: #fff;
}

.action-btn {
  background: transparent;
  padding: 0;
  margin: 0;
  line-height: 1;
  border: none;
  width: 96rpx;
  min-width: 0;
  min-height: 0;
  height: auto;
  max-width: 96rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  overflow: visible;
}

.action-btn::after {
  border: none;
  display: none;
}

.double-heart {
  position: fixed;
  transform: translate(-50%, -50%);
  z-index: 999;
  pointer-events: none;
  animation: heartPop 0.8s ease-out forwards;
}

.heart-text {
  font-size: 160rpx;
  color: #ff4757;
  text-shadow: 0 0 20rpx rgba(255, 71, 87, 0.5);
}

@keyframes heartPop {
  0% {
    opacity: 0;
    transform: translate(-50%, -50%) scale(0.3);
  }
  30% {
    opacity: 1;
    transform: translate(-50%, -50%) scale(1.2);
  }
  60% {
    opacity: 1;
    transform: translate(-50%, -50%) scale(1);
  }
  100% {
    opacity: 0;
    transform: translate(-50%, -80%) scale(0.8);
  }
}

.comment-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
}

.comment-panel {
  width: 100%;
  max-height: 70vh;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  display: flex;
  flex-direction: column;
  animation: slideUp 0.3s ease-out;
}

@keyframes slideUp {
  from {
    transform: translateY(100%);
  }
  to {
    transform: translateY(0);
  }
}

.comment-header {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
  position: relative;
}

.comment-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #191919;
}

.comment-close {
  position: absolute;
  right: 30rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 50rpx;
  height: 50rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.comment-close .iconfont {
  font-size: 32rpx;
  color: #8e8e93;
}

.comment-list {
  flex: 1;
  padding: 20rpx 30rpx 40rpx;
}

.empty-tip {
  text-align: center;
  padding: 80rpx 0;
  color: #8e8e93;
  font-size: 28rpx;
}

.comment-item {
  display: flex;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.comment-item:last-child {
  border-bottom: none;
}

.comment-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.comment-content {
  flex: 1;
}

.comment-meta {
  display: flex;
  align-items: center;
  margin-bottom: 10rpx;
}

.comment-name {
  font-size: 26rpx;
  color: #576b95;
  font-weight: 500;
}

.comment-title {
  font-size: 22rpx;
  color: #8e8e93;
  margin-left: 8rpx;
}

.comment-text {
  font-size: 28rpx;
  color: #191919;
  line-height: 1.5;
}

.reply-to {
  color: #576b95;
}
