page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: #ededed;
}

.discover-page {
  flex: 1;
  min-height: 0;
  background: #ededed;
  padding-top: 16rpx;
  overflow-y: auto;
  box-sizing: border-box;
}

.group {
  background: #fff;
  margin-bottom: 16rpx;
}

.entry {
  display: flex;
  align-items: center;
  padding: 28rpx 32rpx;
  position: relative;
  transition: background 0.15s;
}

.entry-hover {
  background: #f5f5f5;
}

.entry::after {
  content: '';
  position: absolute;
  left: 96rpx;
  right: 32rpx;
  bottom: 0;
  height: 1rpx;
  background: #e5e5e5;
}

.entry:last-child::after {
  display: none;
}

.entry-icon {
  font-size: 44rpx;
  width: 56rpx;
  margin-right: 20rpx;
  text-align: center;
  flex-shrink: 0;
}

.entry-img {
  width: 48rpx;
  height: 48rpx;
  margin-right: 28rpx;
  flex-shrink: 0;
}

.entry-name {
  font-size: 32rpx;
  color: #191919;
  flex-shrink: 0;
}

.entry-right {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  overflow: hidden;
}

.entry-tip {
  font-size: 24rpx;
  color: #999;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-right: 8rpx;
}

.entry-badge {
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 8rpx;
  background: #FA5151;
  border-radius: 16rpx;
  color: #fff;
  font-size: 20rpx;
  line-height: 32rpx;
  text-align: center;
  box-sizing: border-box;
  margin-right: 8rpx;
  flex-shrink: 0;
}

.entry-arrow {
  font-size: 36rpx;
  color: #c8c8c8;
  flex-shrink: 0;
}

.bottom-pad {
  height: env(safe-area-inset-bottom);
  flex-shrink: 0;
}
