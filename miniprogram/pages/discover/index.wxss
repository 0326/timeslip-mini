.discover-page {
  min-height: 100vh;
  background: #ededed;
  padding-top: 16rpx;
}

.group {
  background: #fff;
  margin-bottom: 16rpx;
}

.entry {
  display: flex;
  align-items: center;
  padding: 28rpx 32rpx;
  position: relative;
  transition: background 0.15s;
}

.entry-hover {
  background: #f5f5f5;
}

.entry::after {
  content: '';
  position: absolute;
  left: 96rpx;
  right: 32rpx;
  bottom: 0;
  height: 1rpx;
  background: #e5e5e5;
}

.entry:last-child::after {
  display: none;
}

.entry-icon {
  font-size: 44rpx;
  width: 56rpx;
  margin-right: 20rpx;
  text-align: center;
}

.entry-name {
  flex: 1;
  font-size: 32rpx;
  color: #191919;
}

.entry-arrow {
  font-size: 36rpx;
  color: #c8c8c8;
}

.bottom-pad {
  height: calc(120rpx + env(safe-area-inset-bottom));
}
