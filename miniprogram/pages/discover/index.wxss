.discover-page {
  min-height: 100vh;
  background: #EDEDED;
}

.quick-grid {
  display: flex;
  gap: 16rpx;
  padding: 20rpx 24rpx 12rpx;
}

.quick-card {
  flex: 1;
  background: #fff;
  border-radius: 20rpx;
  padding: 20rpx 16rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  position: relative;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
  transition: transform 0.2s;
}

.quick-card:active {
  transform: scale(0.97);
}

.quick-icon-wrap {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 10rpx;
}

.q-icon {
  font-size: 36rpx;
}

.q-body {
  flex: 1;
}

.q-name {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #191919;
  margin-bottom: 2rpx;
}

.q-desc {
  display: block;
  font-size: 20rpx;
  color: #888;
}

.q-arrow {
  position: absolute;
  top: 24rpx;
  right: 12rpx;
  color: #ccc;
  font-size: 32rpx;
}

.sub-tabs {
  display: flex;
  padding: 8rpx 24rpx 16rpx;
}

.sub-tab {
  padding: 12rpx 28rpx;
  font-size: 28rpx;
  color: #666;
  background: #fff;
  border-radius: 999rpx;
  margin-right: 16rpx;
  transition: all 0.25s;
}

.sub-tab.is-active {
  background: #191919;
  color: #fff;
  font-weight: 500;
}

.dynasty-bar {
  white-space: nowrap;
  background: #fff;
  padding: 16rpx 24rpx;
  border-bottom: 1rpx solid #eee;
  margin-bottom: 16rpx;
}

.dy-item {
  display: inline-flex;
  padding: 10rpx 24rpx;
  margin-right: 16rpx;
  border-radius: 8rpx;
  transition: all 0.2s;
}

.dy-item.is-active {
  background: #191919;
}

.dy-text {
  font-size: 26rpx;
  color: #666;
}

.dy-item.is-active .dy-text {
  color: #fff;
  font-weight: 500;
}

.refreshing-tip {
  text-align: center;
  padding: 20rpx;
  font-size: 24rpx;
  color: var(--wechat-text2);
}

.moments-list-wrap {
  padding: 0 0 24rpx;
}

.moment-block {
  background: #fff;
  padding: 24rpx;
  margin-bottom: 16rpx;
}

.m-header {
  display: flex;
  align-items: flex-start;
  margin-bottom: 16rpx;
}

.mh-info {
  flex: 1;
  margin-left: 16rpx;
  overflow: hidden;
}

.mh-name-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  margin-bottom: 6rpx;
}

.mh-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--wechat-blue);
}

.mh-title {
  font-size: 24rpx;
  color: var(--wechat-text2);
  margin-left: 4rpx;
}

.mh-meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8rpx;
}

.mh-time {
  font-size: 22rpx;
  color: var(--wechat-text2);
}

.mh-dy {
  font-size: 20rpx;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  font-weight: 500;
}

.mh-event {
  font-size: 22rpx;
  color: var(--ancient-gold);
}

.m-content {
  margin-bottom: 16rpx;
}

.mc-text {
  font-size: 30rpx;
  color: #191919;
  line-height: 1.6;
  white-space: pre-line;
  font-family: 'Noto Serif SC', 'PingFang SC', serif;
}

.m-stats {
  display: flex;
  border-top: 1rpx solid #f5f5f5;
  padding-top: 16rpx;
  margin-bottom: 8rpx;
}

.stat-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 12rpx 0;
  border-radius: 8rpx;
  transition: background 0.15s;
}

.stat-item:active {
  background: #f8f8f8;
}

.stat-icon {
  font-size: 32rpx;
  margin-right: 8rpx;
}

.stat-num {
  font-size: 26rpx;
  color: var(--wechat-text2);
}

.m-likes {
  background: #f7f7f7;
  padding: 12rpx 16rpx;
  border-radius: 8rpx;
  margin: 8rpx 0;
}

.like-icon-row {
  font-size: 24rpx;
  color: var(--wechat-blue);
  line-height: 1.5;
}

.like-name {
  margin-right: 12rpx;
}

.m-comments {
  background: #f7f7f7;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  margin: 8rpx 0 0;
}

.cm-item {
  padding: 8rpx 0;
  font-size: 26rpx;
  line-height: 1.5;
}

.cm-name {
  color: var(--wechat-blue);
  font-weight: 500;
}

.cm-content {
  color: #191919;
}

.cm-more {
  font-size: 24rpx;
  color: var(--wechat-blue);
  padding: 8rpx 0 4rpx;
}

.empty-moments {
  padding: 180rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  background: #fff;
  margin: 16rpx;
  border-radius: 20rpx;
}

.em-icon {
  font-size: 80rpx;
  opacity: 0.3;
  margin-bottom: 16rpx;
}

.em-text {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 8rpx;
}

.em-sub {
  font-size: 24rpx;
  color: #bbb;
}

.load-more {
  text-align: center;
  padding: 24rpx;
  font-size: 24rpx;
  color: var(--wechat-text2);
}

.load-more.is-end {
  color: #ccc;
}

.bottom-pad {
  height: calc(120rpx + env(safe-area-inset-bottom));
}
