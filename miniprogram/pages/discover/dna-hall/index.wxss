.page {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 60rpx;
}

/* Hero 区 */
.hero {
  position: relative;
  margin: 24rpx 24rpx 0;
  border-radius: 24rpx;
  overflow: hidden;
  min-height: 420rpx;
  box-shadow: 0 8rpx 32rpx rgba(0,0,0,0.1);
}
.hero-cover {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}
.hero-cover-fallback {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}
.hero-overlay {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: linear-gradient(180deg, rgba(0,0,0,0.1) 0%, rgba(0,0,0,0.5) 100%);
}
.hero-content {
  position: relative;
  padding: 48rpx 40rpx 40rpx;
  z-index: 2;
}
.hero-badge {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 20rpx;
  background: rgba(255,255,255,0.25);
  border: 1rpx solid rgba(255,255,255,0.4);
  border-radius: 100rpx;
  margin-bottom: 24rpx;
}
.hero-badge-text { font-size: 22rpx; color: #fff; letter-spacing: 2rpx; }
.hero-title {
  font-size: 48rpx;
  font-weight: bold;
  color: #fff;
  letter-spacing: 4rpx;
  margin-bottom: 12rpx;
  text-shadow: 0 4rpx 16rpx rgba(0,0,0,0.3);
}
.hero-subtitle {
  font-size: 26rpx;
  color: rgba(255,255,255,0.85);
  margin-bottom: 20rpx;
  letter-spacing: 2rpx;
}
.hero-meta {
  display: flex;
  align-items: center;
  color: rgba(255,255,255,0.9);
  font-size: 24rpx;
  margin-bottom: 28rpx;
}
.hero-meta-item { margin-right: 8rpx; }
.hero-meta-dot { margin: 0 12rpx; opacity: 0.5; }
.hero-btn {
  display: inline-flex;
  align-items: center;
  padding: 20rpx 48rpx;
  background: #fff;
  border-radius: 100rpx;
  color: #333;
  font-size: 28rpx;
  font-weight: bold;
  letter-spacing: 4rpx;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.15);
}
.hero-btn-arrow { margin-left: 12rpx; font-size: 32rpx; line-height: 1; }

/* 列表 */
.list {
  padding: 24rpx 24rpx 0;
}

.quiz-card {
  display: flex;
  align-items: center;
  padding: 20rpx;
  margin-bottom: 16rpx;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.05);
  transition: all 0.2s;
}
.quiz-card:active {
  transform: scale(0.98);
  background: #f9f9f9;
}
.quiz-thumb {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
  overflow: hidden;
}
.quiz-thumb-img {
  width: 100%;
  height: 100%;
}
.quiz-thumb-fallback {
  width: 100%;
  height: 100%;
}
.quiz-info {
  flex: 1;
  margin: 0 20rpx;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
}
.quiz-title {
  font-size: 32rpx;
  color: #1a1a1a;
  font-weight: bold;
  margin-bottom: 12rpx;
  letter-spacing: 2rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.quiz-tags { display: flex; flex-wrap: wrap; align-items: center; }
.quiz-tag {
  padding: 4rpx 14rpx;
  background: #f5f5f5;
  color: #999;
  font-size: 22rpx;
  border-radius: 6rpx;
  margin-right: 12rpx;
}
.quiz-tag-soft {
  background: #fafafa;
  color: #bbb;
}
.quiz-arrow {
  font-size: 36rpx;
  color: #ccc;
  margin-left: 8rpx;
  flex-shrink: 0;
}

/* 骨架屏 */
@keyframes dna-sk-shine {
  0% { background-position: 100% 50%; }
  100% { background-position: 0 50%; }
}

.hero-skeleton {
  position: relative;
  margin: 24rpx 24rpx 0;
  min-height: 420rpx;
  border-radius: 24rpx;
  overflow: hidden;
  background: linear-gradient(135deg, #e8e8e8 0%, #f0f0f0 100%);
  padding: 48rpx 40rpx 40rpx;
  box-sizing: border-box;
  box-shadow: 0 8rpx 32rpx rgba(0,0,0,0.06);
}
.sk-hero-badge,
.sk-hero-line,
.sk-hero-btn,
.loading-thumb,
.loading-line,
.loading-arrow {
  background: linear-gradient(
    90deg,
    rgba(255,255,255,0) 0%,
    rgba(255,255,255,0.6) 50%,
    rgba(255,255,255,0) 100%
  ),
  #f0f0f0;
  background-size: 400% 100%, auto;
  animation: dna-sk-shine 1.4s ease infinite;
  border-radius: 8rpx;
}
.sk-hero-badge {
  width: 140rpx;
  height: 40rpx;
  border-radius: 100rpx;
  margin-bottom: 24rpx;
}
.sk-hero-line { background-color: #f0f0f0; }
.sk-hero-title {
  width: 70%;
  height: 56rpx;
  margin-bottom: 16rpx;
  border-radius: 8rpx;
}
.sk-hero-subtitle {
  width: 50%;
  height: 28rpx;
  margin-bottom: 20rpx;
}
.sk-hero-meta {
  width: 40%;
  height: 24rpx;
  margin-bottom: 28rpx;
}
.sk-hero-btn {
  width: 220rpx;
  height: 72rpx;
  border-radius: 100rpx;
}

.loading-card {
  display: flex;
  align-items: center;
  padding: 20rpx;
  margin-bottom: 16rpx;
  background: #fff;
  border-radius: 16rpx;
}
.loading-thumb {
  width: 120rpx; height: 120rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
}
.loading-info {
  flex: 1;
  margin: 0 20rpx;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
}
.loading-line {
  height: 24rpx;
  border-radius: 4rpx;
  margin-bottom: 16rpx;
}
.loading-line-title { width: 60%; }
.loading-line-tag { width: 40%; height: 20rpx; margin-bottom: 0; }
.loading-arrow {
  width: 24rpx;
  height: 36rpx;
  border-radius: 4rpx;
  flex-shrink: 0;
}

/* 空状态 */
.empty {
  padding: 120rpx 0;
  text-align: center;
}
.empty-icon {
  width: 80rpx;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 50%;
  background: #f0f0f0;
  color: #999;
  font-size: 40rpx;
  font-weight: bold;
  margin: 0 auto 20rpx;
}
.empty-text {
  color: #999;
  font-size: 28rpx;
  letter-spacing: 2rpx;
}

.footer-tip {
  text-align: center;
  color: #ccc;
  font-size: 22rpx;
  padding: 48rpx 0 32rpx;
  letter-spacing: 4rpx;
}
