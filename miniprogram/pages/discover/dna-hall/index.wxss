.page {
  min-height: 100vh;
  background: linear-gradient(180deg, #1A1410 0%, #0F0B08 100%);
  padding-bottom: 60rpx;
  position: relative;
  overflow: hidden;
}

/* 背景装饰 */
.bg-deco {
  position: fixed;
  top: 0; left: 0; right: 0;
  height: 600rpx;
  pointer-events: none;
  overflow: hidden;
  z-index: 0;
}
.bg-circle {
  position: absolute;
  border-radius: 50%;
  filter: blur(80rpx);
  opacity: 0.3;
}
.bg-circle-1 {
  width: 500rpx; height: 500rpx;
  background: #B71C1C;
  top: -200rpx; right: -150rpx;
}
.bg-circle-2 {
  width: 400rpx; height: 400rpx;
  background: #C9A24D;
  top: 100rpx; left: -200rpx;
  opacity: 0.2;
}

/* Hero 区 */
.hero {
  position: relative;
  margin: 24rpx 24rpx 0;
  border-radius: 24rpx;
  overflow: hidden;
  min-height: 480rpx;
  box-shadow: 0 16rpx 48rpx rgba(0,0,0,0.4);
  z-index: 1;
}
.hero-overlay {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: radial-gradient(ellipse at top right, rgba(255,255,255,0.15), transparent 60%);
}
.hero-content {
  position: relative;
  padding: 56rpx 40rpx 48rpx;
  z-index: 2;
}
.hero-badge {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 20rpx;
  background: rgba(255,255,255,0.18);
  border: 1rpx solid rgba(255,255,255,0.3);
  border-radius: 100rpx;
  margin-bottom: 32rpx;
  backdrop-filter: blur(8rpx);
}
.hero-badge-icon { font-size: 24rpx; margin-right: 8rpx; }
.hero-badge-text { font-size: 22rpx; color: #fff; letter-spacing: 2rpx; }
.hero-title {
  font-size: 52rpx;
  font-weight: bold;
  color: #fff;
  letter-spacing: 4rpx;
  margin-bottom: 16rpx;
  text-shadow: 0 4rpx 16rpx rgba(0,0,0,0.4);
}
.hero-subtitle {
  font-size: 28rpx;
  color: rgba(255,255,255,0.85);
  margin-bottom: 24rpx;
  letter-spacing: 2rpx;
}
.hero-desc {
  font-size: 26rpx;
  color: rgba(255,255,255,0.7);
  line-height: 1.6;
  margin-bottom: 28rpx;
}
.hero-meta {
  display: flex;
  align-items: center;
  color: rgba(255,255,255,0.8);
  font-size: 24rpx;
  margin-bottom: 36rpx;
}
.hero-meta-item { margin-right: 8rpx; }
.hero-meta-dot { margin: 0 12rpx; opacity: 0.5; }
.hero-btn {
  display: inline-flex;
  align-items: center;
  padding: 22rpx 56rpx;
  background: #fff;
  border-radius: 100rpx;
  color: #1A1410;
  font-size: 30rpx;
  font-weight: bold;
  letter-spacing: 4rpx;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.3);
}
.hero-btn-arrow { margin-left: 12rpx; font-size: 36rpx; line-height: 1; }

/* 分类筛选 */
.categories {
  margin: 32rpx 0 16rpx;
  white-space: nowrap;
  position: relative;
  z-index: 1;
}
.categories-inner {
  display: inline-flex;
  padding: 0 24rpx;
}
.cat-chip {
  display: inline-flex;
  align-items: center;
  padding: 14rpx 28rpx;
  margin-right: 16rpx;
  background: rgba(255,255,255,0.06);
  border: 1rpx solid rgba(255,255,255,0.12);
  border-radius: 100rpx;
  color: rgba(255,255,255,0.7);
  font-size: 26rpx;
  transition: all 0.2s;
}
.cat-chip-active {
  background: linear-gradient(135deg, #C9A24D 0%, #B71C1C 100%);
  border-color: transparent;
  color: #fff;
  box-shadow: 0 6rpx 20rpx rgba(201,162,77,0.4);
}
.cat-chip-icon { margin-right: 8rpx; font-size: 26rpx; }

/* 列表 */
.list {
  position: relative;
  z-index: 1;
  padding: 0 24rpx;
}

.quiz-card {
  display: flex;
  align-items: center;
  padding: 28rpx;
  margin-bottom: 20rpx;
  background: rgba(255,255,255,0.04);
  border: 1rpx solid rgba(201,162,77,0.15);
  border-radius: 20rpx;
  transition: all 0.2s;
}
.quiz-card:active {
  transform: scale(0.98);
  background: rgba(255,255,255,0.08);
}
.quiz-thumb {
  width: 140rpx;
  height: 140rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: 0 8rpx 20rpx rgba(0,0,0,0.3);
}
.quiz-thumb-icon { font-size: 60rpx; }
.quiz-info {
  flex: 1;
  margin: 0 20rpx;
  min-width: 0;
}
.quiz-title {
  font-size: 32rpx;
  color: #fff;
  font-weight: bold;
  margin-bottom: 8rpx;
  letter-spacing: 2rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.quiz-desc {
  font-size: 24rpx;
  color: rgba(255,255,255,0.55);
  line-height: 1.5;
  margin-bottom: 14rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}
.quiz-tags { display: flex; flex-wrap: wrap; }
.quiz-tag {
  padding: 4rpx 14rpx;
  background: rgba(201,162,77,0.15);
  color: #C9A24D;
  font-size: 22rpx;
  border-radius: 6rpx;
  margin-right: 12rpx;
}
.quiz-tag-soft {
  background: rgba(255,255,255,0.08);
  color: rgba(255,255,255,0.6);
}
.quiz-arrow {
  font-size: 40rpx;
  color: rgba(201,162,77,0.6);
  margin-left: 8rpx;
}

/* 骨架屏 */
.loading-card {
  display: flex;
  align-items: center;
  padding: 28rpx;
  margin-bottom: 20rpx;
  background: rgba(255,255,255,0.03);
  border-radius: 20rpx;
}
.loading-thumb {
  width: 140rpx; height: 140rpx;
  border-radius: 16rpx;
  background: rgba(255,255,255,0.06);
}
.loading-info { flex: 1; margin-left: 20rpx; }
.loading-line {
  height: 24rpx;
  background: rgba(255,255,255,0.06);
  border-radius: 4rpx;
  margin-bottom: 16rpx;
}
.loading-line-title { width: 60%; }
.loading-line-desc { width: 90%; height: 20rpx; }
.loading-line-tag { width: 40%; height: 18rpx; }

/* 空状态 */
.empty {
  padding: 120rpx 0;
  text-align: center;
}
.empty-icon { font-size: 80rpx; opacity: 0.4; margin-bottom: 20rpx; }
.empty-text {
  color: rgba(255,255,255,0.5);
  font-size: 28rpx;
  letter-spacing: 2rpx;
}

.footer-tip {
  text-align: center;
  color: rgba(255,255,255,0.25);
  font-size: 22rpx;
  padding: 60rpx 0 40rpx;
  letter-spacing: 4rpx;
}
