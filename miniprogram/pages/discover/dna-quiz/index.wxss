.page {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 0 32rpx 60rpx;
  display: flex;
  flex-direction: column;
}

/* 顶部进度条 */
.topbar {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
}
.topbar-exit {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #999;
  font-size: 36rpx;
}
.topbar-progress {
  flex: 1;
  height: 6rpx;
  background: #e0e0e0;
  border-radius: 100rpx;
  margin: 0 24rpx;
  overflow: hidden;
}
.topbar-progress-bar {
  height: 100%;
  background: linear-gradient(90deg, #C9A24D 0%, #B71C1C 100%);
  border-radius: 100rpx;
  transition: width 0.4s ease;
}
.topbar-count {
  color: #999;
  font-size: 26rpx;
}
.topbar-count-cur { color: #B71C1C; font-weight: bold; }
.topbar-count-total { opacity: 0.6; }

/* 题目区 */
.quiz {
  flex: 1;
  display: flex;
  flex-direction: column;
  padding-top: 40rpx;
}
.quiz-title {
  color: #B71C1C;
  font-size: 32rpx;
  font-weight: bold;
  letter-spacing: 4rpx;
  margin-bottom: 48rpx;
  text-align: center;
}

.question {
  margin-bottom: 56rpx;
}
.question-no {
  color: #B71C1C;
  font-size: 26rpx;
  letter-spacing: 4rpx;
  margin-bottom: 20rpx;
}
.question-text {
  color: #1a1a1a;
  font-size: 40rpx;
  line-height: 1.5;
  letter-spacing: 2rpx;
  font-weight: 500;
}

.options {
  display: flex;
  flex-direction: column;
}
.option {
  display: flex;
  align-items: center;
  padding: 32rpx 28rpx;
  margin-bottom: 20rpx;
  background: #fff;
  border: 2rpx solid #eee;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.03);
  transition: all 0.25s;
}
.option:active {
  background: #f9f9f9;
}
.option-selected {
  background: rgba(201,162,77,0.06);
  border-color: #C9A24D;
  box-shadow: 0 0 0 1rpx #C9A24D, 0 8rpx 24rpx rgba(201,162,77,0.15);
}
.option-badge {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f0f0f0;
  color: #999;
  font-size: 28rpx;
  font-weight: bold;
  border-radius: 50%;
  margin-right: 24rpx;
  flex-shrink: 0;
  transition: all 0.25s;
}
.option-selected .option-badge {
  background: #C9A24D;
  color: #fff;
}
.option-text {
  flex: 1;
  color: #333;
  font-size: 30rpx;
  line-height: 1.5;
}

/* 弹窗 */
.modal-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}
.modal {
  width: 580rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 48rpx 40rpx 32rpx;
  text-align: center;
}
.modal-title {
  color: #1a1a1a;
  font-size: 34rpx;
  font-weight: bold;
  margin-bottom: 16rpx;
  letter-spacing: 2rpx;
}
.modal-desc {
  color: #999;
  font-size: 26rpx;
  margin-bottom: 40rpx;
}
.modal-actions {
  display: flex;
  gap: 20rpx;
}
.modal-btn {
  flex: 1;
  padding: 22rpx 0;
  border-radius: 100rpx;
  font-size: 28rpx;
  letter-spacing: 2rpx;
}
.modal-btn-cancel {
  background: #f5f5f5;
  color: #666;
}
.modal-btn-confirm {
  background: #B71C1C;
  color: #fff;
}

/* 提交中 */
.submitting {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(255,255,255,0.95);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  z-index: 100;
}
.submitting-spinner {
  width: 80rpx;
  height: 80rpx;
  border: 4rpx solid rgba(201,162,77,0.2);
  border-top-color: #C9A24D;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 32rpx;
}
@keyframes spin { to { transform: rotate(360deg); } }
.submitting-text {
  color: #C9A24D;
  font-size: 28rpx;
  letter-spacing: 4rpx;
}

/* 加载态 */
.loading {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #f5f5f5;
}
.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid rgba(201,162,77,0.2);
  border-top-color: #C9A24D;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 24rpx;
}
.loading-text {
  color: #999;
  font-size: 28rpx;
}
