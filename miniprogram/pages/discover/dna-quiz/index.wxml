<view class="page" wx:if="{{quiz}}">
  <!-- 顶部进度 -->
  <view class="topbar" style="padding-top: {{statusBarHeight + 12}}px;">
    <view class="topbar-exit" bindtap="onTapExit">✕</view>
    <view class="topbar-progress">
      <view class="topbar-progress-bar" style="width: {{(currentIndex + 1) / questions.length * 100}}%;"></view>
    </view>
    <view class="topbar-count">
      <text class="topbar-count-cur">{{currentIndex + 1}}</text>
      <text class="topbar-count-total">/{{questions.length}}</text>
    </view>
  </view>

  <!-- 题目区 -->
  <view class="quiz">
    <view class="quiz-icon">{{quiz.icon}}</view>
    <view class="quiz-title">{{quiz.title}}</view>

    <view class="question">
      <view class="question-no">第 {{currentIndex + 1}} 题</view>
      <view class="question-text">{{questions[currentIndex].text}}</view>
    </view>

    <view class="options">
      <view
        wx:for="{{questions[currentIndex].options}}"
        wx:key="label"
        class="option {{selectedLabel === item.label ? 'option-selected' : ''}}"
        data-label="{{item.label}}"
        bindtap="onSelectOption">
        <view class="option-badge">{{item.label}}</view>
        <view class="option-text">{{item.text}}</view>
      </view>
    </view>
  </view>

  <!-- 退出确认弹窗 -->
  <view class="modal-mask" wx:if="{{showExitConfirm}}" bindtap="onCancelExit">
    <view class="modal" catchtap>
      <view class="modal-title">确认退出？</view>
      <view class="modal-desc">退出后本次答题进度将丢失</view>
      <view class="modal-actions">
        <view class="modal-btn modal-btn-cancel" bindtap="onCancelExit">继续答题</view>
        <view class="modal-btn modal-btn-confirm" bindtap="onConfirmExit">确认退出</view>
      </view>
    </view>
  </view>

  <!-- 提交中遮罩 -->
  <view class="submitting" wx:if="{{submitting}}">
    <view class="submitting-spinner"></view>
    <view class="submitting-text">正在生成你的历史DNA...</view>
  </view>
</view>

<!-- 加载态 -->
<view class="loading" wx:elif="{{loading}}">
  <view class="loading-spinner"></view>
  <view class="loading-text">载入中...</view>
</view>

<view class="loading" wx:elif="{{error}}">
  <view class="loading-text">{{error}}</view>
</view>
