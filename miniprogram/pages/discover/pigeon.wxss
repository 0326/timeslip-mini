.page {
  min-height: 100vh;
  background: linear-gradient(180deg, #F5F0E6 0%, #EDEDED 100%);
}

.compose {
  padding: 32rpx;
}

.to-card {
  background: var(--wechat-white);
  border-radius: var(--radius-lg);
  padding: 28rpx 32rpx;
  margin-bottom: 24rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.03);
}
.to-label {
  font-size: 36rpx;
  color: var(--ancient-seal);
  margin-right: 24rpx;
  width: 48rpx;
  text-align: center;
}
.to-figure {
  display: flex;
  align-items: center;
  flex: 1;
}
.to-info { margin-left: 20rpx; }
.to-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--wechat-text);
}
.to-dynasty {
  font-size: 24rpx;
  color: var(--wechat-text2);
  margin-top: 4rpx;
}
.to-placeholder {
  flex: 1;
  display: flex;
  justify-content: space-between;
  align-items: center;
  color: var(--wechat-text2);
}
.ph-text { font-size: 28rpx; }
.ph-arrow { font-size: 40rpx; color: #ccc; }

.letter-paper {
  background: var(--ancient-paper);
  background-image: repeating-linear-gradient(
    transparent,
    transparent 59rpx,
    rgba(201,162,77,0.12) 59rpx,
    rgba(201,162,77,0.12) 60rpx
  );
  border-radius: var(--radius-lg);
  padding: 40rpx 32rpx 32rpx;
  position: relative;
  box-shadow: 0 8rpx 32rpx rgba(201,162,77,0.15);
  border: 2rpx solid rgba(201,162,77,0.25);
}
.paper-header {
  position: absolute;
  top: 20rpx;
  right: 24rpx;
}
.paper-seal {
  width: 60rpx;
  height: 60rpx;
  line-height: 60rpx;
  text-align: center;
  color: #fff;
  background: var(--ancient-seal);
  font-size: 26rpx;
  transform: rotate(-10deg);
  border-radius: var(--radius-sm);
}
.letter-input {
  width: 100%;
  min-height: 400rpx;
  font-size: 30rpx;
  line-height: 60rpx;
  color: var(--ancient-ink);
  padding: 0;
  background: transparent;
}
.counter {
  text-align: right;
  font-size: 22rpx;
  color: var(--wechat-text2);
  margin-top: 8rpx;
}
.paper-footer {
  text-align: center;
  font-size: 22rpx;
  color: rgba(201,162,77,0.6);
  margin-top: 32rpx;
  letter-spacing: 4rpx;
}

.tips {
  text-align: center;
  margin: 32rpx 0;
  color: var(--ancient-gold);
  font-size: 24rpx;
}
.tip-icon { margin-right: 8rpx; }

.btn-send, .btn-save, .btn-write, .btn-chat {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  border-radius: var(--radius-lg);
  font-size: 32rpx;
  font-weight: 500;
  border: none;
}
.btn-send {
  background: var(--wechat-divider);
  color: #fff;
}
.btn-send.active {
  background: linear-gradient(135deg, var(--ancient-gold), #E8C97E);
  color: var(--ancient-ink);
  box-shadow: 0 8rpx 24rpx rgba(201,162,77,0.4);
}
.btn-send[disabled] { opacity: 0.5; }

.flying {
  padding: 80rpx 32rpx;
  text-align: center;
}
.sky {
  position: relative;
  height: 500rpx;
  background: linear-gradient(180deg, #87CEEB 0%, #E0F6FF 100%);
  border-radius: var(--radius-lg);
  overflow: hidden;
  margin-bottom: 48rpx;
}
.cloud {
  position: absolute;
  font-size: 80rpx;
  opacity: 0.8;
}
.c1 { top: 60rpx; left: 40rpx; animation: drift1 6s ease-in-out infinite; }
.c2 { top: 160rpx; right: 60rpx; font-size: 100rpx; animation: drift2 7s ease-in-out infinite; }
.c3 { bottom: 80rpx; left: 30%; animation: drift3 5s ease-in-out infinite; }
@keyframes drift1 { 0%,100% { transform: translateX(0) } 50% { transform: translateX(30rpx) } }
@keyframes drift2 { 0%,100% { transform: translateX(0) } 50% { transform: translateX(-40rpx) } }
@keyframes drift3 { 0%,100% { transform: translateX(0) } 50% { transform: translateX(20rpx) } }

.flying-text .line1 {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--ancient-ink);
  margin-bottom: 16rpx;
}
.flying-text .line2 {
  font-size: 26rpx;
  color: var(--wechat-text2);
  margin-bottom: 24rpx;
}
.dots text {
  display: inline-block;
  font-size: 48rpx;
  color: var(--ancient-gold);
  animation: blink 1.2s infinite;
}
.dots text:nth-child(2) { animation-delay: 0.2s; }
.dots text:nth-child(3) { animation-delay: 0.4s; }
@keyframes blink { 0%,60%,100% { opacity: 0.3 } 30% { opacity: 1 } }

.reply-page { padding: 32rpx; }
.reply-hero {
  text-align: center;
  font-size: 40rpx;
  color: var(--ancient-seal);
  margin-bottom: 32rpx;
}
.reply-paper {
  background: var(--ancient-paper);
  border: 2rpx solid rgba(201,162,77,0.3);
  border-radius: var(--radius-lg);
  padding: 32rpx;
  box-shadow: 0 8rpx 32rpx rgba(0,0,0,0.06);
}
.reply-header {
  display: flex;
  align-items: center;
  padding-bottom: 24rpx;
  border-bottom: 1rpx dashed rgba(201,162,77,0.4);
  margin-bottom: 24rpx;
}
.reply-meta { margin-left: 20rpx; }
.reply-from { font-size: 30rpx; font-weight: 600; color: var(--ancient-ink); }
.reply-time { font-size: 22rpx; color: var(--wechat-text2); margin-top: 4rpx; }

.my-letter {
  background: rgba(0,0,0,0.04);
  padding: 20rpx;
  border-radius: var(--radius-md);
  margin-bottom: 24rpx;
}
.my-label {
  font-size: 22rpx;
  color: var(--wechat-text2);
  margin-bottom: 8rpx;
}
.my-content {
  font-size: 26rpx;
  color: var(--wechat-text);
  line-height: 1.6;
}

.divider {
  text-align: center;
  font-size: 24rpx;
  color: var(--ancient-gold);
  margin: 24rpx 0;
  letter-spacing: 16rpx;
}

.reply-content {
  font-size: 30rpx;
  line-height: 60rpx;
  color: var(--ancient-ink);
  padding: 16rpx 0;
  min-height: 200rpx;
}

.seal-area {
  display: flex;
  justify-content: flex-end;
  margin-top: 32rpx;
}
.seal {
  padding: 12rpx 20rpx;
  color: #fff;
  background: var(--ancient-seal);
  font-size: 26rpx;
  transform: rotate(-6deg);
  border-radius: var(--radius-sm);
  opacity: 0.9;
}

.reply-actions {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-top: 40rpx;
}
.btn-save { background: var(--wechat-white); color: var(--wechat-text); border: 2rpx solid var(--wechat-divider); }
.btn-write { background: var(--wechat-green); color: #fff; }
.btn-chat { background: var(--ancient-paper); color: var(--ancient-ink); border: 2rpx solid var(--ancient-gold); }

.picker-mask {
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.5);
  z-index: 999;
  display: flex;
  align-items: flex-end;
}
.picker-sheet {
  width: 100%;
  max-height: 75vh;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  display: flex;
  flex-direction: column;
}
.picker-header {
  padding: 28rpx 32rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 30rpx;
  font-weight: 600;
  border-bottom: 1rpx solid var(--wechat-divider);
}
.close-btn { font-size: 48rpx; color: #999; line-height: 1; }
.picker-list {
  flex: 1;
  padding: 16rpx 0;
}
.picker-item {
  display: flex;
  align-items: center;
  padding: 20rpx 32rpx;
}
.picker-item.active { background: var(--ancient-paper); }
.picker-info { margin-left: 20rpx; flex: 1; }
.picker-name { font-size: 28rpx; color: var(--wechat-text); }
.picker-dynasty { font-size: 22rpx; color: var(--wechat-text2); margin-top: 4rpx; }
.picker-check { color: var(--ancient-gold); font-size: 32rpx; font-weight: 700; }
