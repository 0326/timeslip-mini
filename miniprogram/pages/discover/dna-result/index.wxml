<view class="page" wx:if="{{result}}">
  <!-- 返回按钮：固定在顶部，不随页面滚动 -->
  <view class="back-btn" bindtap="onBack" style="top: {{statusBarHeight + 12}}px;">
    <text class="back-btn-icon">‹</text>
  </view>

  <!-- Hero 区：测试封面图作背景 + 轻渐变蒙层 -->
  <view class="hero" style="padding-top: {{statusBarHeight + 40}}px;">
    <!-- 测试封面背景图 -->
    <image wx:if="{{quiz.cover}}" class="hero-bg-img" src="{{quiz.cover}}" mode="aspectFill"></image>
    <!-- 渐变蒙层：轻量，能看到背景图 -->
    <view class="hero-mask"></view>

    <view class="hero-content">
      <!-- 匹配度 -->
      <view class="hero-sim-label">历史人格测试 · 匹配度</view>
      <view class="hero-sim">
        <text class="hero-sim-num">{{record.similarity}}</text>
        <text class="hero-sim-pct">%</text>
      </view>

      <view class="hero-divider"></view>

      <!-- 大头像左侧 + 三行文字右侧，上下对齐 -->
      <view class="hero-figure-row">
        <view class="hero-avatar-box">
          <image wx:if="{{figureAvatar}}" class="hero-avatar" src="{{figureAvatar}}" mode="aspectFill"></image>
          <view wx:else class="hero-avatar hero-avatar-placeholder">
            <text class="hero-avatar-text">{{result.figureName}}</text>
          </view>
        </view>
        <view class="hero-figure-info">
          <view class="hero-figure-name">{{result.figureName}}</view>
          <view class="hero-figure-title">
            <text>{{result.figureTitle}}</text>
            <text wx:if="{{result.dynastyName}}" class="hero-figure-dyn"> · {{result.dynastyName}}</text>
          </view>
          <view class="hero-result-title">{{result.title}}</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 雷达图：与 Hero 区之间留出清晰间距 -->
  <view class="section radar-section">
    <view class="section-title">— 维度雷达 —</view>
    <view class="radar-wrap">
      <canvas
        type="2d"
        id="radarCanvas"
        class="radar-canvas"
        disable-scroll="true"></canvas>
    </view>
  </view>

  <!-- 一句话简介 -->
  <view class="section">
    <view class="card quote-card">
      <view class="quote-mark">「</view>
      <view class="quote-text">{{result.intro}}</view>
      <view class="quote-mark quote-mark-end">」</view>
    </view>
  </view>

  <!-- 详细描述 -->
  <view class="section">
    <view class="card">
      <view class="card-title">人物解析</view>
      <view class="card-text">{{result.desc}}</view>
    </view>
  </view>

  <!-- 名言 -->
  <view class="section" wx:if="{{result.quote}}">
    <view class="card quote-card-famous">
      <view class="famous-label">名 言</view>
      <view class="famous-text">{{result.quote}}</view>
    </view>
  </view>

  <!-- 为什么是Ta -->
  <view class="section" wx:if="{{result.reasons.length}}">
    <view class="card">
      <view class="card-title">为什么是Ta</view>
      <view class="reasons">
        <view class="reason-item" wx:for="{{result.reasons}}" wx:key="*this">
          <view class="reason-no">{{index + 1}}</view>
          <view class="reason-text">{{item}}</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 维度分析 -->
  <view class="section" wx:if="{{dimBars.length}}">
    <view class="card">
      <view class="card-title">维度分析</view>
      <view class="dim-bars">
        <view class="dim-bar" wx:for="{{dimBars}}" wx:key="name">
          <view class="dim-bar-name">{{item.name}}</view>
          <view class="dim-bar-track">
            <view class="dim-bar-fill" style="width: {{item.percent}}%;"></view>
          </view>
          <view class="dim-bar-value">{{item.value}}</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 人物简介 -->
  <view class="section" wx:if="{{result.bio}}">
    <view class="card">
      <view class="card-title">人物简介</view>
      <view class="card-text card-text-bio">{{result.bio}}</view>
    </view>
  </view>

  <!-- 去找XXX聊天：流式布局，增加足够下边距 -->
  <view class="section chat-section" wx:if="{{figureExists}}">
    <view class="chat-link" bindtap="onChatWithFigure">
      去找{{result.figureName}}聊天 ›
    </view>
  </view>

  <!-- 底部占位，确保聊天按钮完全可见不被遮挡 -->
  <view class="bottom-placeholder"></view>

  <!-- 底部操作栏：层级最高 -->
  <view class="action-bar">
    <button class="action-btn action-btn-secondary" bindtap="onRetryQuiz">再测一次</button>
    <button class="action-btn action-btn-primary" open-type="share">分享结果</button>
  </view>
</view>

<!-- 加载态 -->
<view class="loading" wx:elif="{{loading}}">
  <view class="loading-spinner"></view>
  <view class="loading-text">正在揭晓你的历史人格...</view>
</view>

<view class="loading" wx:else>
  <view class="loading-text">{{error}}</view>
</view>
