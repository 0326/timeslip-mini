.page {
  min-height: 100vh;
  background: #f5f5f5;
}

/* ===== 固定返回按钮（不随滚动） ===== */
.back-btn {
  position: fixed;
  left: 24rpx;
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0,0,0,0.3);
  backdrop-filter: blur(12rpx);
  border-radius: 50%;
  z-index: 100;
}
.back-btn-icon {
  color: #fff;
  font-size: 60rpx;
  line-height: 1;
  margin-top: -6rpx;
  font-weight: 300;
}

/* ===== Hero 区 ===== */
.hero {
  position: relative;
  padding: 80rpx 40rpx 80rpx;
  overflow: hidden;
  min-height: 520rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  background: linear-gradient(160deg, #B71C1C 0%, #8B1A1A 100%);
}
/* 背景图：测试封面 */
.hero-bg-img {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  width: 100%;
  height: 100%;
}
/* 轻渐变蒙层：底部偏暗保证文字可读，整体半透明让背景图可见 */
.hero-mask {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: linear-gradient(180deg, rgba(0,0,0,0.2) 0%, rgba(0,0,0,0.15) 40%, rgba(0,0,0,0.55) 100%);
  pointer-events: none;
}
.hero-content {
  position: relative;
  z-index: 2;
  text-align: center;
}

/* 匹配度 */
.hero-sim-label {
  color: rgba(255,255,255,0.85);
  font-size: 24rpx;
  letter-spacing: 4rpx;
  margin-bottom: 8rpx;
}
.hero-sim {
  display: flex;
  align-items: baseline;
  justify-content: center;
  margin-bottom: 20rpx;
}
.hero-sim-num {
  font-size: 100rpx;
  font-weight: bold;
  color: #fff;
  line-height: 1;
  text-shadow: 0 4rpx 20rpx rgba(0,0,0,0.3);
}
.hero-sim-pct {
  font-size: 40rpx;
  color: rgba(255,255,255,0.9);
  margin-left: 6rpx;
}
.hero-divider {
  width: 60rpx;
  height: 2rpx;
  background: rgba(255,255,255,0.4);
  margin: 20rpx auto 28rpx;
}

/* 大头像左侧 + 三行文字右侧 */
.hero-figure-row {
  display: flex;
  align-items: center;
  justify-content: center;
}
.hero-avatar-box {
  margin-right: 28rpx;
  flex-shrink: 0;
}
.hero-avatar {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255,255,255,0.9);
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.3);
}
.hero-avatar-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255,255,255,0.2);
}
.hero-avatar-text {
  color: #fff;
  font-size: 48rpx;
  font-weight: bold;
  font-family: "STKaiti", "KaiTi", serif;
}
.hero-figure-info {
  text-align: left;
}
.hero-figure-name {
  font-size: 72rpx;
  font-weight: bold;
  color: #fff;
  letter-spacing: 4rpx;
  margin-bottom: 8rpx;
  font-family: "STKaiti", "KaiTi", "Ma Shan Zheng", serif;
  text-shadow: 0 4rpx 16rpx rgba(0,0,0,0.4);
  line-height: 1.2;
}
.hero-figure-title {
  color: rgba(255,255,255,0.85);
  font-size: 26rpx;
  letter-spacing: 2rpx;
  margin-bottom: 10rpx;
}
.hero-figure-dyn {
  color: rgba(255,255,255,0.65);
}
.hero-result-title {
  color: rgba(255,255,255,0.75);
  font-size: 24rpx;
  letter-spacing: 1rpx;
}

/* ===== Section 通用 ===== */
.section {
  padding: 0 24rpx;
  margin-top: 28rpx;
}
.section-title {
  text-align: center;
  color: #B71C1C;
  font-size: 26rpx;
  letter-spacing: 6rpx;
  margin-bottom: 24rpx;
}

/* 雷达图：与hero保持清晰间距 */
.radar-section {
  margin-top: 28rpx;
}
.radar-wrap {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  display: flex;
  justify-content: center;
  box-shadow: 0 2rpx 16rpx rgba(0,0,0,0.06);
}
.radar-canvas {
  width: 580rpx;
  height: 460rpx;
}

/* 卡片 */
.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 36rpx 32rpx;
  position: relative;
  box-shadow: 0 2rpx 16rpx rgba(0,0,0,0.06);
}
.card-title {
  color: #B71C1C;
  font-size: 28rpx;
  letter-spacing: 4rpx;
  margin-bottom: 20rpx;
  font-weight: bold;
}
.card-text {
  color: #333;
  font-size: 28rpx;
  line-height: 1.8;
  letter-spacing: 1rpx;
}
.card-text-bio {
  color: #666;
  font-size: 26rpx;
}

/* 引言卡 */
.quote-card {
  text-align: center;
  background: linear-gradient(135deg, rgba(201,162,77,0.08) 0%, rgba(183,28,28,0.05) 100%);
  border: 1rpx solid rgba(201,162,77,0.2);
}
.quote-mark {
  font-size: 60rpx;
  color: rgba(201,162,77,0.4);
  font-family: "STKaiti", "KaiTi", serif;
  line-height: 1;
  margin-bottom: -10rpx;
}
.quote-mark-end {
  margin-top: -10rpx;
  margin-bottom: 0;
}
.quote-text {
  color: #1a1a1a;
  font-size: 32rpx;
  line-height: 1.6;
  letter-spacing: 2rpx;
  padding: 8rpx 24rpx;
  font-family: "STKaiti", "KaiTi", serif;
}

/* 名言卡 */
.quote-card-famous {
  background: linear-gradient(135deg, rgba(201,162,77,0.06) 0%, rgba(183,28,28,0.04) 100%);
  border: 1rpx solid rgba(201,162,77,0.25);
  text-align: center;
}
.famous-label {
  display: inline-block;
  padding: 6rpx 24rpx;
  background: rgba(201,162,77,0.15);
  color: #B71C1C;
  font-size: 22rpx;
  letter-spacing: 8rpx;
  border-radius: 100rpx;
  margin-bottom: 24rpx;
}
.famous-text {
  color: #1a1a1a;
  font-size: 30rpx;
  line-height: 1.7;
  letter-spacing: 2rpx;
  font-family: "STKaiti", "KaiTi", serif;
}

/* 理由列表 */
.reasons { display: flex; flex-direction: column; gap: 20rpx; }
.reason-item {
  display: flex;
  align-items: flex-start;
}
.reason-no {
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #C9A24D 0%, #B71C1C 100%);
  color: #fff;
  font-size: 24rpx;
  font-weight: bold;
  border-radius: 50%;
  margin-right: 20rpx;
  flex-shrink: 0;
  margin-top: 4rpx;
}
.reason-text {
  flex: 1;
  color: #333;
  font-size: 28rpx;
  line-height: 1.6;
  letter-spacing: 1rpx;
}

/* 维度条 */
.dim-bars { display: flex; flex-direction: column; gap: 18rpx; }
.dim-bar {
  display: flex;
  align-items: center;
}
.dim-bar-name {
  width: 120rpx;
  color: #666;
  font-size: 26rpx;
  letter-spacing: 2rpx;
}
.dim-bar-track {
  flex: 1;
  height: 14rpx;
  background: #f0f0f0;
  border-radius: 100rpx;
  overflow: hidden;
  margin: 0 20rpx;
}
.dim-bar-fill {
  height: 100%;
  background: linear-gradient(90deg, #C9A24D 0%, #B71C1C 100%);
  border-radius: 100rpx;
  transition: width 0.6s ease;
}
.dim-bar-value {
  width: 60rpx;
  text-align: right;
  color: #B71C1C;
  font-size: 24rpx;
  font-weight: bold;
}

/* ===== 去找XXX聊天：流式布局，增加下边距 ===== */
.chat-section {
  text-align: center;
  padding-top: 20rpx;
  padding-bottom: 20rpx;
  margin-bottom: 20rpx;
}
.chat-link {
  display: inline-block;
  padding: 22rpx 56rpx;
  background: linear-gradient(135deg, rgba(201,162,77,0.1) 0%, rgba(183,28,28,0.08) 100%);
  border: 1rpx solid rgba(201,162,77,0.35);
  color: #B71C1C;
  font-size: 28rpx;
  letter-spacing: 2rpx;
  border-radius: 100rpx;
}

/* 底部占位：确保聊天按钮完全可见 */
.bottom-placeholder {
  height: 200rpx;
}

/* ===== 底部操作栏：层级最高 ===== */
.action-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  padding: 20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(255,255,255,0.98);
  backdrop-filter: blur(20rpx);
  border-top: 1rpx solid #eee;
  z-index: 200;
  gap: 16rpx;
  box-shadow: 0 -4rpx 20rpx rgba(0,0,0,0.05);
}
.action-btn {
  flex: 1;
  padding: 24rpx 0;
  border-radius: 100rpx;
  font-size: 28rpx;
  letter-spacing: 2rpx;
  text-align: center;
  line-height: 1.2;
  margin: 0;
  border: none;
}
.action-btn::after { border: none; }
.action-btn-secondary {
  background: #f5f5f5;
  color: #666;
}
.action-btn-primary {
  flex: 1.5;
  background: linear-gradient(135deg, #C9A24D 0%, #B71C1C 100%);
  color: #fff;
  font-weight: bold;
  box-shadow: 0 6rpx 20rpx rgba(183,28,28,0.2);
}

/* ===== 加载态 ===== */
.loading {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #f5f5f5;
}
.loading-spinner {
  width: 80rpx;
  height: 80rpx;
  border: 4rpx solid rgba(201,162,77,0.2);
  border-top-color: #C9A24D;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 32rpx;
}
@keyframes spin { to { transform: rotate(360deg); } }
.loading-text {
  color: #999;
  font-size: 28rpx;
  letter-spacing: 4rpx;
}
