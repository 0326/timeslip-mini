.page {
  min-height: 100vh;
  background: #ededed;
  padding-bottom: calc(180rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.initial-skeleton {
  padding: 32rpx;
}
.sk-head {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding-bottom: 24rpx;
}
.sk-avatar {
  width: 140rpx; height: 140rpx;
  border-radius: 50%;
  background: linear-gradient(90deg, #f0f0f0, #f8f8f8, #f0f0f0);
  background-size: 200% 100%;
  animation: sk-wave 1.2s ease infinite;
}
.sk-head-col { flex: 1; display: flex; flex-direction: column; gap: 14rpx; }
.sk-line {
  height: 24rpx;
  border-radius: 6rpx;
  background: linear-gradient(90deg, #f0f0f0, #f8f8f8, #f0f0f0);
  background-size: 200% 100%;
  animation: sk-wave 1.2s ease infinite;
}
.sk-line.lg { width: 240rpx; }
.sk-line.md { width: 180rpx; height: 20rpx; }
.sk-block {
  height: 32rpx;
  margin-top: 20rpx;
  border-radius: 6rpx;
  background: linear-gradient(90deg, #f0f0f0, #f8f8f8, #f0f0f0);
  background-size: 200% 100%;
  animation: sk-wave 1.2s ease infinite;
}
.sk-block.sm { height: 24rpx; margin-top: 16rpx; }
.sk-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 8rpx;
  margin-top: 20rpx;
}
.sk-item {
  aspect-ratio: 1/1;
  border-radius: 8rpx;
  background: linear-gradient(90deg, #f0f0f0, #f8f8f8, #f0f0f0);
  background-size: 200% 100%;
  animation: sk-wave 1.2s ease infinite;
}
@keyframes sk-wave {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}

.empty-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 160rpx 40rpx;
  text-align: center;
}
.empty-emoji { font-size: 96rpx; margin-bottom: 24rpx; }
.empty-title { font-size: 32rpx; color: #111; font-weight: 600; margin-bottom: 10rpx; }
.empty-desc { font-size: 26rpx; color: #8a8a8a; margin-bottom: 40rpx; }
.empty-btn {
  padding: 16rpx 48rpx;
  border-radius: 999rpx;
  background: #F7F6F2;
  color: #576B95;
  font-size: 28rpx;
  line-height: 1.2;
}

.moment-hero {
  display: flex;
  align-items: center;
  padding: 28rpx 32rpx 24rpx;
  gap: 20rpx;
  background: #fff;
  border-bottom: 1rpx solid rgba(0,0,0,0.05);
}
.hero-avatar {
  flex-shrink: 0;
}
.hero-meta {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}
.hero-name { font-size: 34rpx; font-weight: 700; color: #111; }
.hero-title-row { display: flex; align-items: center; gap: 10rpx; flex-wrap: wrap; }
.hero-title { font-size: 25rpx; color: #8a8a8a; }
.hero-dynasty {
  font-size: 22rpx;
  padding: 2rpx 12rpx;
  background: #F7F6F2;
  border-radius: 6rpx;
  color: #576B95;
}
.hero-time { font-size: 24rpx; color: #b0b0b0; margin-top: 4rpx; }

.detail-body {
  background: #fff;
  padding: 24rpx 32rpx 32rpx;
  margin-top: 12rpx;
}
.moment-content {
  font-size: 32rpx;
  line-height: 1.65;
  color: #111;
  word-break: break-word;
  white-space: pre-wrap;
  letter-spacing: 0.5rpx;
}

.img-grid {
  margin-top: 20rpx;
  display: grid;
  gap: 8rpx;
  width: 100%;
  box-sizing: border-box;
}
.img-grid.grid-type-1 {
  display: block;
}
.grid-type-1 .img-cell {
  width: 520rpx;
  max-width: 100%;
}
.grid-type-1 .img {
  width: 100%;
  height: 390rpx;
  border-radius: 10rpx;
}
.img-grid.grid-type-2,
.img-grid.grid-type-3 {
  grid-template-columns: repeat(3, 1fr);
  max-width: 520rpx;
}
.img-grid.grid-type-4 {
  grid-template-columns: repeat(2, 1fr);
  max-width: 440rpx;
}
.img-grid.grid-type-9 {
  grid-template-columns: repeat(3, 1fr);
  max-width: 520rpx;
}
.img-type-2, .img-type-3, .img-type-4, .img-type-9 {
  width: 100%;
  aspect-ratio: 1/1;
}
.img {
  width: 100%;
  height: 100%;
  display: block;
  border-radius: 10rpx;
  overflow: hidden;
  background: #f2f2f2;
  color: transparent;
}

.foot-row {
  margin-top: 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 8rpx;
  gap: 20rpx;
}
.foot-source {
  flex: 1;
  min-width: 0;
  font-size: 22rpx;
  color: #576B95;
  opacity: 0.7;
  word-break: break-word;
}
.foot-date {
  flex-shrink: 0;
  font-size: 24rpx;
  color: #b0b0b0;
}

.bubble {
  margin-top: 20rpx;
  background: #F7F7F7;
  border-radius: 8rpx;
  padding: 18rpx 20rpx 6rpx;
  position: relative;
}
.bubble::before {
  content: '';
  position: absolute;
  top: -12rpx;
  right: 60rpx;
  width: 0; height: 0;
  border-left: 12rpx solid transparent;
  border-right: 12rpx solid transparent;
  border-bottom: 12rpx solid #F7F7F7;
}
.bubble-section { padding: 6rpx 0 12rpx; }
.bubble-row {
  display: flex;
  align-items: flex-start;
  gap: 8rpx;
}
.bubble-divider {
  height: 1rpx;
  background: rgba(0,0,0,0.04);
  margin: 4rpx 0;
}
.bubble-icon {
  width: 28rpx; height: 28rpx;
  flex-shrink: 0;
  margin-top: 4rpx;
}
.bubble-names {
  flex: 1;
  font-size: 26rpx;
  line-height: 1.5;
  color: #333;
}
.name-link { color: #576B95; font-weight: 500; }
.name-sep { color: #333; }

.comment-item {
  display: flex;
  flex-direction: column;
  padding-bottom: 16rpx;
  position: relative;
  min-width: 0;
}
.comment-item.deleting { opacity: 0.55; }
.comment-main {
  font-size: 26rpx;
  line-height: 1.5;
  color: #333;
  padding-right: 96rpx;
  min-width: 0;
  word-break: break-word;
}
.reply-prefix { color: #555; margin: 0 6rpx; }
.colon-sep { color: #333; }
.comment-text { color: #1b1b1b; word-break: break-word; }
.comment-right {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 6rpx;
  min-height: 30rpx;
}
.comment-time { font-size: 22rpx; color: #c0c0c0; }
.delete-trigger {
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
}
.delete-text {
  font-size: 22rpx;
  color: #8a8a8a;
}
.comment-badge {
  position: absolute;
  top: 6rpx;
  right: 0;
  font-size: 20rpx;
  color: #b0b0b0;
  background: #fff;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
}

.action-bar {
  display: flex;
  align-items: center;
  justify-content: space-around;
  margin-top: 24rpx;
  padding: 18rpx 0;
  border-top: 1rpx solid #f0f0f0;
}
.action-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 12rpx 32rpx;
  border-radius: 999rpx;
  background: transparent;
  transition: background 0.15s ease;
  line-height: 1;
  font-size: 28rpx;
  color: #576B95;
  font-weight: 500;
  border: none;
  min-width: 140rpx;
  box-sizing: border-box;
}
.action-btn::after { border: none; }
.action-btn.active { color: #FA5151; }
.action-btn.active .action-icon { stroke: #FA5151; }
.action-icon {
  width: 40rpx;
  height: 40rpx;
  display: block;
}
.action-label { font-size: 26rpx; }
.share-btn {
  background: transparent !important;
  border: none !important;
  box-shadow: none !important;
}
.share-btn::after { display: none !important; }
.share-btn[disabled] { opacity: 1; }

.comment-mask {
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0);
  pointer-events: none;
  z-index: 90;
  transition: background 0.2s ease;
}
.comment-mask.show {
  background: rgba(0,0,0,0.3);
  pointer-events: auto;
}
.comment-input-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  transform: translateY(100%);
  z-index: 100;
  background: #F7F7F7;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  gap: 16rpx;
  transition: transform 0.2s ease;
  border-top: 1rpx solid #EBEBEB;
}
.comment-input-bar.show {
  transform: translateY(0);
}
.comment-input {
  flex: 1;
  height: 72rpx;
  padding: 0 24rpx;
  border-radius: 8rpx;
  background: #fff;
  font-size: 28rpx;
  color: #111;
}
.comment-input-placeholder {
  color: #b0b0b0;
  font-size: 28rpx;
}
.comment-send {
  flex-shrink: 0;
  padding: 0 28rpx;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 8rpx;
  background: #e9ecf2;
  color: #8a8a8a;
  font-size: 28rpx;
  font-weight: 500;
}
.comment-send::after { border: none; }
.comment-send.active {
  background: #576B95;
  color: #fff;
}
.comment-send[disabled] {
  opacity: 0.65;
}
.comment-send.loading {
  opacity: 0.8;
}
