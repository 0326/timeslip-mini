.chat-list-page {
  min-height: 100vh;
  background: var(--wechat-bg);
}

.nav-actions {
  display: flex;
  align-items: center;
  padding: 0 20rpx;
  height: 100%;
}

.nav-action-icon {
  font-size: 40rpx;
}

.search-wrap {
  padding: 16rpx 24rpx;
  background: #fff;
  border-bottom: 1rpx solid #eee;
}

.search-bar {
  display: flex;
  align-items: center;
  height: 68rpx;
  background: #F2F2F2;
  border-radius: 8rpx;
  padding: 0 24rpx;
}

.search-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
  opacity: 0.5;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  height: 100%;
  color: #191919;
}

.search-clear {
  font-size: 28rpx;
  padding: 0 8rpx;
  color: #999;
}

.loading-wrap {
  padding: 200rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.loading-dots .dot {
  display: inline-block;
  font-size: 48rpx;
  animation: dotBounce 1.4s infinite;
  color: var(--wechat-green);
}
.loading-dots .dot:nth-child(2) { animation-delay: 0.2s; }
.loading-dots .dot:nth-child(3) { animation-delay: 0.4s; }

@keyframes dotBounce {
  0%, 60%, 100% { transform: translateY(0); opacity: 0.4; }
  30% { transform: translateY(-12rpx); opacity: 1; }
}

.loading-text {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: var(--wechat-text2);
}

.empty-wrap {
  padding: 200rpx 60rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.empty-icon {
  font-size: 120rpx;
  opacity: 0.3;
  margin-bottom: 32rpx;
}

.empty-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #191919;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: var(--wechat-text2);
  line-height: 1.6;
  margin-bottom: 48rpx;
}

.empty-btn {
  padding: 16rpx 64rpx !important;
  border-radius: 999rpx !important;
}

.session-list {
  height: calc(100vh - 88rpx - 68rpx - 120rpx - env(safe-area-inset-bottom));
  background: #fff;
}

.session-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  background: #fff;
  position: relative;
  transition: background 0.15s;
}

.session-hover {
  background: #F7F7F7;
}

.session-item::after {
  content: '';
  position: absolute;
  left: 140rpx;
  right: 24rpx;
  bottom: 0;
  height: 1rpx;
  background: #eee;
  opacity: 0.6;
}

.avatar-wrap {
  position: relative;
  width: 96rpx;
  height: 96rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 16rpx;
  background: #eee;
  overflow: hidden;
}

.unread-badge {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  min-width: 36rpx;
  height: 36rpx;
  padding: 0 10rpx;
  background: #FA5151;
  color: #fff;
  font-size: 22rpx;
  line-height: 36rpx;
  text-align: center;
  border-radius: 999rpx;
  font-weight: 600;
  box-shadow: 0 2rpx 6rpx rgba(250, 81, 81, 0.3);
}

.session-info {
  flex: 1;
  min-width: 0;
  height: 96rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding: 4rpx 0;
}

.session-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.session-name-row {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
}

.session-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #191919;
  max-width: 240rpx;
}

.session-title {
  font-size: 24rpx;
  color: var(--wechat-text2);
  margin-left: 4rpx;
  max-width: 200rpx;
}

.session-time {
  font-size: 22rpx;
  color: var(--wechat-text2);
  flex-shrink: 0;
  margin-left: 12rpx;
}

.session-preview {
  font-size: 26rpx;
  color: var(--wechat-text2);
  line-height: 1.4;
  max-width: 100%;
}

.list-footer {
  padding: 40rpx 24rpx 60rpx;
  display: flex;
  justify-content: center;
}

.footer-text {
  font-size: 22rpx;
  color: #ccc;
}
