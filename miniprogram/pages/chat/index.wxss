page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background-color: #fcf9f2;
}

.chat-list-page {
  flex: 1;
  display: flex;
  flex-direction: column;
  padding-bottom: calc(110rpx + env(safe-area-inset-bottom));
  overflow-y: auto;
  background-color: #fcf9f2;
}

.nav-actions {
  display: flex;
  align-items: center;
  padding: 0 20rpx;
  height: 100%;
}

.nav-action-icon {
  font-size: 40rpx;
}

.search-wrap {
  padding: 16rpx 32rpx;
  background-color: #fcf9f2;
}

.search-bar {
  display: flex;
  align-items: center;
  height: 68rpx;
  background: #ffffff;
  border-radius: 8rpx;
  padding: 0 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.03);
}

.search-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
  opacity: 0.5;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  height: 100%;
  color: #191919;
}

.search-clear {
  font-size: 28rpx;
  padding: 0 8rpx;
  color: #999;
}

.loading-wrap {
  padding: 200rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.loading-dots .dot {
  display: inline-block;
  font-size: 48rpx;
  animation: dotBounce 1.4s infinite;
  color: var(--wechat-green);
}
.loading-dots .dot:nth-child(2) { animation-delay: 0.2s; }
.loading-dots .dot:nth-child(3) { animation-delay: 0.4s; }

@keyframes dotBounce {
  0%, 60%, 100% { transform: translateY(0); opacity: 0.4; }
  30% { transform: translateY(-12rpx); opacity: 1; }
}

.loading-text {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #bbbbbb;
}

.empty-wrap {
  padding: 200rpx 60rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.empty-icon {
  font-size: 120rpx;
  opacity: 0.3;
  margin-bottom: 32rpx;
}

.empty-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #191919;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #999999;
  line-height: 1.6;
  margin-bottom: 48rpx;
}

.empty-btn {
  padding: 16rpx 64rpx !important;
  border-radius: 999rpx !important;
}

.session-list {
  background-color: #ffffff;
  flex: 1;
}

.session-item {
  display: flex;
  align-items: center;
  background-color: #ffffff;
  padding-left: 32rpx;
  transition: background 0.15s;
}

.session-hover {
  background-color: #f5f5f5;
}

.avatar-wrap {
  position: relative;
  width: 96rpx;
  height: 96rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  margin-top: 24rpx;
  margin-bottom: 24rpx;
}

.avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 12rpx;
  background-color: #f0e6d6;
  overflow: hidden;
}

.unread-badge {
  position: absolute;
  top: -6rpx;
  right: -6rpx;
  min-width: 36rpx;
  height: 36rpx;
  padding: 0 10rpx;
  background: #FA5151;
  color: #fff;
  font-size: 22rpx;
  line-height: 36rpx;
  text-align: center;
  border-radius: 999rpx;
  font-weight: 600;
  box-shadow: 0 2rpx 6rpx rgba(250, 81, 81, 0.3);
  z-index: 10;
  border: 3rpx solid #ffffff;
}

.session-info {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  height: 96rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding: 4rpx 32rpx 4rpx 0;
  border-bottom: 1rpx solid #eeeeee;
}

.session-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
  width: 100%;
}

.session-name-row {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  overflow: hidden;
}

.session-name {
  font-size: 34rpx;
  color: #333333;
  font-weight: 500;
  max-width: 240rpx;
}

.session-title {
  font-size: 24rpx;
  color: #999999;
  margin-left: 4rpx;
  max-width: 200rpx;
  background-color: #f5f5f5;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  border: 1rpx solid #eeeeee;
}

.session-time {
  font-size: 24rpx;
  color: #bbbbbb;
  flex-shrink: 0;
  margin-left: 12rpx;
}

.session-preview {
  display: block;
  width: 100%;
  font-size: 26rpx;
  color: #999999;
  text-overflow: ellipsis;
  overflow: hidden;
  white-space: nowrap;
  line-height: 1.4;
  max-width: 100%;
}

.list-footer {
  padding: 40rpx 24rpx 60rpx;
  display: flex;
  justify-content: center;
  background-color: #ffffff;
}

.footer-text {
  font-size: 22rpx;
  color: #ccc;
}
