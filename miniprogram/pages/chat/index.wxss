page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background-color: #ededed;
}

.chat-list-page {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-height: 0;
  overflow: hidden;
  background-color: #ededed;
}

.nav-actions {
  display: flex;
  align-items: center;
  padding: 0 20rpx;
  height: 100%;
}

.nav-action-icon {
  font-size: 40rpx;
}

.search-wrap {
  padding: 16rpx 32rpx;
  background-color: #ededed;
  flex-shrink: 0;
}

.search-bar {
  display: flex;
  align-items: center;
  height: 68rpx;
  background: #ffffff;
  border-radius: 10rpx;
  padding: 0 24rpx;
}

.search-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
  opacity: 0.5;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  height: 100%;
  color: #191919;
}

.search-clear {
  font-size: 28rpx;
  padding: 0 8rpx;
  color: #999;
}

.loading-wrap {
  padding: 200rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.loading-dots .dot {
  display: inline-block;
  font-size: 48rpx;
  animation: dotBounce 1.4s infinite;
  color: #07c160;
}
.loading-dots .dot:nth-child(2) { animation-delay: 0.2s; }
.loading-dots .dot:nth-child(3) { animation-delay: 0.4s; }

@keyframes dotBounce {
  0%, 60%, 100% { transform: translateY(0); opacity: 0.4; }
  30% { transform: translateY(-12rpx); opacity: 1; }
}

.loading-text {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #bbbbbb;
}

.empty-wrap {
  padding: 200rpx 60rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.empty-icon {
  font-size: 120rpx;
  opacity: 0.3;
  margin-bottom: 32rpx;
}

.empty-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #191919;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #999999;
  line-height: 1.6;
  margin-bottom: 48rpx;
}

.empty-btn {
  padding: 16rpx 64rpx !important;
  border-radius: 999rpx !important;
}

.session-list {
  background-color: #ffffff;
  flex: 1;
  min-height: 0;
}

.session-item {
  display: flex;
  align-items: center;
  background-color: #ffffff;
  padding-left: 32rpx;
}

.session-item:active {
  background-color: #f5f5f5;
}

.session-hover {
  background-color: #f5f5f5;
}

.avatar-wrap {
  position: relative;
  width: 88rpx;
  height: 88rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 12rpx;
  background-color: #f0e6d6;
  overflow: hidden;
  display: block;
}

.unread-badge {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 8rpx;
  background: #fa5151;
  color: #fff;
  font-size: 22rpx;
  line-height: 32rpx;
  text-align: center;
  border-radius: 16rpx;
  font-weight: 500;
  z-index: 10;
  border: 4rpx solid #ffffff;
  box-sizing: border-box;
}

/* P1：青月异步消息 processing 状态指示器 */
.typing-dot {
  position: absolute;
  bottom: -4rpx;
  right: -4rpx;
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  background: #07c160;
  border: 4rpx solid #ffffff;
  box-sizing: border-box;
  z-index: 10;
  animation: typing-pulse 1.2s ease-in-out infinite;
}

@keyframes typing-pulse {
  0%, 100% { opacity: 0.6; transform: scale(0.9); }
  50% { opacity: 1; transform: scale(1.1); }
}

.preview-typing {
  color: #07c160;
}

.session-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 24rpx 32rpx 24rpx 0;
  border-bottom: 1rpx solid #e5e5e5;
  overflow: hidden;
}

.session-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
  width: 100%;
}

.session-name-row {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  overflow: hidden;
}

.session-name {
  font-size: 32rpx;
  color: #191919;
  font-weight: 500;
  flex-shrink: 0;
  max-width: 280rpx;
}

.session-title {
  font-size: 24rpx;
  color: #999999;
  margin-left: 8rpx;
  flex-shrink: 0;
  max-width: 240rpx;
}

.session-time {
  font-size: 24rpx;
  color: #b2b2b2;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.session-preview {
  display: block;
  width: 100%;
  font-size: 28rpx;
  color: #999999;
  text-overflow: ellipsis;
  overflow: hidden;
  white-space: nowrap;
  line-height: 1.4;
}

.list-footer {
  padding: 32rpx 24rpx;
  display: flex;
  justify-content: center;
  background-color: #ffffff;
  flex-shrink: 0;
}

.footer-text {
  font-size: 22rpx;
  color: #ccc;
}

.ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
