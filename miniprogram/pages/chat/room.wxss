.room-page {
  background: #EDEDED;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

.msg-scroll {
  flex: 1;
  height: calc(100vh - 140rpx - 80rpx);
}

.messages-wrap {
  padding: 32rpx 24rpx 0;
}

.empty-tip {
  padding: 80rpx 0;
  display: flex;
  justify-content: center;
}

.empty-tip-text {
  font-size: 26rpx;
  color: #aaa;
  background: rgba(0, 0, 0, 0.04);
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
}

.msg-row {
  display: flex;
  align-items: flex-start;
  margin-bottom: 36rpx;
  max-width: 100%;
}

.msg-row.is-right {
  flex-direction: row-reverse;
}

.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 12rpx;
  background: #fff;
  flex-shrink: 0;
  overflow: hidden;
  border: 1rpx solid rgba(0, 0, 0, 0.05);
}

.avatar-user {
  background: var(--wechat-green);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 600;
  border-radius: 12rpx;
}

.bubble-wrap {
  max-width: 72%;
  margin: 0 16rpx;
}

.bubble {
  position: relative;
  padding: 20rpx 24rpx;
  font-size: 30rpx;
  line-height: 1.6;
  word-break: break-all;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.bubble-figure {
  background:
    radial-gradient(ellipse at top left, rgba(201, 162, 77, 0.06) 0%, transparent 60%),
    linear-gradient(135deg, #FFF9F0 0%, #FFF3DE 100%);
  color: #2D1810;
  font-family: 'Noto Serif SC', 'PingFang SC', serif;
  border: 1rpx solid rgba(201, 162, 77, 0.2);
  border-top-left-radius: 4rpx;
}

.bubble-user {
  background: var(--wechat-green);
  color: #fff;
  border-top-right-radius: 4rpx;
}

.bubble-user .bubble-text {
  color: #fff;
}

.bubble-typing {
  padding: 20rpx 28rpx;
  min-width: 120rpx;
}

.typing-dots .d {
  display: inline-block;
  font-size: 16rpx;
  margin-right: 4rpx;
  color: var(--ancient-gold);
  opacity: 0.3;
  animation: typingDot 1.2s infinite;
}
.typing-dots .d:nth-child(2) { animation-delay: 0.2s; }
.typing-dots .d:nth-child(3) { animation-delay: 0.4s; margin-right: 0; }

@keyframes typingDot {
  0%, 60%, 100% { opacity: 0.3; transform: translateY(0); }
  30% { opacity: 1; transform: translateY(-6rpx); }
}

.typing-cursor {
  display: inline-block;
  font-size: 28rpx;
  color: var(--ancient-ink);
  margin-left: 2rpx;
  animation: cursorBlink 0.9s step-end infinite;
}
.bubble-user .typing-cursor { color: rgba(255, 255, 255, 0.7); }

@keyframes cursorBlink {
  50% { opacity: 0; }
}

.msg-bottom-sentry {
  height: 10rpx;
}

.quick-bar {
  position: absolute;
  bottom: 140rpx;
  left: 0;
  right: 0;
  background: transparent;
  padding: 8rpx 0 8rpx 24rpx;
  z-index: 10;
  pointer-events: none;
}

.quick-scroll {
  white-space: nowrap;
  pointer-events: auto;
}

.quick-item {
  display: inline-flex;
  align-items: center;
  padding: 12rpx 24rpx;
  margin-right: 16rpx;
  background: rgba(255, 255, 255, 0.95);
  color: var(--ancient-wood);
  font-size: 24rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(201, 162, 77, 0.3);
  backdrop-filter: blur(4rpx);
}

.quick-item:active {
  background: var(--ancient-paper);
  transform: scale(0.97);
}

.input-bar-wrap {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #F7F7F7;
  border-top: 1rpx solid rgba(0, 0, 0, 0.06);
  z-index: 100;
  padding-top: 16rpx;
}

.input-bar {
  display: flex;
  align-items: center;
  padding: 0 24rpx;
}

.msg-input {
  flex: 1;
  height: 76rpx;
  background: #fff;
  border-radius: 8rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  color: #191919;
}

.send-btn {
  margin-left: 16rpx !important;
  height: 76rpx;
  padding: 0 36rpx !important;
  line-height: 76rpx !important;
  font-size: 28rpx !important;
  background: #ccc !important;
  color: #fff !important;
  border-radius: 8rpx !important;
  border: none !important;
  transition: background 0.2s;
}

.send-btn::after { border: none; }

.send-btn.is-active {
  background: var(--wechat-green) !important;
}
.send-btn[disabled] {
  opacity: 0.6;
}
