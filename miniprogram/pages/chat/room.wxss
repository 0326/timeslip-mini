.room-page {
  background: #f3f3f3;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  position: relative;
  overflow: hidden;
}

.msg-scroll.main {
  background-color: #f3f3f3;
  flex: 1;
  width: 100%;
  min-height: 0;
  position: relative;
  height: 0;
}

.contentBox {
  padding: 32rpx 0 0;
}

.empty-tip {
  padding: 80rpx 0;
  display: flex;
  justify-content: center;
}

.empty-tip-text {
  font-size: 26rpx;
  color: #aaa;
  background: rgba(0, 0, 0, 0.04);
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
}

.msg-row {
  position: relative;
  padding-bottom: 8rpx;
}

/* ============ AI 消息（左侧） ============ */
.system {
  margin-left: 20rpx;
  margin-right: 24rpx;
  margin-top: 24rpx;
  box-sizing: border-box;
}

.avatar-left {
  position: absolute;
  top: 0px;
  left: 12rpx;
}

.avatar-left .avatar-img {
  width: 80rpx;
  height: 80rpx;
  border-radius: 8rpx;
  background: #fff;
  overflow: hidden;
  border: 1rpx solid rgba(0, 0, 0, 0.05);
  display: block;
}

.system_bubble {
  background-color: #ffffff;
  border-radius: 12rpx;
  padding: 16rpx 24rpx;
  margin-left: 110rpx;
  position: relative;
  word-wrap: break-word;
  word-break: break-all;
  font-size: 30rpx;
  line-height: 1.5;
  min-height: 40rpx;
  box-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.05);
}

.system_bubble::before {
  content: '';
  position: absolute;
  top: 20rpx;
  left: -12rpx;
  width: 0;
  height: 0;
  border-top: 10rpx solid transparent;
  border-bottom: 10rpx solid transparent;
  border-right: 12rpx solid #ffffff;
}

.thinking-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 30rpx;
  line-height: 1.8;
  color: #333;
}

.thinking-icon {
  font-size: 32rpx;
}

.thinking-text {
  color: #555;
}

.bubble-text {
  font-size: 30rpx;
  line-height: 1.6;
  word-break: break-all;
  white-space: pre-wrap;
}

/* ============ 用户消息（右侧） ============ */
.userContent {
  margin-top: 24rpx;
  position: relative;
  padding-right: 24rpx;
}

.user {
  display: flex;
  justify-content: flex-end;
  margin-right: 20rpx;
  position: relative;
}

.user .user_content {
  background-color: #95ec69;
  border-radius: 12rpx;
  margin-right: 110rpx;
  padding: 16rpx 24rpx;
  word-wrap: break-word;
  word-break: break-all;
  font-size: 30rpx;
  line-height: 1.5;
  position: relative;
  box-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.05);
}

.user .user_content::after {
  content: '';
  position: absolute;
  top: 20rpx;
  right: -12rpx;
  width: 0;
  height: 0;
  border-top: 10rpx solid transparent;
  border-bottom: 10rpx solid transparent;
  border-left: 12rpx solid #95ec69;
}

.avatar-right {
  position: absolute;
  top: 0px;
  right: 12rpx;
}

.avatar-right .avatar-user {
  width: 80rpx;
  height: 80rpx;
  border-radius: 8rpx;
  background: var(--wechat-green);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 600;
  box-sizing: border-box;
  line-height: 80rpx;
  text-align: center;
}

/* ============ 正在输入动效 ============ */
.bubble-typing {
  padding: 20rpx 28rpx;
  min-width: 120rpx;
}

.typing-dots .d {
  display: inline-block;
  font-size: 16rpx;
  margin-right: 4rpx;
  color: var(--ancient-gold);
  opacity: 0.3;
  animation: typingDot 1.2s infinite;
}
.typing-dots .d:nth-child(2) { animation-delay: 0.2s; }
.typing-dots .d:nth-child(3) { animation-delay: 0.4s; margin-right: 0; }

@keyframes typingDot {
  0%, 60%, 100% { opacity: 0.3; transform: translateY(0); }
  30% { opacity: 1; transform: translateY(-6rpx); }
}

.typing-cursor {
  display: inline-block;
  font-size: 28rpx;
  color: var(--ancient-ink);
  margin-left: 2rpx;
  animation: cursorBlink 0.9s step-end infinite;
}

@keyframes cursorBlink {
  50% { opacity: 0; }
}

.msg-bottom-sentry {
  height: 10rpx;
}

/* ============ 滚动到底按钮 ============ */
.to-bottom-btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  position: fixed;
  bottom: 260rpx;
  right: 40rpx;
  padding: 10rpx;
  background-color: white;
  box-shadow: rgba(99, 99, 99, 0.2) 0px 4rpx 16rpx 0px;
  z-index: 50;
}

/* ============ 底部输入区域 ============ */
.footer {
  width: 100%;
  min-height: 130rpx;
  max-height: 760rpx;
  flex-shrink: 0;
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  padding: 0 16rpx 24rpx;
  box-sizing: border-box;
  background-color: #f7f7f7;
}

.tool_box {
  display: flex;
  flex-direction: row;
  box-sizing: border-box;
  gap: 20rpx;
  justify-content: flex-start;
  overflow-x: scroll;
  padding: 20rpx 0rpx 0rpx;
}

.function {
  display: flex;
  width: 150rpx;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  gap: 8rpx;
  background-color: #f3f4f6;
  color: black;
  padding: 24rpx 12rpx;
  border-radius: 32rpx;
}

.tool-icon {
  font-size: 40rpx;
}

.text_desc {
  font-weight: 300;
  font-size: 24rpx;
  color: rgb(95, 114, 146);
}

.foot_function {
  width: 100%;
  overflow: hidden;
}

.input_box {
  display: flex;
  align-items: flex-end;
  flex-direction: row;
  gap: 20rpx;
  position: relative;
  min-height: 80rpx;
  padding: 12rpx 0rpx;
  background-color: #f7f7f7;
}

.set {
  width: 58rpx;
  height: 58rpx;
  padding: 6rpx;
  box-sizing: border-box;
  flex-shrink: 0;
}

.send-set {
  width: 38rpx;
  height: 38rpx;
  flex-shrink: 0;
}

.input_inner_box {
  flex: 1;
  width: 100%;
  min-height: 88rpx;
  display: flex;
  align-items: center;
  border: none;
  border-radius: 12rpx;
  box-sizing: border-box;
  background-color: #ffffff;
  padding: 0 20rpx;
}

.input {
  padding: 16rpx 0;
  color: #333;
  width: 100%;
  flex: 1;
  max-height: 320rpx;
  font-size: 32rpx;
  line-height: 1.5;
}

.right_btns {
  height: 100rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex-shrink: 0;
}

.send-btn-wrap {
  display: flex;
  justify-content: center;
  align-items: center;
  background-color: #07c160;
  border-radius: 12rpx;
  width: 76rpx;
  height: 76rpx;
  flex-shrink: 0;
  padding: 19rpx;
  box-sizing: border-box;
}

.send-btn-wrap:active {
  opacity: 0.85;
  transform: scale(0.97);
}
