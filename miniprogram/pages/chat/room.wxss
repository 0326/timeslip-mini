page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background-color: #ededed;
}

.room-page {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-height: 0;
  overflow: hidden;
  background-color: #ededed;
  position: relative;
}

.msg-scroll.main {
  background-color: #ededed;
  flex: 1;
  width: 100%;
  min-height: 0;
  position: relative;
  height: 0;
}

.contentBox {
  padding: 24rpx 0 16rpx;
}

.empty-tip {
  padding: 80rpx 0;
  display: flex;
  justify-content: center;
}

.empty-tip-text {
  font-size: 26rpx;
  color: #aaa;
  background: rgba(0, 0, 0, 0.04);
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
}

.msg-row {
  position: relative;
  padding-bottom: 8rpx;
}

/* ============ AI 消息（左侧） ============ */
.system {
  margin-left: 20rpx;
  margin-right: 24rpx;
  margin-top: 24rpx;
  box-sizing: border-box;
}

.avatar-left {
  position: absolute;
  top: 0px;
  left: 12rpx;
  cursor: pointer;
}

.avatar-left .avatar-img {
  width: 80rpx;
  height: 80rpx;
  border-radius: 8rpx;
  background: #fff;
  overflow: hidden;
  border: 1rpx solid rgba(0, 0, 0, 0.05);
  display: block;
}

.system_bubble {
  background-color: #ffffff;
  border-radius: 12rpx;
  padding: 18rpx 24rpx;
  margin-left: 110rpx;
  position: relative;
  word-wrap: break-word;
  word-break: break-all;
  font-size: 30rpx;
  line-height: 1.55;
  min-height: 40rpx;
  box-shadow: 0 1rpx 2rpx rgba(0, 0, 0, 0.04);
}

.system_bubble::before {
  content: '';
  position: absolute;
  top: 22rpx;
  left: -12rpx;
  width: 0;
  height: 0;
  border-top: 10rpx solid transparent;
  border-bottom: 10rpx solid transparent;
  border-right: 12rpx solid #ffffff;
}

.thinking-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 30rpx;
  line-height: 1.8;
  color: #333;
}

.thinking-icon {
  font-size: 32rpx;
}

.thinking-text {
  color: #555;
}

.bubble-text {
  font-size: 30rpx;
  line-height: 1.6;
  word-break: break-all;
  white-space: pre-wrap;
}

/* ============ 用户消息（右侧） ============ */
.userContent {
  margin-top: 24rpx;
  position: relative;
  padding-right: 24rpx;
}

.user {
  display: flex;
  justify-content: flex-end;
  margin-right: 20rpx;
  position: relative;
}

.user .user_content {
  background-color: #95ec69;
  border-radius: 12rpx;
  margin-right: 110rpx;
  padding: 18rpx 24rpx;
  word-wrap: break-word;
  word-break: break-all;
  font-size: 30rpx;
  line-height: 1.55;
  position: relative;
  box-shadow: 0 1rpx 2rpx rgba(0, 0, 0, 0.04);
}

.user .user_content::after {
  content: '';
  position: absolute;
  top: 22rpx;
  right: -12rpx;
  width: 0;
  height: 0;
  border-top: 10rpx solid transparent;
  border-bottom: 10rpx solid transparent;
  border-left: 12rpx solid #95ec69;
}

.avatar-right {
  position: absolute;
  top: 0px;
  right: 12rpx;
}

.avatar-right .avatar-user-img {
  width: 80rpx;
  height: 80rpx;
  border-radius: 8rpx;
  box-sizing: border-box;
  display: block;
  background: #d8d8d8;
  border: 1rpx solid rgba(0, 0, 0, 0.05);
}

/* ============ 正在输入动效 ============ */
.bubble-typing {
  padding: 20rpx 28rpx;
  min-width: 120rpx;
}

.typing-dots .d {
  display: inline-block;
  font-size: 16rpx;
  margin-right: 4rpx;
  color: #999;
  opacity: 0.3;
  animation: typingDot 1.2s infinite;
}
.typing-dots .d:nth-child(2) { animation-delay: 0.2s; }
.typing-dots .d:nth-child(3) { animation-delay: 0.4s; margin-right: 0; }

@keyframes typingDot {
  0%, 60%, 100% { opacity: 0.3; transform: translateY(0); }
  30% { opacity: 1; transform: translateY(-6rpx); }
}

.typing-cursor {
  display: inline-block;
  font-size: 28rpx;
  color: #333;
  margin-left: 2rpx;
  animation: cursorBlink 0.9s step-end infinite;
}

@keyframes cursorBlink {
  50% { opacity: 0; }
}

.msg-bottom-sentry {
  height: 10rpx;
}

/* ============ 滚动到底按钮 ============ */
.to-bottom-btn {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  position: fixed;
  bottom: 280rpx;
  right: 32rpx;
  padding: 12rpx;
  background-color: white;
  box-shadow: rgba(0, 0, 0, 0.12) 0px 4rpx 16rpx 0px;
  z-index: 50;
  box-sizing: border-box;
}

/* ============ 底部输入区域 ============ */
.chat-footer {
  width: 100%;
  flex-shrink: 0;
  position: relative;
  background-color: #f7f7f7;
  padding: 0 16rpx;
  padding-bottom: calc(env(safe-area-inset-bottom) + 12rpx);
  box-sizing: border-box;
  border-top: 1rpx solid #e5e5e5;
}

.tool_box {
  display: flex;
  flex-direction: row;
  box-sizing: border-box;
  gap: 20rpx;
  justify-content: flex-start;
  overflow-x: scroll;
  padding: 20rpx 0rpx 12rpx;
}

.function {
  display: flex;
  width: 150rpx;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  gap: 8rpx;
  background-color: #ffffff;
  color: #333;
  padding: 24rpx 12rpx;
  border-radius: 16rpx;
  border: 1rpx solid #e5e5e5;
}

.tool-icon {
  font-size: 40rpx;
}

.text_desc {
  font-size: 24rpx;
  color: #999;
}

.input_box {
  display: flex;
  align-items: flex-end;
  flex-direction: row;
  gap: 12rpx;
  position: relative;
  padding: 12rpx 0 10rpx;
  background-color: #f7f7f7;
}

.set {
  width: 52rpx;
  height: 52rpx;
  flex-shrink: 0;
}

.icon-btn {
  width: 64rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.input_inner_box {
  flex: 1;
  min-width: 0;
  min-height: 72rpx;
  max-height: 220rpx;
  display: flex;
  align-items: flex-start;
  border-radius: 8rpx;
  box-sizing: border-box;
  background-color: #ffffff;
  padding: 14rpx 22rpx;
  border: 1rpx solid #e5e5e5;
  overflow: hidden;
}

.input {
  padding: 0;
  color: #191919;
  width: 100%;
  flex: 1;
  min-height: 44rpx;
  max-height: 180rpx;
  font-size: 30rpx;
  line-height: 44rpx;
}

.send-btn {
  width: 96rpx !important;
  height: 72rpx;
  line-height: 72rpx;
  padding: 0 !important;
  margin: 0 !important;
  border-radius: 8rpx;
  background: #07c160;
  color: #fff;
  font-size: 28rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.send-btn::after {
  border: none;
}

.send-btn:active,
.icon-btn:active {
  opacity: 0.85;
  transform: scale(0.97);
}
.retry-btn {
  display: inline-block;
  margin: 12rpx 0 0;
  padding: 0 18rpx;
  height: 52rpx;
  line-height: 52rpx;
  font-size: 24rpx;
  color: #576b95;
  background: #fff;
  border: 1rpx solid #d9d9d9;
  border-radius: 26rpx;
}
