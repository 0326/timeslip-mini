<view class="page">
  <custom-nav-bar title="书信驿站" show-back="{{true}}" />

  <view class="container">
    <view class="upgrade-card">
      <view class="upgrade-icon">📜</view>
      <view class="upgrade-title">信件系统已升级为「雁书」</view>
      <view class="upgrade-desc">新系统支持三位专属信使、沿途风物掉落、更多历史人物专属回信。旧版飞鸽书信不再展示。</view>
      <view class="upgrade-actions">
        <button class="upgrade-btn primary" bindtap="goRecords">查看我的书信</button>
        <button class="upgrade-btn ghost" bindtap="goWrite">去写一封信</button>
      </view>
    </view>
  </view>
</view>
