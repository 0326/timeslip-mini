<view class="page">
  <custom-nav-bar title="信鸽驿站" show-back="{{true}}" />

  <view class="container">
    <view class="stats-bar">
      <view class="stat-item">
        <view class="num">{{totalCount}}</view>
        <view class="label">往来书信</view>
      </view>
      <view class="stat-item">
        <view class="num">{{figuresCount}}</view>
        <view class="label">通信人物</view>
      </view>
      <view class="stat-item">
        <view class="num">{{firstDate}}</view>
        <view class="label">首封日期</view>
      </view>
    </view>

    <view class="filter-bar">
      <view
        class="filter-item {{filter === item.key ? 'active' : ''}}"
        wx:for="{{filterList}}"
        wx:for-item="item"
        wx:key="key"
        data-key="{{item.key}}"
        bindtap="selectFilter"
      >
        {{item.name}}
      </view>
    </view>

    <view class="letter-list" wx:if="{{filteredLetters.length}}">
      <view
        class="letter-card {{item.expanded ? 'expanded' : ''}}"
        wx:for="{{filteredLetters}}"
        wx:key="_id"
        data-id="{{item._id}}"
      >
        <view class="lc-header" bindtap="toggleExpand" data-id="{{item._id}}">
          <figure-avatar figure="{{item}}" size="md" />
          <view class="lc-meta">
            <view class="lc-name">{{item.figureName}} · {{item.figureTitle}}</view>
            <view class="lc-time">{{item.displayTime}}</view>
          </view>
          <view class="lc-arrow">{{item.expanded ? '⌄' : '›'}}</view>
        </view>

        <view class="lc-body" wx:if="{{item.expanded}}">
          <view class="lc-section">
            <view class="lc-label">你的去信</view>
            <view class="lc-content my-content">{{item.content}}</view>
          </view>
          <view class="lc-divider">— 回 —</view>
          <view class="lc-section">
            <view class="lc-label">{{item.figureName}}的回信</view>
            <view class="lc-content reply-content">{{item.replyContent}}</view>
          </view>
          <view class="lc-actions">
            <view class="lc-action" bindtap="writeAgain" data-figure="{{item}}">✍️ 再写一封</view>
            <view class="lc-action" bindtap="deleteLetter" data-id="{{item._id}}">🗑️ 删除</view>
          </view>
        </view>
      </view>
    </view>

    <view class="empty" wx:else>
      <view class="empty-icon">🕊️</view>
      <view class="empty-title">暂无往来书信</view>
      <view class="empty-sub">去飞鸽传书，写一封信给历史人物吧</view>
      <button class="btn-go" bindtap="goPigeon">去写信</button>
    </view>
  </view>
</view>
