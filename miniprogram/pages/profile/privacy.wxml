<view class="page">
  <custom-nav-bar title="隐私与协议" show-back="{{true}}" />

  <view class="tab-bar">
    <view class="tab {{currentTab === 'privacy' ? 'active' : ''}}" data-tab="privacy" bindtap="switchTab">隐私政策</view>
    <view class="tab {{currentTab === 'agreement' ? 'active' : ''}}" data-tab="agreement" bindtap="switchTab">用户协议</view>
  </view>

  <scroll-view scroll-y class="content-scroll">
    <block wx:if="{{currentTab === 'privacy'}}">
      <view wx:for="{{privacySections}}" wx:key="index" class="section">
        <view class="section-title">{{item.title}}</view>
        <view class="section-content">{{item.content}}</view>
      </view>
    </block>
    <block wx:else>
      <view wx:for="{{agreementSections}}" wx:key="index" class="section">
        <view class="section-title">{{item.title}}</view>
        <view class="section-content">{{item.content}}</view>
      </view>
    </block>
    <view class="bottom-space"></view>
  </scroll-view>
</view>
