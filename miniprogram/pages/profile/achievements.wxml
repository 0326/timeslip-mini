<view class="page">
  <custom-nav-bar title="穿越成就" show-back="{{true}}" />

  <!-- ===== 骨架屏 ===== -->
  <block wx:if="{{loading}}">
    <view class="hero">
      <view class="hero-bg-css"></view>
      <view class="hero-content">
        <view class="sk-num"></view>
        <view class="sk-label"></view>
        <view class="sk-progress"><view class="sk-progress-bar"></view></view>
      </view>
    </view>
    <view class="container">
      <view class="category" wx:for="{{[0,1,2,3]}}" wx:key="*this">
        <view class="cat-header">
          <view class="sk-cat-title"></view>
          <view class="sk-cat-progress"></view>
        </view>
        <view class="card-grid">
          <view class="ach-card sk-card" wx:for="{{[0,1,2,3,4,5]}}" wx:for-item="card" wx:key="*this">
            <view class="sk-icon"></view>
            <view class="sk-name"></view>
            <view class="sk-desc"></view>
          </view>
        </view>
      </view>
    </view>
  </block>

  <!-- ===== 真实内容 ===== -->
  <block wx:else>
    <!-- Hero Banner -->
    <view class="hero">
      <view class="hero-bg-css"></view>
      <view class="hero-deco-left"></view>
      <view class="hero-deco-right"></view>
      <view class="hero-content">
        <view class="hero-title">穿越成就</view>
        <view class="unlock-count">
          <text class="num">{{unlockedCount}}</text>
          <text class="sep">/</text>
          <text class="total">{{totalCount}}</text>
        </view>
        <view class="hero-label">已解锁成就</view>
        <view class="progress-wrap">
          <view class="progress-bar">
            <view class="progress-fill" style="width: {{progressPercent}}%"></view>
          </view>
          <view class="progress-text">{{progressPercent}}% 完成度</view>
        </view>
      </view>
    </view>

    <!-- 成就分类 -->
    <view class="container">
      <view class="category" wx:for="{{categories}}" wx:for-item="cat" wx:key="key">
        <view class="cat-header">
          <view class="cat-title-wrap">
            <view class="cat-badge cat-badge-{{cat.key}}">{{cat.icon}}</view>
            <view class="cat-title">{{cat.title}}</view>
          </view>
          <view class="cat-progress">{{cat.progress}}</view>
        </view>
        <view class="card-grid">
          <view
            class="ach-card rarity-{{item.rarity}} {{item.unlocked ? 'unlocked' : 'locked'}}"
            wx:for="{{cat.items}}"
            wx:for-item="item"
            wx:key="key"
            data-item="{{item}}"
            bindtap="showDetail"
          >
            <view class="ach-icon-box {{item.unlocked ? '' : 'icon-locked'}}">
              <image class="ach-icon-img" src="{{item.iconUrl}}" mode="aspectFit" lazy-load="{{true}}" />
            </view>
            <view class="ach-name">{{item.name}}</view>
            <view class="ach-rarity rarity-text-{{item.rarity}}">{{item.rarityLabel}}</view>
            <view class="ach-lock" wx:if="{{!item.unlocked}}">🔒</view>
          </view>
        </view>
      </view>
    </view>
  </block>

  <!-- ===== 详情弹窗 ===== -->
  <view class="detail-mask" wx:if="{{showModal}}" bindtap="closeModal">
    <view class="detail-modal {{showModal && detailData ? 'show' : ''}}" catchtap="stopProp">
      <view class="dm-unlock-time" wx:if="{{detailData.unlockTime}}">{{detailData.unlockTime}}</view>
      <view class="dm-top-bar">
        <view class="dm-tag dm-tag-rarity rarity-{{detailData.rarity}}">{{detailData.rarityLabel}}</view>
        <view class="dm-tag dm-tag-status {{detailData.unlocked ? 'status-unlocked' : 'status-locked'}}">
          <block wx:if="{{detailData.unlocked}}">已解锁</block>
          <block wx:else>未解锁</block>
        </view>
      </view>
      <view class="dm-hero">
        <view class="dm-icon-wrap">
          <image class="dm-icon-img" src="{{detailData.iconUrl}}" mode="aspectFit" lazy-load="{{true}}" />
          <view class="dm-reward-overlay" wx:if="{{detailData.reward}}">{{detailData.reward}}</view>
        </view>
        <view class="dm-name">{{detailData.name}}</view>
      </view>
      <view class="dm-body">
        <view class="dm-text">{{detailData.desc}}</view>
        <view class="dm-text" wx:if="{{detailData.unlockCondition}}">{{detailData.unlockCondition}}</view>
        <button class="dm-close" bindtap="closeModal">知道了</button>
      </view>
    </view>
  </view>
</view>
