<view class="profile-page">
  <view class="profile-hero ancient-paper" style="padding-top: {{statusBarHeight + 40}}rpx;">
    <view class="hero-inner">
      <view class="user-avatar-row" bindtap="onEditAvatar">
        <view class="avatar-big-wrap">
          <view class="avatar-big">
            <image
              wx:if="{{userInfo.avatarUrl}}"
              class="avatar-img"
              src="{{userInfo.avatarUrl}}"
              mode="aspectFill"
            />
            <view wx:else class="avatar-fallback">👤</view>
          </view>
          <view class="avatar-edit iconfont icon-edit"></view>
        </view>
        <view class="user-meta">
          <view class="user-name-row">
            <text class="u-name">{{userInfo.nickName || '穿越客'}}</text>
          </view>
          <view class="user-id-row">
            <text class="u-crossno">穿越编号：{{userInfo.crossNo || '--'}}</text>
            <view class="seal" wx:if="{{userInfo.memberLevel}}">{{userInfo.memberLevel || '布衣'}}</view>
          </view>
          <view class="u-points">
            <text class="p-icon">✨</text>
            <text class="p-text">{{userInfo.points || 0}} 穿越积分</text>
          </view>
        </view>
      </view>

      <view class="stats-grid">
        <view wx:for="{{stats}}" wx:key="key" class="stat-card">
          <text class="iconfont s-icon icon-{{item.iconClass}}"></text>
          <text class="s-num">{{item.num}}</text>
          <text class="s-label">{{item.label}}</text>
        </view>
      </view>
    </view>
  </view>

  <view class="section-title" wx:if="{{isAdmin}}">
    <text class="st-line"></text>
    <text class="st-text">管理员</text>
    <text class="st-line"></text>
  </view>

  <view class="menu-group card" wx:if="{{isAdmin}}">
    <view
      class="menu-item"
      data-url="/pages/admin/video-manage/index"
      bindtap="onMenuTap"
      hover-class="menu-hover"
    >
      <text class="iconfont m-icon icon-shipinhao" style="color:#FA5151;"></text>
      <view class="m-text">
        <text class="m-name">视频管理</text>
        <text class="m-desc">视频号内容管理</text>
      </view>
      <text class="iconfont m-arrow icon-right"></text>
    </view>
  </view>

  <view class="section-title">
    <text class="st-line"></text>
    <text class="st-text">功能菜单</text>
    <text class="st-line"></text>
  </view>

  <view class="menu-group card">
    <view
      wx:for="{{menus}}"
      wx:key="key"
      class="menu-item"
      data-url="{{item.url}}"
      bindtap="onMenuTap"
      hover-class="menu-hover"
    >
      <text class="iconfont m-icon icon-{{item.iconClass}}"></text>
      <view class="m-text">
        <text class="m-name">{{item.name}}</text>
        <text class="m-desc">{{item.desc}}</text>
      </view>
      <text class="iconfont m-arrow icon-right"></text>
    </view>
  </view>

  <view class="about-row">
    <text class="a-title">穿越圈 v1.0.0</text>
  </view>

  <view class="bottom-pad"></view>
</view>
