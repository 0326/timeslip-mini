<view class="profile-page">
  <!-- ★ 访客模式：顶部绑定微信提示条（浅橙底，配合浅古风纸张色） -->
  <view class="visitor-tip-banner" wx:if="{{isVisitor}}" bindtap="doBindWx">
    <view class="vt-inner">
      <text class="vt-icon">🔒</text>
      <text class="vt-text">{{bindTip}}</text>
      <text class="vt-btn">绑定微信 ›</text>
    </view>
  </view>

  <view class="profile-hero ancient-paper" style="padding-top: {{statusBarHeight + 40}}rpx;">
    <view class="hero-inner">
      <view class="user-avatar-row" bindtap="onEditAvatar">
        <view class="avatar-big-wrap">
          <view class="avatar-big">
            <image
              class="avatar-img"
              src="{{avatarSrc}}"
              mode="aspectFill"
              binderror="onAvatarError"
            />
            <view wx:if="{{isVisitor}}" class="visitor-badge">游客</view>
          </view>
        </view>
        <view class="user-meta">
          <view class="user-name-row">
            <text class="u-name">{{userInfo.nickName || '穿越客'}}</text>
          </view>
          <view class="user-id-row">
            <text class="u-crossno">穿越编号：{{userInfo.crossNo || localCrossNo || '--'}}</text>
          </view>
          <view class="u-points">
            <text class="p-icon">✨</text>
            <text class="p-text">{{userInfo.points || 0}} 穿越积分</text>
          </view>
          <view wx:if="{{isVisitor}}" class="bind-wx-btn" catchtap="doBindWx">
            <text class="bw-icon">✓</text>
            <text class="bw-text">绑定微信同步数据</text>
          </view>
        </view>
      </view>

    </view>
  </view>

  <view class="menu-group card" wx:if="{{isAdmin}}">
    <view
      class="menu-item"
      data-url="/pages/admin/video-manage/index"
      bindtap="onMenuTap"
      hover-class="menu-hover"
    >
      <text class="iconfont m-icon icon-shipinhao" style="color:#FA5151;"></text>
      <view class="m-text">
        <text class="m-name">视频管理</text>
        <text class="m-desc">视频号内容管理</text>
      </view>
      <text class="iconfont m-arrow icon-right"></text>
    </view>
  </view>

  <view class="menu-group card">
    <view
      wx:for="{{menus}}"
      wx:key="key"
      class="menu-item"
      data-url="{{item.url}}"
      bindtap="onMenuTap"
      hover-class="menu-hover"
    >
      <text class="iconfont m-icon icon-{{item.iconClass}}" style="color:{{item.color}};"></text>
      <view class="m-text">
        <text class="m-name">{{item.name}}</text>
        <text class="m-desc">{{item.desc}}</text>
      </view>
      <text class="iconfont m-arrow icon-right"></text>
    </view>
  </view>

  <view class="about-row">
    <text class="a-title">穿越圈 {{version}}</text>
  </view>

  <view class="bottom-pad"></view>
</view>
