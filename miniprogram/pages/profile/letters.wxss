.page {
  min-height: 100vh;
  background: #ffffff;
}

.container {
  padding: 120rpx 48rpx;
  display: flex;
  justify-content: center;
}

.upgrade-card {
  width: 100%;
  background: linear-gradient(135deg, #fdf8ef 0%, #fff 60%);
  border: 1rpx solid rgba(201, 162, 77, 0.2);
  border-radius: 24rpx;
  padding: 64rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.upgrade-icon {
  font-size: 120rpx;
  margin-bottom: 24rpx;
}

.upgrade-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 20rpx;
}

.upgrade-desc {
  font-size: 28rpx;
  color: #999999;
  line-height: 1.7;
  text-align: center;
  margin-bottom: 48rpx;
  padding: 0 16rpx;
}

.upgrade-actions {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  width: 100%;
}

.upgrade-btn {
  height: 88rpx;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 500;
  line-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  padding: 0;
  margin: 0;
}

.upgrade-btn::after {
  border: none;
}

.upgrade-btn.primary {
  background: linear-gradient(135deg, #c9a24d, #a67b2d);
  color: #ffffff;
}

.upgrade-btn.primary:active {
  opacity: 0.9;
}

.upgrade-btn.ghost {
  background: #ffffff;
  color: #a67b2d;
  border: 2rpx solid #c9a24d;
}

.upgrade-btn.ghost:active {
  background: rgba(201, 162, 77, 0.04);
}
