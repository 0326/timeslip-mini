.page {
  min-height: 100vh;
  background: var(--wechat-bg);
}

.hero {
  position: relative;
  padding: 40rpx 32rpx 60rpx;
  color: #fff;
  overflow: hidden;
}
.hero-bg {
  position: absolute;
  inset: 0;
  background: linear-gradient(135deg, #2D1810 0%, #C9A24D 100%);
}
.hero-content {
  position: relative;
  z-index: 1;
  text-align: center;
}
.unlock-count {
  margin-top: 16rpx;
}
.unlock-count .num {
  font-size: 96rpx;
  font-weight: 700;
  font-family: 'Ma Shan Zheng', serif;
  color: #fff;
}
.unlock-count .sep {
  font-size: 48rpx;
  opacity: 0.5;
  margin: 0 12rpx;
}
.unlock-count .total {
  font-size: 48rpx;
  opacity: 0.7;
}
.hero-label {
  font-size: 26rpx;
  opacity: 0.85;
  margin-bottom: 28rpx;
  letter-spacing: 4rpx;
}
.progress-wrap {
  max-width: 560rpx;
  margin: 0 auto;
}
.progress-bar {
  height: 12rpx;
  background: rgba(255,255,255,0.2);
  border-radius: 999rpx;
  overflow: hidden;
}
.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #FFD700, #FFB700);
  border-radius: 999rpx;
  transition: width 0.5s ease;
}
.progress-text {
  margin-top: 12rpx;
  font-size: 22rpx;
  opacity: 0.8;
}

.container { padding: 32rpx; margin-top: -24rpx; position: relative; z-index: 2; }

.category {
  background: var(--wechat-white);
  border-radius: var(--radius-lg);
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.04);
}
.cat-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}
.cat-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ancient-ink);
}
.cat-progress {
  font-size: 22rpx;
  color: var(--ancient-gold);
  font-weight: 500;
}

.card-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.ach-card {
  width: calc(50% - 8rpx);
  padding: 24rpx 16rpx;
  border-radius: var(--radius-md);
  text-align: center;
  position: relative;
  box-sizing: border-box;
}
.ach-card.unlocked {
  background: linear-gradient(135deg, #FFF9F0 0%, #FFFBF5 100%);
  border: 2rpx solid rgba(201,162,77,0.4);
}
.ach-card.locked {
  background: #f7f7f7;
  border: 2rpx solid transparent;
  filter: grayscale(0.5);
  opacity: 0.7;
}
.ach-icon {
  font-size: 56rpx;
  margin-bottom: 12rpx;
}
.ach-name {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--wechat-text);
  margin-bottom: 6rpx;
}
.ach-desc {
  font-size: 20rpx;
  color: var(--wechat-text2);
  line-height: 1.4;
  min-height: 56rpx;
}
.ach-tag {
  margin-top: 12rpx;
  display: inline-block;
  font-size: 18rpx;
  color: var(--ancient-gold);
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(201,162,77,0.1);
}

.detail-mask {
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.5);
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 64rpx;
}
.detail-modal {
  width: 100%;
  background: var(--wechat-white);
  border-radius: 24rpx;
  overflow: hidden;
  transform: scale(0.9);
  opacity: 0;
  transition: all 0.25s ease;
}
.detail-modal.show {
  transform: scale(1);
  opacity: 1;
}
.dm-hero {
  padding: 48rpx 32rpx 40rpx;
  text-align: center;
  color: #fff;
}
.dm-hero.unlocked {
  background: linear-gradient(135deg, #C9A24D 0%, #FFD700 100%);
}
.dm-hero.locked {
  background: linear-gradient(135deg, #888 0%, #aaa 100%);
}
.dm-icon { font-size: 96rpx; margin-bottom: 16rpx; }
.dm-name {
  font-size: 36rpx;
  font-weight: 700;
  font-family: 'Ma Shan Zheng', serif;
  margin-bottom: 8rpx;
}
.dm-status {
  font-size: 24rpx;
  opacity: 0.9;
}

.dm-body { padding: 32rpx; }
.dm-section { margin-bottom: 24rpx; }
.dm-label {
  font-size: 22rpx;
  color: var(--wechat-text2);
  margin-bottom: 8rpx;
}
.dm-desc {
  font-size: 28rpx;
  color: var(--wechat-text);
  line-height: 1.7;
}
.dm-reward {
  font-size: 28rpx;
  color: var(--ancient-seal);
  font-weight: 600;
}
.dm-close {
  margin-top: 16rpx;
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: var(--ancient-ink);
  color: #fff;
  border: none;
  border-radius: var(--radius-lg);
  font-size: 30rpx;
}
