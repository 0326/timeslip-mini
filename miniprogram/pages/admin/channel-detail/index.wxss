.page {
  min-height: 100vh;
  background: #f7f7f7;
}

.loading-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.spinner {
  width: 60rpx;
  height: 60rpx;
  border: 6rpx solid rgba(0, 0, 0, 0.1);
  border-top-color: #07C160;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 20rpx;
}
@keyframes spin { to { transform: rotate(360deg); } }

.loading-text {
  font-size: 26rpx;
  color: #8e8e93;
}

/* ===== 视频号头部 ===== */
.channel-header {
  display: flex;
  align-items: center;
  background: #fff;
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.ch-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  margin-right: 24rpx;
  background: #eee;
  flex-shrink: 0;
}

.ch-meta {
  flex: 1;
  min-width: 0;
}

.ch-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #191919;
  margin-bottom: 8rpx;
}

.ch-title {
  font-size: 26rpx;
  color: #8e8e93;
  font-weight: normal;
}

.ch-stats {
  font-size: 24rpx;
  color: #8e8e93;
}

.dot {
  margin: 0 12rpx;
}

/* ===== 通用 section ===== */
.section {
  margin: 20rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #191919;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

/* ===== 简介编辑 ===== */
.bio-input {
  width: 100%;
  padding: 20rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #191919;
  min-height: 80rpx;
  box-sizing: border-box;
}

.save-row {
  display: flex;
  justify-content: flex-end;
  margin-top: 16rpx;
}

.save-btn {
  padding: 12rpx 40rpx;
  background: #07C160;
  border-radius: 40rpx;
  font-size: 26rpx;
  color: #fff;
}

/* ===== 添加视频按钮 ===== */
.add-video-btn {
  font-size: 24rpx;
  color: #07C160;
  font-weight: normal;
  padding: 6rpx 20rpx;
  border: 1rpx solid #07C160;
  border-radius: 30rpx;
}

/* ===== 空状态 ===== */
.empty-videos {
  text-align: center;
  padding: 60rpx 0;
}

.empty-text {
  font-size: 26rpx;
  color: #8e8e93;
}

/* ===== 视频列表 ===== */
.video-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.video-item {
  display: flex;
  background: #fafafa;
  border-radius: 12rpx;
  overflow: hidden;
}

.v-cover {
  position: relative;
  width: 200rpx;
  height: 268rpx;
  flex-shrink: 0;
  background: #eee;
}

.v-cover-img {
  width: 100%;
  height: 100%;
}

.v-cover-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding: 12rpx;
  font-size: 20rpx;
  color: #fff;
  text-align: center;
  box-sizing: border-box;
}

.v-status {
  position: absolute;
  left: 6rpx;
  top: 6rpx;
  padding: 2rpx 10rpx;
  border-radius: 4rpx;
  font-size: 18rpx;
  color: #fff;
}

.st-on {
  background: rgba(7, 193, 96, 0.85);
}

.st-off {
  background: rgba(255, 71, 87, 0.85);
}

.v-info {
  flex: 1;
  min-width: 0;
  padding: 16rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.v-title {
  font-size: 26rpx;
  color: #191919;
  font-weight: 500;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  line-height: 1.3;
}

.v-stats {
  display: flex;
  gap: 20rpx;
  font-size: 22rpx;
  color: #8e8e93;
}

.v-stats .iconfont {
  font-size: 22rpx;
  margin-right: 4rpx;
}

.v-actions {
  display: flex;
  gap: 12rpx;
}

.v-btn {
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
  font-size: 22rpx;
}

.v-edit {
  background: #eef2ff;
  color: #576b95;
}

.v-toggle {
  background: #e6f9ee;
  color: #07C160;
}

.v-delete {
  background: #fff0f0;
  color: #ff4757;
}

.bottom-pad {
  height: 60rpx;
}
