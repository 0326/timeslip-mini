<custom-nav-bar
  title="视频号管理"
  showBack="{{true}}"
></custom-nav-bar>

<view class="page">
  <view wx:if="{{channelList.length === 0 && !loading}}" class="empty">
    <text class="empty-text">暂无视频号</text>
    <view class="empty-btn" bindtap="openCreate">创建第一个视频号</view>
  </view>

  <view class="channel-list" wx:if="{{channelList.length > 0}}">
    <view
      wx:for="{{channelList}}"
      wx:key="_id"
      class="channel-item"
      data-id="{{item._id}}"
      bindtap="onChannelTap"
    >
      <image class="channel-avatar" src="{{item.avatar || '/images/icons/avatar.png'}}" mode="aspectFill"></image>
      <view class="channel-info">
        <view class="channel-name">
          {{item.figureName}}
          <text wx:if="{{item.figureTitle}}" class="channel-title"> · {{item.figureTitle}}</text>
        </view>
        <view class="channel-desc" wx:if="{{item.bio}}">{{item.bio}}</view>
        <view class="channel-stats">
          <text>{{item.videoCount || 0}} 作品</text>
          <text class="dot">·</text>
          <text>{{item.followerCount || 0}} 粉丝</text>
        </view>
      </view>
      <text class="iconfont icon-right arrow"></text>
    </view>
  </view>
</view>

<view class="fab-btn" bindtap="openCreate">
  <text class="fab-plus">+</text>
</view>

<view wx:if="{{showCreate}}" class="modal-mask" bindtap="closeCreate">
  <view class="modal-panel" catchtap="stopPropagation">
    <view class="modal-title">创建视频号</view>

    <view class="form-row">
      <text class="form-label">选择角色 *</text>
      <view class="figure-picker" wx:if="{{figureOptions.length > 0}}">
        <view
          wx:for="{{figureOptions}}"
          wx:key="figureId"
          class="figure-option {{selectedFigureId === item.figureId ? 'selected' : ''}}"
          data-figure="{{item}}"
          bindtap="onFigureSelect"
        >
          <image class="figure-opt-avatar" src="{{item.avatar || '/images/icons/avatar.png'}}" mode="aspectFill"></image>
          <view class="figure-opt-info">
            <view class="figure-opt-name">{{item.figureName}}</view>
            <view class="figure-opt-title" wx:if="{{item.title}}">{{item.title}}</view>
          </view>
          <text wx:if="{{selectedFigureId === item.figureId}}" class="iconfont icon-check figure-check"></text>
        </view>
      </view>
      <view wx:else class="loading-figures">加载角色列表中...</view>
    </view>

    <view class="form-row" wx:if="{{selectedFigureId}}">
      <text class="form-label">简介</text>
      <textarea
        class="form-textarea"
        placeholder="视频号简介（选填）"
        value="{{createForm.bio}}"
        data-field="bio"
        bindinput="onInput"
        maxlength="100"
      />
    </view>

    <view class="modal-footer">
      <view class="btn-cancel" bindtap="closeCreate">取消</view>
      <view class="btn-confirm {{selectedFigureId ? '' : 'disabled'}}" bindtap="submitCreate">创建</view>
    </view>
  </view>
</view>
