.page {
  min-height: 100vh;
  background: #f7f7f7;
}

.empty {
  text-align: center;
  padding: 120rpx 0;
}

.empty-text {
  display: block;
  font-size: 28rpx;
  color: #8e8e93;
  margin-bottom: 30rpx;
}

.empty-btn {
  display: inline-block;
  padding: 16rpx 48rpx;
  background: #07C160;
  border-radius: 40rpx;
  font-size: 28rpx;
  color: #fff;
}

.channel-list {
  padding: 20rpx;
}

.channel-item {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.channel-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  margin-right: 24rpx;
  background: #eee;
  flex-shrink: 0;
}

.channel-info {
  flex: 1;
  min-width: 0;
}

.channel-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #191919;
  margin-bottom: 8rpx;
}

.channel-title {
  font-size: 26rpx;
  color: #8e8e93;
  font-weight: normal;
}

.channel-desc {
  font-size: 24rpx;
  color: #8e8e93;
  margin-bottom: 8rpx;
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.channel-stats {
  font-size: 22rpx;
  color: #999;
}

.dot {
  margin: 0 12rpx;
}

.arrow {
  font-size: 24rpx;
  color: #c0c0c0;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-panel {
  width: 600rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 40rpx;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #191919;
  text-align: center;
  margin-bottom: 30rpx;
}

.form-row {
  margin-bottom: 24rpx;
}

.form-label {
  display: block;
  font-size: 26rpx;
  color: #666;
  margin-bottom: 12rpx;
}

.form-input {
  width: 100%;
  padding: 20rpx 24rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #191919;
  box-sizing: border-box;
}

.form-textarea {
  width: 100%;
  padding: 20rpx 24rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #191919;
  min-height: 120rpx;
  box-sizing: border-box;
}

.modal-footer {
  display: flex;
  gap: 20rpx;
  margin-top: 40rpx;
}

.btn-cancel,
.btn-confirm {
  flex: 1;
  padding: 24rpx 0;
  text-align: center;
  border-radius: 40rpx;
  font-size: 28rpx;
}

.btn-cancel {
  background: #f5f5f5;
  color: #666;
}

.btn-confirm {
  background: #07C160;
  color: #fff;
}

.btn-confirm.disabled {
  background: #c0c0c0;
}

.figure-picker {
  max-height: 600rpx;
  overflow-y: auto;
}

.figure-option {
  display: flex;
  align-items: center;
  padding: 20rpx 16rpx;
  border-radius: 12rpx;
  margin-bottom: 12rpx;
  background: #f5f5f5;
}

.figure-option.selected {
  background: #e6f9ee;
}

.figure-opt-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  background: #ddd;
  flex-shrink: 0;
}

.figure-opt-info {
  flex: 1;
  min-width: 0;
}

.figure-opt-name {
  font-size: 28rpx;
  color: #191919;
  font-weight: 500;
}

.figure-opt-title {
  font-size: 22rpx;
  color: #8e8e93;
}

.figure-check {
  font-size: 32rpx;
  color: #07C160;
  flex-shrink: 0;
}

.loading-figures {
  text-align: center;
  padding: 40rpx 0;
  font-size: 26rpx;
  color: #8e8e93;
}

.fab-btn {
  position: fixed;
  right: 40rpx;
  bottom: 80rpx;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: #07C160;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(7, 193, 96, 0.4);
  z-index: 100;
}

.fab-plus {
  font-size: 56rpx;
  color: #fff;
  line-height: 1;
}

