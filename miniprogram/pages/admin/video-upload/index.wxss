.page-wrapper {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #f7f7f7;
}

.page {
  flex: 1;
  height: 0;
}

.section {
  background: #fff;
  margin-top: 20rpx;
  padding: 30rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #191919;
  margin-bottom: 24rpx;
}

.section-sub {
  font-size: 24rpx;
  font-weight: normal;
  color: #8e8e93;
  margin-left: 12rpx;
}

.video-preview {
  width: 100%;
  height: 480rpx;
  background: #000;
  border-radius: 16rpx;
  overflow: hidden;
  position: relative;
}

.preview-video {
  width: 100%;
  height: 100%;
}

.duration-tag {
  position: absolute;
  right: 16rpx;
  bottom: 16rpx;
  padding: 4rpx 12rpx;
  background: rgba(0, 0, 0, 0.7);
  border-radius: 8rpx;
  font-size: 22rpx;
  color: #fff;
}

.upload-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
}

.upload-placeholder .iconfont {
  font-size: 80rpx;
  color: #fff;
  margin-bottom: 20rpx;
}

.upload-text {
  font-size: 30rpx;
  color: #fff;
  font-weight: 500;
  margin-bottom: 12rpx;
}

.upload-hint {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
}

.cover-row {
  display: flex;
  align-items: flex-start;
}

.cover-box {
  width: 200rpx;
  height: 280rpx;
  border-radius: 12rpx;
  overflow: hidden;
  background: #eee;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.cover-img {
  width: 100%;
  height: 100%;
}

.cover-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #f5f5f5;
}

.cover-placeholder .iconfont {
  font-size: 48rpx;
  color: #ccc;
  margin-bottom: 12rpx;
}

.cover-hint {
  font-size: 22rpx;
  color: #999;
}

.cover-info {
  flex: 1;
  padding-top: 10rpx;
}

.cover-desc {
  font-size: 24rpx;
  color: #8e8e93;
  line-height: 1.5;
}

.form-item {
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
  display: flex;
  align-items: flex-start;
}

.form-item:last-child {
  border-bottom: none;
}

.form-item.tag-form-item {
  flex-direction: column;
}

.form-label {
  width: 160rpx;
  font-size: 28rpx;
  color: #191919;
  flex-shrink: 0;
  padding-top: 6rpx;
}

.tag-form-item .form-label {
  padding-top: 0;
  margin-bottom: 16rpx;
  width: auto;
}

.form-value {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: flex-end;
}

.channel-name {
  font-size: 28rpx;
  color: #191919;
  flex: 1;
}

.form-placeholder {
  font-size: 28rpx;
  color: #c0c0c0;
  flex: 1;
}

.form-value .iconfont {
  font-size: 24rpx;
  color: #c0c0c0;
  margin-left: 12rpx;
}

.form-input {
  flex: 1;
  font-size: 28rpx;
  color: #191919;
  text-align: right;
}

.form-textarea {
  flex: 1;
  font-size: 28rpx;
  color: #191919;
  min-height: 100rpx;
  text-align: right;
}

.tag-content {
  width: 100%;
}

.tag-input-row {
  width: 100%;
  display: flex;
  align-items: center;
}

.tag-input {
  flex: 1;
  font-size: 28rpx;
  color: #191919;
  padding: 12rpx 20rpx;
  background: #f7f7f7;
  border-radius: 8rpx;
}

.tag-add-btn {
  padding: 12rpx 28rpx;
  background: #07C160;
  border-radius: 8rpx;
  font-size: 26rpx;
  color: #fff;
  margin-left: 16rpx;
  flex-shrink: 0;
}

.tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 20rpx;
}

.tag-item {
  display: flex;
  align-items: center;
  padding: 10rpx 18rpx;
  background: #f5f5f5;
  border-radius: 8rpx;
}

.tag-text {
  font-size: 24rpx;
  color: #555;
}

.tag-remove {
  font-size: 30rpx;
  color: #999;
  margin-left: 10rpx;
  line-height: 1;
}

.add-comment-btn {
  padding: 20rpx;
  border: 2rpx dashed #ddd;
  border-radius: 12rpx;
  text-align: center;
  font-size: 28rpx;
  color: #07C160;
  margin-bottom: 20rpx;
}

.ai-comment-list {
  margin-top: 20rpx;
}

.ai-comment-item {
  padding: 24rpx;
  background: #f9f9f9;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
}

.ai-comment-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.ai-comment-name {
  font-size: 26rpx;
  font-weight: 500;
  color: #576b95;
}

.ai-comment-remove {
  font-size: 24rpx;
  color: #ff4757;
}

.ai-comment-content {
  font-size: 28rpx;
  color: #191919;
  line-height: 1.5;
}

.existing-comments {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx dashed #e0e0e0;
}

.existing-title {
  font-size: 26rpx;
  color: #8e8e93;
  margin-bottom: 16rpx;
}

.switch-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.form-hint {
  font-size: 24rpx;
  color: #8e8e93;
  padding: 8rpx 0 0;
}

.bottom-space {
  height: 40rpx;
}

.footer-bar {
  flex-shrink: 0;
  padding: 20rpx 30rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-top: 1rpx solid #f0f0f0;
}

.submit-btn {
  width: 100%;
  padding: 26rpx 0;
  background: #07C160;
  border-radius: 48rpx;
  font-size: 30rpx;
  color: #fff;
  font-weight: 600;
  text-align: center;
}

.upload-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
}

.upload-dialog {
  width: 500rpx;
  padding: 50rpx 40rpx;
  background: #fff;
  border-radius: 20rpx;
  text-align: center;
}

.upload-progress-text {
  font-size: 48rpx;
  font-weight: bold;
  color: #07C160;
  margin-bottom: 24rpx;
}

.upload-bar {
  width: 100%;
  height: 12rpx;
  background: #f0f0f0;
  border-radius: 6rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
}

.upload-bar-inner {
  height: 100%;
  background: linear-gradient(90deg, #07C160, #5ed99d);
  border-radius: 6rpx;
  transition: width 0.3s;
}

.upload-hint-text {
  font-size: 26rpx;
  color: #8e8e93;
}

.picker-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
}

.picker-panel {
  width: 100%;
  max-height: 70vh;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
}

.picker-title {
  padding: 30rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
  border-bottom: 1rpx solid #f0f0f0;
}

.picker-list {
  max-height: 60vh;
}

.picker-item {
  display: flex;
  align-items: center;
  padding: 24rpx 30rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.picker-item.active {
  background: #f5fff5;
}

.picker-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  background: #eee;
}

.picker-info {
  flex: 1;
}

.picker-name {
  font-size: 28rpx;
  color: #191919;
  margin-bottom: 6rpx;
  display: block;
}

.picker-title {
  font-size: 24rpx;
  color: #8e8e93;
}

.picker-check {
  font-size: 32rpx;
  color: #07C160;
  font-weight: bold;
}
