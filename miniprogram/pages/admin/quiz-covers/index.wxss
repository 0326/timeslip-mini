.page {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 60rpx;
}

.content {
  padding: 24rpx;
}

.tip {
  font-size: 24rpx;
  color: #8e8e93;
  margin-bottom: 24rpx;
  line-height: 1.5;
}

/* 测试封面列表 */
.item-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.item-card {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}
.item-cover {
  width: 160rpx;
  height: 200rpx;
  border-radius: 12rpx;
  overflow: hidden;
  flex-shrink: 0;
  position: relative;
  background: #f0f0f0;
}
.cover-img {
  width: 100%;
  height: 100%;
}
.cover-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #e8e8e8 0%, #d5d5d5 100%);
}
.cover-icon {
  font-size: 56rpx;
  margin-bottom: 8rpx;
}
.cover-text {
  font-size: 22rpx;
  color: #999;
}
.cover-loading {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.5);
  display: flex;
  align-items: center;
  justify-content: center;
}
.item-info {
  flex: 1;
  margin-left: 24rpx;
}
.item-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #191919;
  margin-bottom: 8rpx;
}
.item-meta {
  font-size: 24rpx;
  color: #8e8e93;
  margin-bottom: 12rpx;
}
.item-status {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 100rpx;
  font-size: 22rpx;
}
.has-cover {
  background: rgba(7,193,96,0.1);
  color: #07C160;
}
.no-cover {
  background: rgba(255,71,87,0.1);
  color: #ff4757;
}

.loading-spinner-small {
  width: 40rpx;
  height: 40rpx;
  border: 4rpx solid rgba(255,255,255,0.3);
  border-top-color: #fff;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}
@keyframes spin {
  to { transform: rotate(360deg); }
}

.empty {
  text-align: center;
  padding: 120rpx 0;
  color: #8e8e93;
  font-size: 28rpx;
}

.bottom-tip {
  text-align: center;
  color: #c0c0c0;
  font-size: 22rpx;
  padding: 40rpx 0 0;
  line-height: 1.6;
}
