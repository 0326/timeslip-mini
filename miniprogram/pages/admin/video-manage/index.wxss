.page {
  min-height: 100vh;
  background: #f7f7f7;
}

.top-bar {
  background: #fff;
  padding: 20rpx 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.tab-btn {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  font-size: 28rpx;
  color: #191919;
}

.tab-btn .iconfont {
  font-size: 24rpx;
  color: #c0c0c0;
}

.empty {
  text-align: center;
  padding: 120rpx 0;
}

.empty-text {
  display: block;
  font-size: 28rpx;
  color: #8e8e93;
  margin-bottom: 30rpx;
}

.empty-btn {
  display: inline-block;
  padding: 16rpx 48rpx;
  background: #07C160;
  border-radius: 40rpx;
  font-size: 28rpx;
  color: #fff;
}

.video-grid {
  padding: 16rpx;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}

.grid-item {
  display: flex;
  flex-direction: column;
  background: #fff;
  border-radius: 12rpx;
  overflow: hidden;
}

.item-cover {
  position: relative;
  width: 100%;
  padding-top: 133%;
  background: #eee;
}

.item-cover .cover-img,
.item-cover .cover-placeholder {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.cover-img {
  width: 100%;
  height: 100%;
}

.cover-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding: 12rpx;
  font-size: 20rpx;
  color: #fff;
  text-align: center;
}

.duration {
  position: absolute;
  right: 6rpx;
  bottom: 6rpx;
  padding: 2rpx 8rpx;
  background: rgba(0, 0, 0, 0.6);
  border-radius: 4rpx;
  font-size: 18rpx;
  color: #fff;
}

.item-info {
  padding: 12rpx 12rpx 8rpx;
}

.item-title {
  font-size: 24rpx;
  color: #191919;
  font-weight: 500;
  margin-bottom: 6rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  line-height: 1.3;
  min-height: 62rpx;
}

.item-meta {
  display: flex;
  align-items: center;
  font-size: 20rpx;
  color: #8e8e93;
  margin-bottom: 4rpx;
}

.meta-author {
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.item-stats {
  display: flex;
  align-items: center;
  font-size: 20rpx;
  color: #8e8e93;
}

.meta-stats .iconfont {
  font-size: 20rpx;
  margin-right: 4rpx;
}

.item-actions {
  display: flex;
  border-top: 1rpx solid #f5f5f5;
}

.item-edit,
.item-delete {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 12rpx 0;
  gap: 4rpx;
}

.item-edit {
  border-right: 1rpx solid #f5f5f5;
}

.item-edit .iconfont {
  font-size: 24rpx;
  color: #576b95;
}

.item-edit .action-text {
  font-size: 20rpx;
  color: #576b95;
}

.item-delete .iconfont {
  font-size: 24rpx;
  color: #ff4757;
}

.item-delete .action-text {
  font-size: 20rpx;
  color: #ff4757;
}
