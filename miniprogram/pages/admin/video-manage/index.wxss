.page {
  min-height: 100vh;
  background: #f7f7f7;
}

.top-bar {
  background: #fff;
  padding: 20rpx 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.tab-btn {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  font-size: 28rpx;
  color: #191919;
}

.tab-btn .iconfont {
  font-size: 24rpx;
  color: #c0c0c0;
}

.empty {
  text-align: center;
  padding: 120rpx 0;
}

.empty-text {
  display: block;
  font-size: 28rpx;
  color: #8e8e93;
  margin-bottom: 30rpx;
}

.empty-btn {
  display: inline-block;
  padding: 16rpx 48rpx;
  background: #07C160;
  border-radius: 40rpx;
  font-size: 28rpx;
  color: #fff;
}

.video-list {
  padding: 20rpx;
}

.video-item {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
}

.item-cover {
  position: relative;
  width: 160rpx;
  height: 220rpx;
  border-radius: 12rpx;
  overflow: hidden;
  background: #eee;
  flex-shrink: 0;
  margin-right: 24rpx;
}

.cover-img {
  width: 100%;
  height: 100%;
}

.cover-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding: 16rpx;
  font-size: 22rpx;
  color: #fff;
  text-align: center;
}

.duration {
  position: absolute;
  right: 8rpx;
  bottom: 8rpx;
  padding: 2rpx 10rpx;
  background: rgba(0, 0, 0, 0.6);
  border-radius: 6rpx;
  font-size: 20rpx;
  color: #fff;
}

.item-info {
  flex: 1;
  min-width: 0;
}

.item-title {
  font-size: 28rpx;
  color: #191919;
  font-weight: 500;
  margin-bottom: 12rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.item-meta {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #8e8e93;
}

.meta-author {
  margin-right: 20rpx;
}

.item-delete {
  padding: 20rpx;
  flex-shrink: 0;
}

.item-delete .iconfont {
  font-size: 36rpx;
  color: #ff4757;
}
