<custom-nav-bar
  title="视频管理"
  showBack="{{true}}"
></custom-nav-bar>

<view class="page">
  <view class="top-bar">
    <view class="tab-btn" bindtap="goChannelManage">
      <text>视频号管理</text>
      <text class="iconfont icon-right"></text>
    </view>
  </view>

  <view wx:if="{{videoList.length === 0 && !loading}}" class="empty">
    <text class="empty-text">暂无视频</text>
    <view class="empty-btn" bindtap="goUpload">去上传</view>
  </view>

  <view class="video-grid" wx:if="{{videoList.length > 0}}">
    <view
      wx:for="{{videoList}}"
      wx:key="_id"
      class="grid-item"
    >
      <view class="item-cover" data-id="{{item._id}}" bindtap="onVideoTap">
        <image wx:if="{{item.coverUrl}}" class="cover-img" src="{{item.coverUrl}}" mode="aspectFill"></image>
        <view wx:else class="cover-placeholder">
          <text>{{item.title}}</text>
        </view>
        <view class="duration" wx:if="{{item.duration}}">{{item.duration}}"</view>
        <view class="status-badge {{item.status === 'published' ? 'status-on' : 'status-off'}}">
          {{item.status === 'published' ? '已上架' : '已下架'}}
        </view>
      </view>
      <view class="item-info">
        <view class="item-title">{{item.title}}</view>
        <view class="item-meta">
          <text class="meta-author">{{item.figureName}}</text>
        </view>
        <view class="item-stats">
          <text class="meta-stats"><text class="iconfont icon-good"></text> {{item.likeCount || 0}}</text>
        </view>
      </view>
      <view class="item-actions">
        <view class="action-btn action-edit" catchtap="onEdit" data-id="{{item._id}}">
          <text class="iconfont icon-edit"></text>
          <text class="action-text">编辑</text>
        </view>
        <view
          class="action-btn action-toggle"
          catchtap="onToggleStatus"
          data-id="{{item._id}}"
          data-status="{{item.status}}"
        >
          <text class="action-text">{{item.status === 'published' ? '下架' : '上架'}}</text>
        </view>
        <view class="action-btn action-delete" catchtap="onDelete" data-id="{{item._id}}">
          <text class="iconfont icon-delete"></text>
        </view>
      </view>
    </view>
  </view>
</view>
